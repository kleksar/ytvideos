{
  "cues": [
    {
      "start_seconds": 0.065,
      "end_seconds": 2.405,
      "text": "The Great Emu War (1932)"
    },
    {
      "start_seconds": 3.045,
      "end_seconds": 4.825,
      "text": "November fourth, 1932."
    },
    {
      "start_seconds": 5.545,
      "end_seconds": 6.545,
      "text": "In Western Australia,"
    },
    {
      "start_seconds": 6.905,
      "end_seconds": 8.205,
      "text": "soldiers wait beside a dam"
    },
    {
      "start_seconds": 8.245,
      "end_seconds": 9.025,
      "text": "with machine guns."
    },
    {
      "start_seconds": 9.625,
      "end_seconds": 10.105,
      "text": "Ahead of them,"
    },
    {
      "start_seconds": 10.385,
      "end_seconds": 11.645,
      "text": "around a thousand emus"
    },
    {
      "start_seconds": 11.725,
      "end_seconds": 12.605,
      "text": "are approaching the water."
    },
    {
      "start_seconds": 13.165,
      "end_seconds": 14.185,
      "text": "The birds have finally"
    },
    {
      "start_seconds": 14.225,
      "end_seconds": 15.405,
      "text": "gathered in one place."
    },
    {
      "start_seconds": 16.045,
      "end_seconds": 17.025,
      "text": "The soldiers let them come"
    },
    {
      "start_seconds": 17.085,
      "end_seconds": 18.946,
      "text": "closer, then open fire."
    },
    {
      "start_seconds": 19.506,
      "end_seconds": 20.486,
      "text": "A few emus fall."
    },
    {
      "start_seconds": 21.046,
      "end_seconds": 22.486,
      "text": "Then a machine gun jams."
    },
    {
      "start_seconds": 22.966,
      "end_seconds": 23.966,
      "text": "The rest scatter"
    },
    {
      "start_seconds": 23.986,
      "end_seconds": 24.906,
      "text": "across the open land."
    },
    {
      "start_seconds": 25.466,
      "end_seconds": 26.366,
      "text": "It was one of their best"
    },
    {
      "start_seconds": 26.426,
      "end_seconds": 28.106,
      "text": "chances to stop a whole flock."
    },
    {
      "start_seconds": 28.626,
      "end_seconds": 30.106,
      "text": "Almost every bird escaped."
    },
    {
      "start_seconds": 30.926,
      "end_seconds": 31.706,
      "text": "How did Australia"
    },
    {
      "start_seconds": 31.766,
      "end_seconds": 32.306,
      "text": "end up sending"
    },
    {
      "start_seconds": 32.346,
      "end_seconds": 33.746,
      "text": "machine guns against emus?"
    },
    {
      "start_seconds": 34.406,
      "end_seconds": 35.206,
      "text": "To understand that,"
    },
    {
      "start_seconds": 35.466,
      "end_seconds": 36.286,
      "text": "go back two days."
    },
    {
      "start_seconds": 36.906,
      "end_seconds": 37.706,
      "text": "On November second,"
    },
    {
      "start_seconds": 37.926,
      "end_seconds": 38.886,
      "text": "a small army unit"
    },
    {
      "start_seconds": 38.966,
      "end_seconds": 39.326,
      "text": "arrives"
    },
    {
      "start_seconds": 39.366,
      "end_seconds": 40.366,
      "text": "in the wheat-growing district"
    },
    {
      "start_seconds": 40.406,
      "end_seconds": 41.006,
      "text": "near Campion."
    },
    {
      "start_seconds": 41.486,
      "end_seconds": 42.886,
      "text": "The men have two machine guns"
    },
    {
      "start_seconds": 43.106,
      "end_seconds": 44.246,
      "text": "and orders to help local"
    },
    {
      "start_seconds": 44.306,
      "end_seconds": 45.606,
      "text": "farmers get rid of the birds."
    },
    {
      "start_seconds": 46.266,
      "end_seconds": 46.866,
      "text": "Those farmers"
    },
    {
      "start_seconds": 46.906,
      "end_seconds": 47.526,
      "text": "have been fighting"
    },
    {
      "start_seconds": 47.566,
      "end_seconds": 48.726,
      "text": "to keep their farms alive."
    },
    {
      "start_seconds": 49.366,
      "end_seconds": 50.426,
      "text": "After the First World War,"
    },
    {
      "start_seconds": 50.786,
      "end_seconds": 51.746,
      "text": "many former soldiers"
    },
    {
      "start_seconds": 51.786,
      "end_seconds": 52.627,
      "text": "had settled on land"
    },
    {
      "start_seconds": 52.687,
      "end_seconds": 53.607,
      "text": "in Western Australia."
    },
    {
      "start_seconds": 54.167,
      "end_seconds": 55.167,
      "text": "Some of that land was hard"
    },
    {
      "start_seconds": 55.207,
      "end_seconds": 56.627,
      "text": "to farm even in good years."
    },
    {
      "start_seconds": 57.187,
      "end_seconds": 58.087,
      "text": "In parts of the district,"
    },
    {
      "start_seconds": 58.427,
      "end_seconds": 59.847,
      "text": "settlers had already abandoned"
    },
    {
      "start_seconds": 59.867,
      "end_seconds": 60.367,
      "text": "their farms."
    },
    {
      "start_seconds": 60.987,
      "end_seconds": 62.387,
      "text": "Then the Great Depression"
    },
    {
      "start_seconds": 62.407,
      "end_seconds": 62.687,
      "text": "struck."
    },
    {
      "start_seconds": 63.187,
      "end_seconds": 64.367,
      "text": "Wheat prices collapsed."
    },
    {
      "start_seconds": 64.867,
      "end_seconds": 65.387,
      "text": "Drought made"
    },
    {
      "start_seconds": 65.607,
      "end_seconds": 66.307,
      "text": "everything worse."
    },
    {
      "start_seconds": 66.907,
      "end_seconds": 67.967,
      "text": "For the families who stayed,"
    },
    {
      "start_seconds": 68.227,
      "end_seconds": 68.767,
      "text": "the harvest"
    },
    {
      "start_seconds": 68.827,
      "end_seconds": 69.687,
      "text": "was their livelihood."
    },
    {
      "start_seconds": 70.207,
      "end_seconds": 71.247,
      "text": "A lost field of wheat"
    },
    {
      "start_seconds": 71.307,
      "end_seconds": 72.407,
      "text": "could mean a year of work"
    },
    {
      "start_seconds": 72.427,
      "end_seconds": 73.627,
      "text": "with nothing to show for it."
    },
    {
      "start_seconds": 74.207,
      "end_seconds": 74.587,
      "text": "And now"
    },
    {
      "start_seconds": 74.847,
      "end_seconds": 76.007,
      "text": "the emus were arriving."
    },
    {
      "start_seconds": 76.567,
      "end_seconds": 77.387,
      "text": "They were huge,"
    },
    {
      "start_seconds": 77.527,
      "end_seconds": 79.187,
      "text": "flightless birds, nearly as tall"
    },
    {
      "start_seconds": 79.207,
      "end_seconds": 81.007,
      "text": "as a person, with powerful legs"
    },
    {
      "start_seconds": 81.067,
      "end_seconds": 81.707,
      "text": "built for running."
    },
    {
      "start_seconds": 82.367,
      "end_seconds": 83.227,
      "text": "Thousands were moving"
    },
    {
      "start_seconds": 83.247,
      "end_seconds": 84.207,
      "text": "through the farming districts"
    },
    {
      "start_seconds": 84.447,
      "end_seconds": 85.707,
      "text": "looking for food and water."
    },
    {
      "start_seconds": 86.247,
      "end_seconds": 86.808,
      "text": "To the birds,"
    },
    {
      "start_seconds": 87.068,
      "end_seconds": 87.728,
      "text": "the wheat fields"
    },
    {
      "start_seconds": 87.788,
      "end_seconds": 88.688,
      "text": "were an easy meal."
    },
    {
      "start_seconds": 89.208,
      "end_seconds": 89.828,
      "text": "To the farmers,"
    },
    {
      "start_seconds": 90.108,
      "end_seconds": 90.668,
      "text": "they were crops"
    },
    {
      "start_seconds": 90.688,
      "end_seconds": 91.208,
      "text": "that had taken"
    },
    {
      "start_seconds": 91.348,
      "end_seconds": 92.368,
      "text": "months of work to grow."
    },
    {
      "start_seconds": 92.948,
      "end_seconds": 93.708,
      "text": "The emus ate"
    },
    {
      "start_seconds": 93.748,
      "end_seconds": 94.968,
      "text": "the grain and trampled what"
    },
    {
      "start_seconds": 94.988,
      "end_seconds": 95.568,
      "text": "they didn't eat."
    },
    {
      "start_seconds": 95.968,
      "end_seconds": 96.928,
      "text": "They damaged fences"
    },
    {
      "start_seconds": 96.968,
      "end_seconds": 98.288,
      "text": "as they moved through, leaving"
    },
    {
      "start_seconds": 98.408,
      "end_seconds": 99.708,
      "text": "openings for rabbits to enter"
    },
    {
      "start_seconds": 99.768,
      "end_seconds": 101.008,
      "text": "and do even more harm."
    },
    {
      "start_seconds": 101.528,
      "end_seconds": 102.448,
      "text": "The farmers couldn't"
    },
    {
      "start_seconds": 102.488,
      "end_seconds": 102.968,
      "text": "keep them out."
    },
    {
      "start_seconds": 103.568,
      "end_seconds": 104.368,
      "text": "So they turned"
    },
    {
      "start_seconds": 104.408,
      "end_seconds": 105.288,
      "text": "to the government for help."
    },
    {
      "start_seconds": 105.868,
      "end_seconds": 106.708,
      "text": "The Defence Minister"
    },
    {
      "start_seconds": 106.768,
      "end_seconds": 107.408,
      "text": "agreed to send"
    },
    {
      "start_seconds": 107.508,
      "end_seconds": 108.668,
      "text": "soldiers with machine guns."
    },
    {
      "start_seconds": 109.208,
      "end_seconds": 109.968,
      "text": "A cameraman came"
    },
    {
      "start_seconds": 110.008,
      "end_seconds": 111.308,
      "text": "along to record the operation."
    },
    {
      "start_seconds": 111.888,
      "end_seconds": 112.348,
      "text": "On paper,"
    },
    {
      "start_seconds": 112.548,
      "end_seconds": 113.528,
      "text": "the plan seemed simple."
    },
    {
      "start_seconds": 114.108,
      "end_seconds": 114.968,
      "text": "Find a large flock."
    },
    {
      "start_seconds": 115.368,
      "end_seconds": 116.508,
      "text": "Bring the guns within range."
    },
    {
      "start_seconds": 116.928,
      "end_seconds": 117.488,
      "text": "Open fire."
    },
    {
      "start_seconds": 118.068,
      "end_seconds": 118.668,
      "text": "But the soldiers"
    },
    {
      "start_seconds": 118.708,
      "end_seconds": 119.568,
      "text": "discovered the problem"
    },
    {
      "start_seconds": 119.748,
      "end_seconds": 121.189,
      "text": "almost as soon as they arrived."
    },
    {
      "start_seconds": 121.709,
      "end_seconds": 122.449,
      "text": "On their first day,"
    },
    {
      "start_seconds": 122.649,
      "end_seconds": 124.089,
      "text": "they spotted a group of emus."
    },
    {
      "start_seconds": 124.689,
      "end_seconds": 126.029,
      "text": "Farmers tried to herd the birds"
    },
    {
      "start_seconds": 126.089,
      "end_seconds": 126.949,
      "text": "toward the waiting guns."
    },
    {
      "start_seconds": 127.489,
      "end_seconds": 129.209,
      "text": "Instead, the flock broke apart."
    },
    {
      "start_seconds": 129.749,
      "end_seconds": 130.829,
      "text": "Some birds ran one way."
    },
    {
      "start_seconds": 131.229,
      "end_seconds": 132.029,
      "text": "Others ran another."
    },
    {
      "start_seconds": 132.529,
      "end_seconds": 132.989,
      "text": "By the time"
    },
    {
      "start_seconds": 133.009,
      "end_seconds": 133.929,
      "text": "the soldiers could shoot,"
    },
    {
      "start_seconds": 134.149,
      "end_seconds": 135.429,
      "text": "there were only small groups"
    },
    {
      "start_seconds": 135.509,
      "end_seconds": 136.489,
      "text": "moving across the fields."
    },
    {
      "start_seconds": 137.049,
      "end_seconds": 138.109,
      "text": "Only a few were killed."
    },
    {
      "start_seconds": 138.749,
      "end_seconds": 140.049,
      "text": "The soldiers had weapons made"
    },
    {
      "start_seconds": 140.069,
      "end_seconds": 141.469,
      "text": "to deliver sustained fire."
    },
    {
      "start_seconds": 141.929,
      "end_seconds": 142.489,
      "text": "But that meant"
    },
    {
      "start_seconds": 142.609,
      "end_seconds": 143.509,
      "text": "little when the targets"
    },
    {
      "start_seconds": 143.569,
      "end_seconds": 144.289,
      "text": "kept scattering."
    },
    {
      "start_seconds": 144.829,
      "end_seconds": 145.629,
      "text": "And then came"
    },
    {
      "start_seconds": 145.649,
      "end_seconds": 147.069,
      "text": "the opportunity at the dam."
    },
    {
      "start_seconds": 147.589,
      "end_seconds": 148.849,
      "text": "Around a thousand emus"
    },
    {
      "start_seconds": 148.889,
      "end_seconds": 149.949,
      "text": "were gathered near the water."
    },
    {
      "start_seconds": 150.529,
      "end_seconds": 152.009,
      "text": "This time the soldiers waited"
    },
    {
      "start_seconds": 152.069,
      "end_seconds": 152.949,
      "text": "until they were close"
    },
    {
      "start_seconds": 153.009,
      "end_seconds": 153.669,
      "text": "before firing."
    },
    {
      "start_seconds": 154.169,
      "end_seconds": 155.59,
      "text": "But after roughly a dozen birds"
    },
    {
      "start_seconds": 155.63,
      "end_seconds": 157.27,
      "text": "were killed, a gun jammed."
    },
    {
      "start_seconds": 157.73,
      "end_seconds": 158.69,
      "text": "The flock escaped."
    },
    {
      "start_seconds": 159.19,
      "end_seconds": 160.35,
      "text": "The men had found the large"
    },
    {
      "start_seconds": 160.41,
      "end_seconds": 161.19,
      "text": "target they needed."
    },
    {
      "start_seconds": 161.69,
      "end_seconds": 162.27,
      "text": "And lost it."
    },
    {
      "start_seconds": 162.91,
      "end_seconds": 163.57,
      "text": "So they tried"
    },
    {
      "start_seconds": 163.61,
      "end_seconds": 164.21,
      "text": "something different."
    },
    {
      "start_seconds": 164.67,
      "end_seconds": 165.61,
      "text": "They put a machine gun"
    },
    {
      "start_seconds": 165.69,
      "end_seconds": 166.59,
      "text": "on the back of a truck."
    },
    {
      "start_seconds": 167.15,
      "end_seconds": 168.05,
      "text": "If they couldn't get the birds"
    },
    {
      "start_seconds": 168.09,
      "end_seconds": 168.91,
      "text": "to come to the guns,"
    },
    {
      "start_seconds": 169.19,
      "end_seconds": 170.03,
      "text": "they could take the gun"
    },
    {
      "start_seconds": 170.17,
      "end_seconds": 170.79,
      "text": "after the birds."
    },
    {
      "start_seconds": 171.33,
      "end_seconds": 172.53,
      "text": "There was just one problem."
    },
    {
      "start_seconds": 173.09,
      "end_seconds": 174.49,
      "text": "Emus can run fast."
    },
    {
      "start_seconds": 174.97,
      "end_seconds": 175.73,
      "text": "The truck couldn't"
    },
    {
      "start_seconds": 175.77,
      "end_seconds": 176.95,
      "text": "keep up over the rough ground."
    },
    {
      "start_seconds": 177.41,
      "end_seconds": 177.89,
      "text": "It jolted"
    },
    {
      "start_seconds": 178.03,
      "end_seconds": 179.23,
      "text": "so badly that the gunner"
    },
    {
      "start_seconds": 179.29,
      "end_seconds": 180.03,
      "text": "struggled to aim."
    },
    {
      "start_seconds": 180.57,
      "end_seconds": 181.21,
      "text": "A machine gun"
    },
    {
      "start_seconds": 181.25,
      "end_seconds": 182.01,
      "text": "was now bouncing"
    },
    {
      "start_seconds": 182.05,
      "end_seconds": 183.69,
      "text": "across the countryside, chasing"
    },
    {
      "start_seconds": 183.73,
      "end_seconds": 185.07,
      "text": "birds it could barely reach."
    },
    {
      "start_seconds": 185.65,
      "end_seconds": 186.93,
      "text": "The soldiers kept trying."
    },
    {
      "start_seconds": 187.39,
      "end_seconds": 188.25,
      "text": "But each encounter"
    },
    {
      "start_seconds": 188.33,
      "end_seconds": 189.43,
      "text": "ended much the same way:"
    },
    {
      "start_seconds": 189.91,
      "end_seconds": 191.511,
      "text": "a burst of gunfire, birds"
    },
    {
      "start_seconds": 191.571,
      "end_seconds": 193.131,
      "text": "scattering, and more emus"
    },
    {
      "start_seconds": 193.231,
      "end_seconds": 194.451,
      "text": "disappearing over the fields."
    },
    {
      "start_seconds": 194.971,
      "end_seconds": 195.611,
      "text": "Their commander,"
    },
    {
      "start_seconds": 195.791,
      "end_seconds": 197.111,
      "text": "Major Meredith, compared"
    },
    {
      "start_seconds": 197.131,
      "end_seconds": 198.411,
      "text": "the birds' ability to withstand"
    },
    {
      "start_seconds": 198.491,
      "end_seconds": 199.971,
      "text": "gunfire to that of tanks."
    },
    {
      "start_seconds": 200.571,
      "end_seconds": 201.311,
      "text": "Back in Canberra,"
    },
    {
      "start_seconds": 201.531,
      "end_seconds": 202.731,
      "text": "the operation was attracting"
    },
    {
      "start_seconds": 202.831,
      "end_seconds": 203.991,
      "text": "a different kind of attention."
    },
    {
      "start_seconds": 204.491,
      "end_seconds": 205.571,
      "text": "Politicians questioned"
    },
    {
      "start_seconds": 205.591,
      "end_seconds": 206.151,
      "text": "the campaign."
    },
    {
      "start_seconds": 206.751,
      "end_seconds": 207.891,
      "text": "One joked that if anyone"
    },
    {
      "start_seconds": 207.911,
      "end_seconds": 208.591,
      "text": "deserved medals,"
    },
    {
      "start_seconds": 208.851,
      "end_seconds": 209.571,
      "text": "it was the emus."
    },
    {
      "start_seconds": 210.151,
      "end_seconds": 211.371,
      "text": "A few days after the failed"
    },
    {
      "start_seconds": 211.471,
      "end_seconds": 212.531,
      "text": "ambush, the government"
    },
    {
      "start_seconds": 212.591,
      "end_seconds": 213.511,
      "text": "recalled the soldiers."
    },
    {
      "start_seconds": 214.071,
      "end_seconds": 214.631,
      "text": "In Canberra,"
    },
    {
      "start_seconds": 214.831,
      "end_seconds": 215.951,
      "text": "the shooting was over."
    },
    {
      "start_seconds": 216.451,
      "end_seconds": 217.331,
      "text": "In the farming district,"
    },
    {
      "start_seconds": 217.571,
      "end_seconds": 217.971,
      "text": "the birds"
    },
    {
      "start_seconds": 218.031,
      "end_seconds": 219.051,
      "text": "were still eating wheat."
    },
    {
      "start_seconds": 219.551,
      "end_seconds": 220.491,
      "text": "The soldiers had gone,"
    },
    {
      "start_seconds": 220.731,
      "end_seconds": 222.131,
      "text": "but the damage hadn't stopped."
    },
    {
      "start_seconds": 222.711,
      "end_seconds": 224.211,
      "text": "Fences were still being broken."
    },
    {
      "start_seconds": 224.612,
      "end_seconds": 225.832,
      "text": "Crops were still at risk."
    },
    {
      "start_seconds": 226.312,
      "end_seconds": 227.692,
      "text": "The birds were still moving"
    },
    {
      "start_seconds": 227.712,
      "end_seconds": 228.352,
      "text": "through the district."
    },
    {
      "start_seconds": 228.872,
      "end_seconds": 229.372,
      "text": "The farmers"
    },
    {
      "start_seconds": 229.552,
      "end_seconds": 230.452,
      "text": "asked for help again."
    },
    {
      "start_seconds": 230.912,
      "end_seconds": 231.932,
      "text": "And the government agreed"
    },
    {
      "start_seconds": 231.972,
      "end_seconds": 232.732,
      "text": "to another attempt."
    },
    {
      "start_seconds": 233.292,
      "end_seconds": 234.152,
      "text": "So the soldiers"
    },
    {
      "start_seconds": 234.232,
      "end_seconds": 235.212,
      "text": "returned with their guns."
    },
    {
      "start_seconds": 235.792,
      "end_seconds": 236.252,
      "text": "This time,"
    },
    {
      "start_seconds": 236.492,
      "end_seconds": 237.732,
      "text": "they killed more emus."
    },
    {
      "start_seconds": 238.232,
      "end_seconds": 238.752,
      "text": "But the work"
    },
    {
      "start_seconds": 238.872,
      "end_seconds": 240.052,
      "text": "dragged on for weeks."
    },
    {
      "start_seconds": 240.612,
      "end_seconds": 241.432,
      "text": "The birds were spread"
    },
    {
      "start_seconds": 241.472,
      "end_seconds": 242.732,
      "text": "across too much country,"
    },
    {
      "start_seconds": 242.972,
      "end_seconds": 244.092,
      "text": "and the soldiers had to find"
    },
    {
      "start_seconds": 244.112,
      "end_seconds": 245.072,
      "text": "them before they could fire."
    },
    {
      "start_seconds": 245.632,
      "end_seconds": 246.252,
      "text": "Even when the guns"
    },
    {
      "start_seconds": 246.292,
      "end_seconds": 246.972,
      "text": "were successful,"
    },
    {
      "start_seconds": 247.272,
      "end_seconds": 248.312,
      "text": "another group of emus"
    },
    {
      "start_seconds": 248.352,
      "end_seconds": 249.392,
      "text": "could turn up somewhere else."
    },
    {
      "start_seconds": 249.972,
      "end_seconds": 251.312,
      "text": "By December, hundreds"
    },
    {
      "start_seconds": 251.352,
      "end_seconds": 252.272,
      "text": "of birds had been killed."
    },
    {
      "start_seconds": 252.812,
      "end_seconds": 254.112,
      "text": "Even so, thousands"
    },
    {
      "start_seconds": 254.172,
      "end_seconds": 255.072,
      "text": "remained in the district."
    },
    {
      "start_seconds": 255.532,
      "end_seconds": 256.472,
      "text": "The shooting hadn't"
    },
    {
      "start_seconds": 256.552,
      "end_seconds": 257.312,
      "text": "stopped the damage."
    },
    {
      "start_seconds": 257.812,
      "end_seconds": 259.293,
      "text": "The army ended its campaign."
    },
    {
      "start_seconds": 259.813,
      "end_seconds": 260.453,
      "text": "For the farmers,"
    },
    {
      "start_seconds": 260.653,
      "end_seconds": 261.993,
      "text": "there was no dramatic finish."
    },
    {
      "start_seconds": 262.453,
      "end_seconds": 263.453,
      "text": "They still needed ways"
    },
    {
      "start_seconds": 263.493,
      "end_seconds": 264.453,
      "text": "to protect their fields."
    },
    {
      "start_seconds": 265.013,
      "end_seconds": 265.973,
      "text": "In the years that followed,"
    },
    {
      "start_seconds": 266.233,
      "end_seconds": 267.333,
      "text": "people continued killing"
    },
    {
      "start_seconds": 267.413,
      "end_seconds": 268.513,
      "text": "emus for bounty payments,"
    },
    {
      "start_seconds": 268.833,
      "end_seconds": 269.693,
      "text": "while fences remained"
    },
    {
      "start_seconds": 269.733,
      "end_seconds": 271.053,
      "text": "important for protecting crops."
    },
    {
      "start_seconds": 271.633,
      "end_seconds": 272.213,
      "text": "For the birds,"
    },
    {
      "start_seconds": 272.473,
      "end_seconds": 273.993,
      "text": "the campaign had been deadly."
    },
    {
      "start_seconds": 274.593,
      "end_seconds": 275.453,
      "text": "Many had been shot."
    },
    {
      "start_seconds": 275.893,
      "end_seconds": 277.033,
      "text": "But thousands remained"
    },
    {
      "start_seconds": 277.073,
      "end_seconds": 277.793,
      "text": "across the region."
    },
    {
      "start_seconds": 278.073,
      "end_seconds": 278.953,
      "text": "Australia had sent"
    },
    {
      "start_seconds": 279.033,
      "end_seconds": 280.193,
      "text": "soldiers into farmland"
    },
    {
      "start_seconds": 280.213,
      "end_seconds": 281.073,
      "text": "with machine guns"
    },
    {
      "start_seconds": 281.173,
      "end_seconds": 282.013,
      "text": "to stop the birds"
    },
    {
      "start_seconds": 282.033,
      "end_seconds": 283.073,
      "text": "from destroying the wheat."
    },
    {
      "start_seconds": 283.633,
      "end_seconds": 285.353,
      "text": "The soldiers had fired, chased,"
    },
    {
      "start_seconds": 285.573,
      "end_seconds": 286.893,
      "text": "withdrawn, and returned."
    },
    {
      "start_seconds": 287.393,
      "end_seconds": 287.913,
      "text": "The farmers"
    },
    {
      "start_seconds": 288.073,
      "end_seconds": 289.133,
      "text": "still needed protection."
    },
    {
      "start_seconds": 289.653,
      "end_seconds": 290.693,
      "text": "The emus had suffered"
    },
    {
      "start_seconds": 290.833,
      "end_seconds": 291.493,
      "text": "heavy losses."
    },
    {
      "start_seconds": 292.073,
      "end_seconds": 293.573,
      "text": "Yet across the wheat-growing"
    },
    {
      "start_seconds": 293.613,
      "end_seconds": 295.214,
      "text": "district, the birds continued"
    },
    {
      "start_seconds": 295.274,
      "end_seconds": 296.494,
      "text": "searching for food and water."
    },
    {
      "start_seconds": 297.014,
      "end_seconds": 298.014,
      "text": "The soldiers were gone."
    },
    {
      "start_seconds": 298.534,
      "end_seconds": 299.934,
      "text": "And the emus kept coming."
    }
  ]
}
