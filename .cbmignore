# Code graph only: episode production data remains available on disk and in Git.
# Source code and project-wide configuration are deliberately retained.
# Applied on the next normal index; do not force reindex solely to apply this file.

# Episode Work data (including nested Shorts episodes).
/channels/*/videos/**/Work/**/*.json
/channels/*/videos/**/Work/**/*.jsonl
/channels/*/videos/**/Work/**/*.csv
/channels/*/videos/**/Work/**/*.tsv

# Episode Edit data (including nested Shorts episodes).
/channels/*/videos/**/Edit/**/*.json
/channels/*/videos/**/Edit/**/*.jsonl
/channels/*/videos/**/Edit/**/*.csv
/channels/*/videos/**/Edit/**/*.tsv

# Episode Packaging data (including nested Shorts episodes).
/channels/*/videos/**/Packaging/**/*.json
/channels/*/videos/**/Packaging/**/*.jsonl
/channels/*/videos/**/Packaging/**/*.csv
/channels/*/videos/**/Packaging/**/*.tsv

# Episode Deliverables data (including nested Shorts episodes).
/channels/*/videos/**/Deliverables/**/*.json
/channels/*/videos/**/Deliverables/**/*.jsonl
/channels/*/videos/**/Deliverables/**/*.csv
/channels/*/videos/**/Deliverables/**/*.tsv

# Generated speech alignment and generated asset metadata only.
/channels/*/videos/**/Source/**/*.alignment.json
/channels/*/videos/**/Assets/Generated/**/*.json
/channels/*/videos/**/Assets/Generated/**/*.jsonl

# Generated inventory/cleanup records; retain .agent scripts and documentation.
/.agent/*-manifest.json
/.agent/*-discovery.json
/.agent/*_INVENTORY_*.csv
/.agent/*CLEANUP*.json
/.agent/cleanup_*.json
