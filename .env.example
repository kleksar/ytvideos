# Export these values into the worker environment; the CLI does not load .env.
# SQLite is the local, single-host option. All production workers must share
# one PostgreSQL database and the same content-addressed artifact workspace.
YTV_DATABASE_URL=.ytvideos/state.sqlite3
YTV_WORKSPACE=.ytvideos

# Base64 raw Ed25519 PUBLIC key from the trusted user-event bridge.
# The signing private key belongs to the bridge, never to an agent worker.
YTV_APPROVAL_PUBLIC_KEY=

# Local PostgreSQL service: docker compose --env-file .env -f ops/compose.yml up -d
# Set the password first. URL-encode it when constructing YTV_DATABASE_URL.
YTV_POSTGRES_USER=ytvideos
YTV_POSTGRES_DB=ytvideos
YTV_POSTGRES_PASSWORD=
YTV_POSTGRES_PORT=5432
# YTV_DATABASE_URL=postgresql://ytvideos:URL_ENCODED_PASSWORD@127.0.0.1:5432/ytvideos

# Optional paid TTS adapter. Costs also need a run budget and exact script approval.
ELEVENLABS_API_KEY=

# Production keeps the approved channel fonts unless an explicit override is set.
# YTV_FONT_OVERRIDE_PAPER=/absolute/path/to/approved-font.ttf
# YTV_FONT_INDEX_PAPER=0
# YTV_FONT_OVERRIDE_NUVIKO=/absolute/path/to/approved-font.ttf
# YTV_FONT_INDEX_NUVIKO=0

# Test-only PostgreSQL database; tests create and remove their own isolated schemas.
# YTV_TEST_POSTGRES_URL=postgresql://ytvideos:URL_ENCODED_PASSWORD@127.0.0.1:5432/ytvideos_test
