# macOS / editor noise
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Python environments and generated bytecode
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/env/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/site-packages/

# Local caches and downloaded model/checkpoint data
**/.cache/
**/cache/
**/Caches/
**/checkpoints/
**/models/
/Shared/Image_Motion/Tools/sam2-local/
*.pt
*.pth
*.ckpt
*.onnx

# Local secrets and machine-specific credentials
.env
.env.*
!.env.example
!**/.env.example
**/credentials.json
**/client_secret*.json
**/token.json
**/secrets.*
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db

# Temporary logs and runtime locks
*.log
*.stdout
*.stderr
*.tmp
*.temp
*.pid
**/FLOW_STATE.json.lock
**/workspace.lock

# Work-in-progress render scratch and audit dumps
**/Work/**/scratch/
**/Work/**/cache/
**/Work/**/frames/
**/Work/**/previews/
**/Edit/MediaLifecycle/**/audit.json
**/Edit/MediaLifecycle/**/workspace.lock

# Native editing sessions, exports and encoded media stay in local storage
**/*.palmier/
**/Deliverables/
*.mp4
*.mov
*.mkv
*.webm
*.mxf
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.aiff
*.caf
*.mka
*.ogg
*.oga
*.opus
*.flv
*.avi
*.3gp

# Superseded records retained locally; canonical current docs remain trackable
/.agent/archive/
/.agent/audits/
/.agent/history/
/.agent/experiments/
/.agent/discovery-checks-*/

# Additional OAuth client and token filenames used by local setup notes
**/client.json
**/*oauth*.json
**/*token*.json
**/chat/
