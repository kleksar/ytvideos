[0:v]scale=546:970:flags=lanczos,crop=540:960:x='3+2*(max(0,1-abs(t*30-51)/3.75)*sin((t*30-51)*1.5)+max(0,1-abs(t*30-111)/3.75)*sin((t*30-111)*1.5)+max(0,1-abs(t*30-151)/3.75)*sin((t*30-151)*1.5)+max(0,1-abs(t*30-211)/3.75)*sin((t*30-211)*1.5)+max(0,1-abs(t*30-251)/3.75)*sin((t*30-251)*1.5)+max(0,1-abs(t*30-291)/3.75)*sin((t*30-291)*1.5)+max(0,1-abs(t*30-351)/3.75)*sin((t*30-351)*1.5)+max(0,1-abs(t*30-392)/3.75)*sin((t*30-392)*1.5))':y='5+1.5*(max(0,1-abs(t*30-51)/3.75)*sin((t*30-51)*1.5)+max(0,1-abs(t*30-111)/3.75)*sin((t*30-111)*1.5)+max(0,1-abs(t*30-151)/3.75)*sin((t*30-151)*1.5)+max(0,1-abs(t*30-211)/3.75)*sin((t*30-211)*1.5)+max(0,1-abs(t*30-251)/3.75)*sin((t*30-251)*1.5)+max(0,1-abs(t*30-291)/3.75)*sin((t*30-291)*1.5)+max(0,1-abs(t*30-351)/3.75)*sin((t*30-351)*1.5)+max(0,1-abs(t*30-392)/3.75)*sin((t*30-392)*1.5))',format=yuv444p,split=3[base][bright][soft];
[bright]lutyuv=y='max(0,val-127)*1.8':u=128:v=128,gblur=sigma=13[glow];
[base][glow]blend=c0_expr='min(235,A+B*0.88*(pow(max(0,1-abs(T*30-51)/3.75),0.8)+pow(max(0,1-abs(T*30-111)/3.75),0.8)+pow(max(0,1-abs(T*30-151)/3.75),0.8)+pow(max(0,1-abs(T*30-211)/3.75),0.8)+pow(max(0,1-abs(T*30-251)/3.75),0.8)+pow(max(0,1-abs(T*30-291)/3.75),0.8)+pow(max(0,1-abs(T*30-351)/3.75),0.8)+pow(max(0,1-abs(T*30-392)/3.75),0.8)))':c1_expr='A':c2_expr='A'[lit];
[soft]gblur=sigma=12[blurred];
[lit][blurred]blend=all_expr='A+(B-A)*(if(lt(T*30,51),0.85*max(0,1-abs(T*30-51)/7.5),0.22*max(0,1-abs(T*30-51)/3))+if(lt(T*30,111),0.85*max(0,1-abs(T*30-111)/7.5),0.22*max(0,1-abs(T*30-111)/3))+if(lt(T*30,151),0.85*max(0,1-abs(T*30-151)/7.5),0.22*max(0,1-abs(T*30-151)/3))+if(lt(T*30,211),0.85*max(0,1-abs(T*30-211)/7.5),0.22*max(0,1-abs(T*30-211)/3))+if(lt(T*30,251),0.85*max(0,1-abs(T*30-251)/7.5),0.22*max(0,1-abs(T*30-251)/3))+if(lt(T*30,291),0.85*max(0,1-abs(T*30-291)/7.5),0.22*max(0,1-abs(T*30-291)/3))+if(lt(T*30,351),0.85*max(0,1-abs(T*30-351)/7.5),0.22*max(0,1-abs(T*30-351)/3))+if(lt(T*30,392),0.85*max(0,1-abs(T*30-392)/7.5),0.22*max(0,1-abs(T*30-392)/3)))',format=yuv444p[pre_pulse];
[pre_pulse]split[pulse_base][pulse_high];
[pulse_high]lutyuv=y='max(val,min(235,90+1.35*(val-90)))':u=val:v=val[pulse_boost];
[pulse_base][pulse_boost]blend=c0_expr='A+(B-A)*min(1,0.8*(pow(max(0,1-abs(T*30-10)/2.5),2)+pow(max(0,1-abs(T*30-30)/2.5),2)+pow(max(0,1-abs(T*30-51)/2.5),2)+pow(max(0,1-abs(T*30-71)/2.5),2)+pow(max(0,1-abs(T*30-91)/2.5),2)+pow(max(0,1-abs(T*30-111)/2.5),2)+pow(max(0,1-abs(T*30-131)/2.5),2)+pow(max(0,1-abs(T*30-151)/2.5),2)+pow(max(0,1-abs(T*30-172)/2.5),2)+pow(max(0,1-abs(T*30-191)/2.5),2)+pow(max(0,1-abs(T*30-211)/2.5),2)+pow(max(0,1-abs(T*30-231)/2.5),2)+pow(max(0,1-abs(T*30-251)/2.5),2)+pow(max(0,1-abs(T*30-271)/2.5),2)+pow(max(0,1-abs(T*30-291)/2.5),2)+pow(max(0,1-abs(T*30-311)/2.5),2)+pow(max(0,1-abs(T*30-331)/2.5),2)+pow(max(0,1-abs(T*30-352)/2.5),2)+pow(max(0,1-abs(T*30-372)/2.5),2)+pow(max(0,1-abs(T*30-392)/2.5),2)+pow(max(0,1-abs(T*30-412)/2.5),2)+pow(max(0,1-abs(T*30-432)/2.5),2)))':c1_expr='A':c2_expr='A'[vbase];
[vbase]split[base][area];
[area]crop=448:192:(iw-ow)/2:(ih-oh)/2,scale=in_color_matrix=bt709:in_range=tv:out_range=pc,format=gbrp,split[normal][active];
[normal]lutrgb=r=negval:g=negval:b=negval,scale=out_color_matrix=bt709:in_range=pc:out_range=tv,format=yuv444p[ninv];
[active]lutrgb=r='clip(127.5+1.30*(127.5-val),0,255)':g='clip(127.5+1.30*(127.5-val),0,255)':b='clip(127.5+1.30*(127.5-val),0,255)',scale=out_color_matrix=bt709:in_range=pc:out_range=tv,format=yuv444p[ainv];
[1:v]scale=448:192:flags=lanczos,format=gbrp,extractplanes=r+g[nmask][amask];
[ninv][nmask]alphamerge[nlayer];
[ainv][amask]alphamerge[alayer];
