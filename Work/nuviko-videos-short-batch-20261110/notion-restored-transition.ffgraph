[0:v]scale=546:970:flags=lanczos,crop=540:960:x='3+2*(max(0,1-abs(t*30-52)/3.75)*sin((t*30-52)*1.5)+max(0,1-abs(t*30-96)/3.75)*sin((t*30-96)*1.5)+max(0,1-abs(t*30-141)/3.75)*sin((t*30-141)*1.5)+max(0,1-abs(t*30-186)/3.75)*sin((t*30-186)*1.5)+max(0,1-abs(t*30-231)/3.75)*sin((t*30-231)*1.5)+max(0,1-abs(t*30-276)/3.75)*sin((t*30-276)*1.5)+max(0,1-abs(t*30-322)/3.75)*sin((t*30-322)*1.5)+max(0,1-abs(t*30-366)/3.75)*sin((t*30-366)*1.5)+max(0,1-abs(t*30-411)/3.75)*sin((t*30-411)*1.5))':y='5+1.5*(max(0,1-abs(t*30-52)/3.75)*sin((t*30-52)*1.5)+max(0,1-abs(t*30-96)/3.75)*sin((t*30-96)*1.5)+max(0,1-abs(t*30-141)/3.75)*sin((t*30-141)*1.5)+max(0,1-abs(t*30-186)/3.75)*sin((t*30-186)*1.5)+max(0,1-abs(t*30-231)/3.75)*sin((t*30-231)*1.5)+max(0,1-abs(t*30-276)/3.75)*sin((t*30-276)*1.5)+max(0,1-abs(t*30-322)/3.75)*sin((t*30-322)*1.5)+max(0,1-abs(t*30-366)/3.75)*sin((t*30-366)*1.5)+max(0,1-abs(t*30-411)/3.75)*sin((t*30-411)*1.5))',format=yuv444p,split=3[base][bright][soft];
[bright]lutyuv=y='max(0,val-127)*1.8':u=128:v=128,gblur=sigma=13[glow];
[base][glow]blend=c0_expr='min(235,A+B*0.88*(pow(max(0,1-abs(T*30-52)/3.75),0.8)+pow(max(0,1-abs(T*30-96)/3.75),0.8)+pow(max(0,1-abs(T*30-141)/3.75),0.8)+pow(max(0,1-abs(T*30-186)/3.75),0.8)+pow(max(0,1-abs(T*30-231)/3.75),0.8)+pow(max(0,1-abs(T*30-276)/3.75),0.8)+pow(max(0,1-abs(T*30-322)/3.75),0.8)+pow(max(0,1-abs(T*30-366)/3.75),0.8)+pow(max(0,1-abs(T*30-411)/3.75),0.8)))':c1_expr='A':c2_expr='A'[lit];
[soft]gblur=sigma=12[blurred];
[lit][blurred]blend=all_expr='A+(B-A)*(if(lt(T*30,52),0.85*max(0,1-abs(T*30-52)/7.5),0.22*max(0,1-abs(T*30-52)/3))+if(lt(T*30,96),0.85*max(0,1-abs(T*30-96)/7.5),0.22*max(0,1-abs(T*30-96)/3))+if(lt(T*30,141),0.85*max(0,1-abs(T*30-141)/7.5),0.22*max(0,1-abs(T*30-141)/3))+if(lt(T*30,186),0.85*max(0,1-abs(T*30-186)/7.5),0.22*max(0,1-abs(T*30-186)/3))+if(lt(T*30,231),0.85*max(0,1-abs(T*30-231)/7.5),0.22*max(0,1-abs(T*30-231)/3))+if(lt(T*30,276),0.85*max(0,1-abs(T*30-276)/7.5),0.22*max(0,1-abs(T*30-276)/3))+if(lt(T*30,322),0.85*max(0,1-abs(T*30-322)/7.5),0.22*max(0,1-abs(T*30-322)/3))+if(lt(T*30,366),0.85*max(0,1-abs(T*30-366)/7.5),0.22*max(0,1-abs(T*30-366)/3))+if(lt(T*30,411),0.85*max(0,1-abs(T*30-411)/7.5),0.22*max(0,1-abs(T*30-411)/3)))',format=yuv444p[vbase];
[vbase]split[base][area];
[area]crop=448:192:(iw-ow)/2:(ih-oh)/2,scale=in_color_matrix=bt709:in_range=tv:out_range=pc,format=gbrp,split[normal][active];
[normal]lutrgb=r=negval:g=negval:b=negval,scale=out_color_matrix=bt709:in_range=pc:out_range=tv,format=yuv444p[ninv];
[active]lutrgb=r='clip(127.5+1.30*(127.5-val),0,255)':g='clip(127.5+1.30*(127.5-val),0,255)':b='clip(127.5+1.30*(127.5-val),0,255)',scale=out_color_matrix=bt709:in_range=pc:out_range=tv,format=yuv444p[ainv];
