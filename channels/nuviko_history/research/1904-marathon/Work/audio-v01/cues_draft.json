{
  "cues": [
    {
      "start_seconds": 0.3,
      "end_seconds": 2.0455,
      "text": "At the 1904 Olympics,"
    },
    {
      "start_seconds": 2.3364,
      "end_seconds": 3.7182,
      "text": "Fred Lorz was the first"
    },
    {
      "start_seconds": 3.8636,
      "end_seconds": 4.6636,
      "text": "marathon runner"
    },
    {
      "start_seconds": 4.7727,
      "end_seconds": 5.9,
      "text": "across the finish line."
    },
    {
      "start_seconds": 6.4091,
      "end_seconds": 7.6455,
      "text": "But he didn't win."
    },
    {
      "start_seconds": 8.0818,
      "end_seconds": 9.5364,
      "text": "Exhausted during the race,"
    },
    {
      "start_seconds": 9.8273,
      "end_seconds": 11.2091,
      "text": "Lorz dropped out and got"
    },
    {
      "start_seconds": 11.2818,
      "end_seconds": 12.3727,
      "text": "into a car heading back"
    },
    {
      "start_seconds": 12.4455,
      "end_seconds": 13.1,
      "text": "to the stadium."
    },
    {
      "start_seconds": 13.5364,
      "end_seconds": 15.1364,
      "text": "Then the car broke down."
    },
    {
      "start_seconds": 15.5,
      "end_seconds": 16.0818,
      "text": "He got out,"
    },
    {
      "start_seconds": 16.3727,
      "end_seconds": 17.4636,
      "text": "ran the rest of the way,"
    },
    {
      "start_seconds": 17.6818,
      "end_seconds": 18.5545,
      "text": "and reached the finish"
    },
    {
      "start_seconds": 18.6273,
      "end_seconds": 19.9364,
      "text": "before the other runners."
    },
    {
      "start_seconds": 20.3,
      "end_seconds": 21.3182,
      "text": "Once officials learned"
    },
    {
      "start_seconds": 21.3909,
      "end_seconds": 22.0455,
      "text": "he had travelled"
    },
    {
      "start_seconds": 22.1182,
      "end_seconds": 23.3545,
      "text": "part of the course by car,"
    },
    {
      "start_seconds": 23.6455,
      "end_seconds": 25.0273,
      "text": "Lorz was disqualified."
    },
    {
      "start_seconds": 25.3909,
      "end_seconds": 26.4091,
      "text": "Thomas Hicks became"
    },
    {
      "start_seconds": 26.4455,
      "end_seconds": 27.3545,
      "text": "the Olympic champion."
    },
    {
      "start_seconds": 27.7909,
      "end_seconds": 29.1727,
      "text": "The next year, Lorz"
    },
    {
      "start_seconds": 29.2455,
      "end_seconds": 30.5545,
      "text": "won the Boston Marathon."
    }
  ]
}
