{
  "cues": [
    {
      "start_seconds": 0.0,
      "end_seconds": 0.642727,
      "text": "In Boston,"
    },
    {
      "start_seconds": 0.945455,
      "end_seconds": 2.690909,
      "text": "a giant tank of molasses"
    },
    {
      "start_seconds": 2.836364,
      "end_seconds": 4.072727,
      "text": "stood near people's homes."
    },
    {
      "start_seconds": 4.363636,
      "end_seconds": 5.163636,
      "text": "It had been leaking"
    },
    {
      "start_seconds": 5.272727,
      "end_seconds": 6.836364,
      "text": "for so long that children"
    },
    {
      "start_seconds": 6.909091,
      "end_seconds": 8.145455,
      "text": "collected the sweet drips"
    },
    {
      "start_seconds": 8.254545,
      "end_seconds": 8.872727,
      "text": "in buckets."
    },
    {
      "start_seconds": 9.345455,
      "end_seconds": 10.545455,
      "text": "On January fifteenth,"
    },
    {
      "start_seconds": 10.763636,
      "end_seconds": 11.781818,
      "text": "nineteen nineteen,"
    },
    {
      "start_seconds": 12.072727,
      "end_seconds": 13.236364,
      "text": "the tank burst."
    },
    {
      "start_seconds": 13.636364,
      "end_seconds": 14.909091,
      "text": "A wave of molasses"
    },
    {
      "start_seconds": 14.981818,
      "end_seconds": 16.072727,
      "text": "rushed through the streets,"
    },
    {
      "start_seconds": 16.218182,
      "end_seconds": 17.527273,
      "text": "destroying buildings."
    },
    {
      "start_seconds": 17.890909,
      "end_seconds": 19.490909,
      "text": "Twenty-one people died,"
    },
    {
      "start_seconds": 19.539091,
      "end_seconds": 20.0,
      "text": "and around"
    },
    {
      "start_seconds": 20.072727,
      "end_seconds": 21.090909,
      "text": "one hundred and fifty"
    },
    {
      "start_seconds": 21.163636,
      "end_seconds": 21.745455,
      "text": "were injured."
    },
    {
      "start_seconds": 22.181818,
      "end_seconds": 23.054545,
      "text": "The company that owned"
    },
    {
      "start_seconds": 23.127273,
      "end_seconds": 24.072727,
      "text": "the tank claimed"
    },
    {
      "start_seconds": 24.218182,
      "end_seconds": 25.163636,
      "text": "someone had blown it up."
    },
    {
      "start_seconds": 25.527273,
      "end_seconds": 26.618182,
      "text": "But how could that explain"
    },
    {
      "start_seconds": 26.690909,
      "end_seconds": 27.781818,
      "text": "a tank that had leaked"
    },
    {
      "start_seconds": 27.890909,
      "end_seconds": 28.509091,
      "text": "for years?"
    },
    {
      "start_seconds": 29.054545,
      "end_seconds": 30.036364,
      "text": "After years of legal"
    },
    {
      "start_seconds": 30.109091,
      "end_seconds": 31.418182,
      "text": "proceedings, the company"
    },
    {
      "start_seconds": 31.527273,
      "end_seconds": 32.581818,
      "text": "was held responsible."
    },
    {
      "start_seconds": 32.945455,
      "end_seconds": 33.381818,
      "text": "The tank"
    },
    {
      "start_seconds": 33.454545,
      "end_seconds": 34.472727,
      "text": "had been poorly built,"
    },
    {
      "start_seconds": 34.727273,
      "end_seconds": 35.709091,
      "text": "and signs of danger"
    },
    {
      "start_seconds": 35.818182,
      "end_seconds": 36.363636,
      "text": "had not been"
    },
    {
      "start_seconds": 36.509091,
      "end_seconds": 37.236364,
      "text": "properly addressed."
    },
    {
      "start_seconds": 37.636364,
      "end_seconds": 38.181818,
      "text": "The warning"
    },
    {
      "start_seconds": 38.254545,
      "end_seconds": 39.054545,
      "text": "had been visible"
    },
    {
      "start_seconds": 39.309091,
      "end_seconds": 40.290909,
      "text": "before the disaster."
    }
  ]
}
