  "review_notes": [
    {
      "shot": 19,
      "note": "Художественные надписи на стене сгенерированы и не являются документальной копией античных текстов."
    },
    {
      "shot": 35,
      "note": "Реконструкция рассмотрения находок иллюстрирует спор о дате; изображённые предметы не документальное доказательство."
    },
    {
      "shot": 40,
      "note": "49 — художественная реконструкция наблюдения из Мизенума; не документальный портрет Плиния."
    },
    {
      "shot": 69,
      "note": "Реконструкция плавания, не портрет реального места спасения."
    },
    {
      "shot": 71,
      "note": "Прибытие к Стабиям реконструировано; персонажи не документальные портреты."
    },
    {
      "shot": 82,
      "note": "Реконструкция исследований следов обрушения; сама иллюстрация не доказывает причину разрушения."
    },
    {
      "shot": 83,
      "note": "Ночная сцена землетрясения носит реконструктивный характер; не доказывает судьбу конкретных людей."
    },
    {
      "shot": 105,
      "note": "Реконструкция вулканических слоёв, а не документальное изображение конкретного разреза."
    },
    {
      "shot": 108,
      "note": "Вставка потока в Помпеях начинается в конце фразы о движении потока к городу; проверить стык с озвучкой."
    },
    {
      "shot": 109,
      "note": "Реконструкция движения горячей смеси через атриум, не документальный снимок."
    },
    {
      "shot": 124,
      "note": "Поток — иллюстрация исследуемого воздействия, не доказательство точной причины смерти."
    },
    {
      "shot": 131,
      "note": "Рукопись и находки на изображении художественные, не документальная копия оригинала."
    },
    {
      "shot": 134,
      "note": "Руины условно иллюстрируют последствия; кадр не изображает императора Тита."
    },
    {
      "shot": 140,
      "note": "Реконструкция археологической находки, не документальный снимок конкретных предметов."
    },
    {
      "shot": 142,
      "note": "Экспозиция — гипсовый слепок, а не окаменевшее тело."
    },
    {
      "shot": 161,
      "note": "Кадр используется как ретроспективное резюме; не выдавать его за точное расположение наблюдателя."
    }
