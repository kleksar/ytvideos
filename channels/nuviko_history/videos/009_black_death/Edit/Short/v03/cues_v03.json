{
  "cues": [
    {
      "start_seconds": "0.001818",
      "end_seconds": "0.438182",
      "text": "When the sick"
    },
    {
      "start_seconds": "0.438182",
      "end_seconds": "1.529091",
      "text": "person was a stranger,"
    },
    {
      "start_seconds": "1.529091",
      "end_seconds": "2.692727",
      "text": "you could step away."
    },
    {
      "start_seconds": "2.692727",
      "end_seconds": "3.520000",
      "text": "But what could you do"
    },
    {
      "start_seconds": "3.529091",
      "end_seconds": "4.510909",
      "text": "when the person who fell"
    },
    {
      "start_seconds": "4.510909",
      "end_seconds": "5.856364",
      "text": "ill lived with you?"
    },
    {
      "start_seconds": "5.860000",
      "end_seconds": "6.987273",
      "text": "A home, where a person"
    },
    {
      "start_seconds": "6.987273",
      "end_seconds": "8.078182",
      "text": "should have been cared for,"
    },
    {
      "start_seconds": "8.078182",
      "end_seconds": "8.478182",
      "text": "could become"
    },
    {
      "start_seconds": "8.478182",
      "end_seconds": "9.850909",
      "text": "a place of isolation."
    },
    {
      "start_seconds": "9.860000",
      "end_seconds": "10.478182",
      "text": "Not everyone"
    },
    {
      "start_seconds": "10.478182",
      "end_seconds": "11.669091",
      "text": "had the means to leave."
    },
    {
      "start_seconds": "11.678182",
      "end_seconds": "12.623636",
      "text": "Waiting out the disaster"
    },
    {
      "start_seconds": "12.623636",
      "end_seconds": "13.823636",
      "text": "in the countryside required"
    },
    {
      "start_seconds": "13.823636",
      "end_seconds": "15.460000",
      "text": "money, shelter, and people"
    },
    {
      "start_seconds": "15.460000",
      "end_seconds": "17.060000",
      "text": "to provide for everyday life."
    },
    {
      "start_seconds": "17.063636",
      "end_seconds": "18.263636",
      "text": "But if everyone leaves,"
    },
    {
      "start_seconds": "18.263636",
      "end_seconds": "19.054545",
      "text": "who will bring water"
    },
    {
      "start_seconds": "19.063636",
      "end_seconds": "19.827273",
      "text": "to the sick?"
    },
    {
      "start_seconds": "19.827273",
      "end_seconds": "20.918182",
      "text": "Who will bake bread?"
    },
    {
      "start_seconds": "20.918182",
      "end_seconds": "21.645455",
      "text": "Who will take away"
    },
    {
      "start_seconds": "21.645455",
      "end_seconds": "22.372727",
      "text": "the dead?"
    },
    {
      "start_seconds": "22.372727",
      "end_seconds": "22.990909",
      "text": "This was one"
    },
    {
      "start_seconds": "22.990909",
      "end_seconds": "24.118182",
      "text": "of the epidemic's hardest"
    },
    {
      "start_seconds": "24.118182",
      "end_seconds": "25.054545",
      "text": "contradictions."
    },
    {
      "start_seconds": "25.063636",
      "end_seconds": "26.263636",
      "text": "Staying away from the sick"
    },
    {
      "start_seconds": "26.263636",
      "end_seconds": "27.245455",
      "text": "could reduce the danger"
    },
    {
      "start_seconds": "27.245455",
      "end_seconds": "28.154545",
      "text": "to an individual,"
    },
    {
      "start_seconds": "28.154545",
      "end_seconds": "28.800000",
      "text": "yet someone"
    },
    {
      "start_seconds": "28.809091",
      "end_seconds": "29.609091",
      "text": "still had to care"
    },
    {
      "start_seconds": "29.609091",
      "end_seconds": "30.009091",
      "text": "for those"
    },
    {
      "start_seconds": "30.009091",
      "end_seconds": "30.700000",
      "text": "who could no longer"
    },
    {
      "start_seconds": "30.700000",
      "end_seconds": "31.681818",
      "text": "help themselves."
    }
  ]
}
