{
  "cues": [
    {
      "start_seconds": "0.002",
      "end_seconds": "0.482",
      "text": "When the sick"
    },
    {
      "start_seconds": "0.482",
      "end_seconds": "1.682",
      "text": "person was a stranger,"
    },
    {
      "start_seconds": "1.682",
      "end_seconds": "2.962",
      "text": "you could step away."
    },
    {
      "start_seconds": "2.962",
      "end_seconds": "3.322",
      "text": "But what"
    },
    {
      "start_seconds": "3.322",
      "end_seconds": "4.482",
      "text": "could you do when the person"
    },
    {
      "start_seconds": "4.482",
      "end_seconds": "6.442",
      "text": "who fell ill lived with you?"
    },
    {
      "start_seconds": "6.446",
      "end_seconds": "7.686",
      "text": "A home, where a person"
    },
    {
      "start_seconds": "7.686",
      "end_seconds": "8.886",
      "text": "should have been cared for,"
    },
    {
      "start_seconds": "8.886",
      "end_seconds": "9.326",
      "text": "could become"
    },
    {
      "start_seconds": "9.326",
      "end_seconds": "10.836",
      "text": "a place of isolation."
    },
    {
      "start_seconds": "10.846",
      "end_seconds": "12.046",
      "text": "Not everyone had the means"
    },
    {
      "start_seconds": "12.046",
      "end_seconds": "12.836",
      "text": "to leave."
    },
    {
      "start_seconds": "12.846",
      "end_seconds": "13.886",
      "text": "Waiting out the disaster"
    },
    {
      "start_seconds": "13.886",
      "end_seconds": "15.206",
      "text": "in the countryside required"
    },
    {
      "start_seconds": "15.206",
      "end_seconds": "17.006",
      "text": "money, shelter, and people"
    },
    {
      "start_seconds": "17.006",
      "end_seconds": "18.766",
      "text": "to provide for everyday life."
    },
    {
      "start_seconds": "18.770",
      "end_seconds": "20.090",
      "text": "But if everyone leaves,"
    },
    {
      "start_seconds": "20.090",
      "end_seconds": "20.960",
      "text": "who will bring water"
    },
    {
      "start_seconds": "20.970",
      "end_seconds": "21.810",
      "text": "to the sick?"
    },
    {
      "start_seconds": "21.810",
      "end_seconds": "23.010",
      "text": "Who will bake bread?"
    },
    {
      "start_seconds": "23.010",
      "end_seconds": "24.610",
      "text": "Who will take away the dead?"
    },
    {
      "start_seconds": "24.610",
      "end_seconds": "25.290",
      "text": "This was one"
    },
    {
      "start_seconds": "25.290",
      "end_seconds": "26.530",
      "text": "of the epidemic's hardest"
    },
    {
      "start_seconds": "26.530",
      "end_seconds": "27.560",
      "text": "contradictions."
    },
    {
      "start_seconds": "27.570",
      "end_seconds": "28.890",
      "text": "Staying away from the sick"
    },
    {
      "start_seconds": "28.890",
      "end_seconds": "29.970",
      "text": "could reduce the danger"
    },
    {
      "start_seconds": "29.970",
      "end_seconds": "30.970",
      "text": "to an individual,"
    },
    {
      "start_seconds": "30.970",
      "end_seconds": "32.570",
      "text": "yet someone still had to care"
    },
    {
      "start_seconds": "32.570",
      "end_seconds": "33.770",
      "text": "for those who could no longer"
    },
    {
      "start_seconds": "33.770",
      "end_seconds": "34.850",
      "text": "help themselves."
    }
  ]
}
