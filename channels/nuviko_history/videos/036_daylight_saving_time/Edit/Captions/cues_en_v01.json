{
  "cues": [
    {
      "start_seconds": "0.000000",
      "end_seconds": "3.520000",
      "text": "In 1916, Germany became the first country"
    },
    {
      "start_seconds": "3.520000",
      "end_seconds": "5.360000",
      "text": "to adopt daylight saving time"
    },
    {
      "start_seconds": "5.360000",
      "end_seconds": "7.760000",
      "text": "nationwide, during wartime."
    },
    {
      "start_seconds": "7.760000",
      "end_seconds": "9.840000",
      "text": "America adopted it, repealed"
    },
    {
      "start_seconds": "9.840000",
      "end_seconds": "13.360000",
      "text": "it despite a presidential veto, then restored it."
    },
    {
      "start_seconds": "13.360000",
      "end_seconds": "14.160000",
      "text": "Why?"
    },
    {
      "start_seconds": "14.160000",
      "end_seconds": "17.200000",
      "text": "Earlier proposals and local trials existed."
    },
    {
      "start_seconds": "17.200000",
      "end_seconds": "19.600000",
      "text": "War accelerated adoption."
    },
    {
      "start_seconds": "19.600000",
      "end_seconds": "23.920000",
      "text": "In 1918, America shifted clocks to save resources."
    },
    {
      "start_seconds": "23.920000",
      "end_seconds": "26.720000",
      "text": "After the war, savings were disputed."
    },
    {
      "start_seconds": "26.720000",
      "end_seconds": "29.120000",
      "text": "Why did this trouble some farmers?"
    },
    {
      "start_seconds": "29.120000",
      "end_seconds": "30.320000",
      "text": "Clocks shifted."
    },
    {
      "start_seconds": "30.320000",
      "end_seconds": "32.400000",
      "text": "The sun and dew didn't."
    },
    {
      "start_seconds": "32.400000",
      "end_seconds": "34.440000",
      "text": "At hearings, some complained:"
    },
    {
      "start_seconds": "34.440000",
      "end_seconds": "37.040000",
      "text": "hired workers waited for dew to dry;"
    },
    {
      "start_seconds": "37.040000",
      "end_seconds": "40.400000",
      "text": "stores in nearby towns closed an hour earlier."
    },
    {
      "start_seconds": "40.400000",
      "end_seconds": "42.160000",
      "text": "Other objections arose."
    },
    {
      "start_seconds": "42.160000",
      "end_seconds": "45.920000",
      "text": "In 1919, Congress repealed federal seasonal clock"
    },
    {
      "start_seconds": "45.920000",
      "end_seconds": "48.640000",
      "text": "changes, overriding Wilson's veto."
    },
    {
      "start_seconds": "48.640000",
      "end_seconds": "51.920000",
      "text": "In 1942, another war restored it:"
    },
    {
      "start_seconds": "51.920000",
      "end_seconds": "54.400000",
      "text": "clocks advanced an hour year-round."
    },
    {
      "start_seconds": "54.400000",
      "end_seconds": "58.800000",
      "text": "Separate legislation ended it September 30, 1945."
    },
    {
      "start_seconds": "58.800000",
      "end_seconds": "63.040000",
      "text": "1966 standardized scheduling with state opt-outs."
    },
    {
      "start_seconds": "63.040000",
      "end_seconds": "66.000000",
      "text": "Today's dates began in 2007."
    },
    {
      "start_seconds": "66.000000",
      "end_seconds": "67.480000",
      "text": "War didn't invent it;"
    },
    {
      "start_seconds": "67.480000",
      "end_seconds": "69.680000",
      "text": "it accelerated its spread when..."
    }
  ]
}
