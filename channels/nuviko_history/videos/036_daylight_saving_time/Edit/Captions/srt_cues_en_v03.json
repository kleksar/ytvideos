{
  "cues": [
    {
      "start_seconds": "0.000",
      "end_seconds": "3.520",
      "text": "In 1916, Germany became the first country"
    },
    {
      "start_seconds": "3.520",
      "end_seconds": "5.360",
      "text": "to adopt daylight saving time"
    },
    {
      "start_seconds": "5.360",
      "end_seconds": "7.840",
      "text": "nationwide, during wartime."
    },
    {
      "start_seconds": "7.840",
      "end_seconds": "9.920",
      "text": "America adopted it, repealed"
    },
    {
      "start_seconds": "9.920",
      "end_seconds": "13.440",
      "text": "it despite a presidential veto, then restored it."
    },
    {
      "start_seconds": "13.440",
      "end_seconds": "14.240",
      "text": "Why?"
    },
    {
      "start_seconds": "14.240",
      "end_seconds": "17.280",
      "text": "Earlier proposals and local trials existed."
    },
    {
      "start_seconds": "17.280",
      "end_seconds": "19.680",
      "text": "War accelerated adoption."
    },
    {
      "start_seconds": "19.680",
      "end_seconds": "24.080",
      "text": "In 1918, America shifted clocks to save resources."
    },
    {
      "start_seconds": "24.080",
      "end_seconds": "26.880",
      "text": "After the war, savings were disputed."
    },
    {
      "start_seconds": "26.880",
      "end_seconds": "29.200",
      "text": "Why did this trouble some farmers?"
    },
    {
      "start_seconds": "29.200",
      "end_seconds": "30.400",
      "text": "Clocks shifted."
    },
    {
      "start_seconds": "30.400",
      "end_seconds": "32.480",
      "text": "The sun and dew didn't."
    },
    {
      "start_seconds": "32.480",
      "end_seconds": "34.520",
      "text": "At hearings, some complained:"
    },
    {
      "start_seconds": "34.520",
      "end_seconds": "37.120",
      "text": "hired workers waited for dew to dry;"
    },
    {
      "start_seconds": "37.120",
      "end_seconds": "40.400",
      "text": "stores in nearby towns closed an hour earlier."
    },
    {
      "start_seconds": "40.400",
      "end_seconds": "42.160",
      "text": "Other objections arose."
    },
    {
      "start_seconds": "42.160",
      "end_seconds": "46.000",
      "text": "In 1919, Congress repealed federal seasonal clock"
    },
    {
      "start_seconds": "46.000",
      "end_seconds": "48.640",
      "text": "changes, overriding Wilson's veto."
    },
    {
      "start_seconds": "48.640",
      "end_seconds": "52.880",
      "text": "In 1942, another war restored it: clocks advanced"
    },
    {
      "start_seconds": "52.880",
      "end_seconds": "54.640",
      "text": "an hour year-round."
    },
    {
      "start_seconds": "54.640",
      "end_seconds": "59.000",
      "text": "Separate legislation ended it September 30, 1945."
    },
    {
      "start_seconds": "59.000",
      "end_seconds": "63.440",
      "text": "1966 standardized scheduling with state opt-outs."
    },
    {
      "start_seconds": "63.440",
      "end_seconds": "66.400",
      "text": "Today's dates began in 2007."
    },
    {
      "start_seconds": "66.400",
      "end_seconds": "69.600",
      "text": "War didn't invent it; it accelerated its spread"
    },
    {
      "start_seconds": "69.600",
      "end_seconds": "70.240",
      "text": "when..."
    }
  ]
}
