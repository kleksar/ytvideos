      "start_frame": 1620,
      "end_frame": 1746,
      "direction": "none",
      "zoom": "out",
      "spoken_anchor": "Separate legislation ended it September 30, 1945.",
      "narrative_job": "Separate end date in 1945",
      "asset_sha256": "0cdc4602c8b39c6085b9efba3ca5e67fa5f0dba6e35f4a0b3aca44420ddda58c"
    },
