    {
      "scene_id": "S02",
      "image": "/Users/diplomat/ytvideos/channels/nuviko_history/videos/036_daylight_saving_time/Assets/Generated/images_v01/S02.png",
      "start_frame": 180,
      "end_frame": 360,
      "direction": "right_to_left",
      "zoom": "in",
      "spoken_anchor": "America adopted it, repealed it despite a presidential veto, then restored it. Why?",
      "narrative_job": "U.S. adoption/reversal question",
      "asset_sha256": "d28a31cbfd10654797e89ad9d59e653557bb7294176e2b2ea9ec1b69ff8fcdb9"
    },
    {
      "scene_id": "S03",
      "image": "/Users/diplomat/ytvideos/channels/nuviko_history/videos/036_daylight_saving_time/Assets/Generated/images_v01/S03.png",
      "start_frame": 360,
      "end_frame": 510,
      "direction": "none",
      "zoom": "out",
      "spoken_anchor": "Earlier proposals and local trials existed. War accelerated adoption.",
      "narrative_job": "Prewar proposals and local trials",
      "asset_sha256": "c479eafb5638b5955a845cff98d8601fe0884a8eef2c2a45868236a132825907"
    },
    {
      "scene_id": "S04",
      "image": "/Users/diplomat/ytvideos/channels/nuviko_history/videos/036_daylight_saving_time/Assets/Generated/images_v01/S04.png",
      "start_frame": 510,
      "end_frame": 681,
      "direction": "left_to_right",
      "zoom": "in",
      "spoken_anchor": "In 1918, America shifted clocks to save resources.",
      "narrative_job": "U.S. wartime measure intended to save resources",
      "asset_sha256": "4381cd6cafc6495f01e803888d6e202b1fc70191db77ae1c06984e521d0b80c5"
    },
    {
      "scene_id": "S05",
      "image": "/Users/diplomat/ytvideos/channels/nuviko_history/videos/036_daylight_saving_time/Assets/Generated/images_v01/S05.png",
      "start_frame": 681,
      "end_frame": 810,
      "direction": "right_to_left",
      "zoom": "out",
      "spoken_anchor": "After the war, savings were disputed.",
      "narrative_job": "Postwar benefits disputed",
      "asset_sha256": "03126e45dcf25d9ce3104a30e10ab2016547b80b84ce0ffa7cb87aaf95ffd966"
    },
    {
      "scene_id": "S06",
      "image": "/Users/diplomat/ytvideos/channels/nuviko_history/videos/036_daylight_saving_time/Assets/Generated/images_v01/S06.png",
      "start_frame": 810,
      "end_frame": 966,
      "direction": "left_to_right",
      "zoom": "none",
      "spoken_anchor": "Why did this trouble some farmers? Clocks shifted. The sun and dew didn't.",
      "narrative_job": "Clock versus sun and dew",
      "asset_sha256": "9590d65c267b67b8f17a3fdeef51ae2c9871d821624102d9f876538e47aa7774"
    },
    {
      "scene_id": "S07",
      "image": "/Users/diplomat/ytvideos/channels/nuviko_history/videos/036_daylight_saving_time/Assets/Generated/images_v01/S07.png",
      "start_frame": 966,
      "end_frame": 1116,
      "direction": "right_to_left",
      "zoom": "in",
      "spoken_anchor": "At hearings, some complained: hired workers waited for dew to dry;",
      "narrative_job": "Specific complaint about hired workers waiting for dew",
      "asset_sha256": "6f1982e13f9d6b6ea8ed16ce078e6b63f9b7dc9322199a8a746544045fa2746c"
    },
    {
      "scene_id": "S08",
      "image": "/Users/diplomat/ytvideos/channels/nuviko_history/videos/036_daylight_saving_time/Assets/Generated/images_v01/S08.png",
      "start_frame": 1116,
      "end_frame": 1260,
      "direction": "none",
      "zoom": "out",
      "spoken_anchor": "stores in nearby towns closed an hour earlier. Other objections arose.",
      "narrative_job": "Specific complaint about nearby stores closing early",
      "asset_sha256": "ca7dc89b2a5e480ceba694ac36393587598cc89980aa0d2917ca266c597a4144"
    },
    {
      "scene_id": "S09",
      "image": "/Users/diplomat/ytvideos/channels/nuviko_history/videos/036_daylight_saving_time/Assets/Generated/images_v01/S09.png",
      "start_frame": 1260,
      "end_frame": 1440,
      "direction": "left_to_right",
      "zoom": "none",
      "spoken_anchor": "In 1919, Congress repealed federal seasonal clock changes, overriding Wilson's veto.",
      "narrative_job": "Federal repeal over Wilson veto",
      "asset_sha256": "6575d1c9f6f2ece563baabdc7c47fa95ff8075f4d49401d9ea19b02d21e3b5fe"
    },
    {
      "scene_id": "S10",
      "image": "/Users/diplomat/ytvideos/channels/nuviko_history/videos/036_daylight_saving_time/Assets/Generated/images_v01/S10.png",
      "start_frame": 1440,
      "end_frame": 1620,
      "direction": "right_to_left",
      "zoom": "in",
      "spoken_anchor": "In 1942, another war restored it: clocks advanced an hour year-round.",
      "narrative_job": "Year-round 1942 War Time",
      "asset_sha256": "2f11c820d03deb8af41aba8f628411e3a43f334db3529d50979077905c95c620"
    },
    {
      "scene_id": "S11",
