{
  "cues": [
    {
      "start_seconds": "0.100",
      "end_seconds": "1.540",
      "text": "On the night of November 5,"
    },
    {
      "start_seconds": "1.820",
      "end_seconds": "3.500",
      "text": "1605, a man"
    },
    {
      "start_seconds": "3.640",
      "end_seconds": "5.060",
      "text": "and barrels of gunpowder"
    },
    {
      "start_seconds": "5.120",
      "end_seconds": "5.741",
      "text": "were discovered"
    },
    {
      "start_seconds": "5.781",
      "end_seconds": "7.121",
      "text": "beneath the House of Lords"
    },
    {
      "start_seconds": "7.201",
      "end_seconds": "7.701",
      "text": "in London."
    },
    {
      "start_seconds": "8.101",
      "end_seconds": "8.701",
      "text": "The man gave"
    },
    {
      "start_seconds": "8.741",
      "end_seconds": "10.481",
      "text": "his name as John Johnson."
    },
    {
      "start_seconds": "10.881",
      "end_seconds": "11.341",
      "text": "His real"
    },
    {
      "start_seconds": "11.381",
      "end_seconds": "12.941",
      "text": "name was Guy Fawkes."
    },
    {
      "start_seconds": "13.541",
      "end_seconds": "14.381",
      "text": "That same day,"
    },
    {
      "start_seconds": "14.621",
      "end_seconds": "15.681",
      "text": "King James the First"
    },
    {
      "start_seconds": "15.721",
      "end_seconds": "17.182",
      "text": "of England was due to attend"
    },
    {
      "start_seconds": "17.242",
      "end_seconds": "18.382",
      "text": "the opening of Parliament."
    },
    {
      "start_seconds": "18.802",
      "end_seconds": "20.062",
      "text": "Members of both Houses"
    },
    {
      "start_seconds": "20.122",
      "end_seconds": "20.762",
      "text": "would be gathered"
    },
    {
      "start_seconds": "20.802",
      "end_seconds": "21.382",
      "text": "there with him."
    },
    {
      "start_seconds": "21.762",
      "end_seconds": "22.802",
      "text": "The people who had hidden"
    },
    {
      "start_seconds": "22.842",
      "end_seconds": "23.942",
      "text": "the gunpowder planned"
    },
    {
      "start_seconds": "23.982",
      "end_seconds": "24.582",
      "text": "to kill them"
    },
    {
      "start_seconds": "24.802",
      "end_seconds": "26.382",
      "text": "all in a single explosion."
    },
    {
      "start_seconds": "26.782",
      "end_seconds": "27.443",
      "text": "But Fawkes"
    },
    {
      "start_seconds": "27.583",
      "end_seconds": "29.103",
      "text": "was not the leader of the plot."
    },
    {
      "start_seconds": "29.463",
      "end_seconds": "31.043",
      "text": "And yet, centuries later,"
    },
    {
      "start_seconds": "31.343",
      "end_seconds": "33.063",
      "text": "it is his name that millions"
    },
    {
      "start_seconds": "33.103",
      "end_seconds": "34.503",
      "text": "of people still remember."
    },
    {
      "start_seconds": "35.023",
      "end_seconds": "35.983",
      "text": "Two years earlier,"
    },
    {
      "start_seconds": "36.283",
      "end_seconds": "37.623",
      "text": "England had a new monarch."
    },
    {
      "start_seconds": "38.024",
      "end_seconds": "39.204",
      "text": "Many English Catholics"
    },
    {
      "start_seconds": "39.304",
      "end_seconds": "40.724",
      "text": "hoped that James would ease"
    },
    {
      "start_seconds": "40.764",
      "end_seconds": "41.264",
      "text": "the religious"
    },
    {
      "start_seconds": "41.324",
      "end_seconds": "42.444",
      "text": "restrictions imposed"
    },
    {
      "start_seconds": "42.524",
      "end_seconds": "43.524",
      "text": "under his predecessor,"
    },
    {
      "start_seconds": "43.724",
      "end_seconds": "44.664",
      "text": "Elizabeth the First."
    },
    {
      "start_seconds": "45.064",
      "end_seconds": "46.364",
      "text": "Catholics faced fines"
    },
    {
      "start_seconds": "46.464",
      "end_seconds": "47.324",
      "text": "and persecution,"
    },
    {
      "start_seconds": "47.544",
      "end_seconds": "48.544",
      "text": "and Catholic priests"
    },
    {
      "start_seconds": "48.665",
      "end_seconds": "49.805",
      "text": "were being hunted down."
    },
    {
      "start_seconds": "50.225",
      "end_seconds": "51.465",
      "text": "Those hopes for change"
    },
    {
      "start_seconds": "51.605",
      "end_seconds": "52.465",
      "text": "were disappointed."
    },
    {
      "start_seconds": "52.885",
      "end_seconds": "54.745",
      "text": "So a small group of Catholics"
    },
    {
      "start_seconds": "54.805",
      "end_seconds": "56.305",
      "text": "decided to take action."
    },
    {
      "start_seconds": "56.665",
      "end_seconds": "57.645",
      "text": "They did not represent"
    },
    {
      "start_seconds": "57.905",
      "end_seconds": "58.945",
      "text": "all English Catholics."
    },
    {
      "start_seconds": "59.345",
      "end_seconds": "60.586",
      "text": "The plot was a decision"
    },
    {
      "start_seconds": "60.626",
      "end_seconds": "62.386",
      "text": "made by specific individuals."
    },
    {
      "start_seconds": "62.826",
      "end_seconds": "63.626",
      "text": "The group was led"
    },
    {
      "start_seconds": "63.706",
      "end_seconds": "64.446",
      "text": "by a nobleman"
    },
    {
      "start_seconds": "64.526",
      "end_seconds": "65.686",
      "text": "named Robert Catesby."
    },
    {
      "start_seconds": "66.066",
      "end_seconds": "67.286",
      "text": "His plan was to blow"
    },
    {
      "start_seconds": "67.346",
      "end_seconds": "67.926",
      "text": "up Parliament"
    },
    {
      "start_seconds": "67.986",
      "end_seconds": "68.786",
      "text": "during its opening"
    },
    {
      "start_seconds": "68.846",
      "end_seconds": "70.547",
      "text": "ceremony and kill the king."
    },
    {
      "start_seconds": "71.027",
      "end_seconds": "72.467",
      "text": "Guy Fawkes also joined"
    },
    {
      "start_seconds": "72.487",
      "end_seconds": "73.227",
      "text": "the conspiracy."
    },
    {
      "start_seconds": "73.587",
      "end_seconds": "74.447",
      "text": "He was a soldier"
    },
    {
      "start_seconds": "74.507",
      "end_seconds": "75.107",
      "text": "who had served"
    },
    {
      "start_seconds": "75.147",
      "end_seconds": "76.147",
      "text": "in the Spanish army."
    },
    {
      "start_seconds": "76.487",
      "end_seconds": "77.627",
      "text": "His job was to guard"
    },
    {
      "start_seconds": "77.667",
      "end_seconds": "78.827",
      "text": "the gunpowder and,"
    },
    {
      "start_seconds": "79.027",
      "end_seconds": "80.807",
      "text": "when the time came, ignite it."
    },
    {
      "start_seconds": "81.168",
      "end_seconds": "82.108",
      "text": "But the explosion"
    },
    {
      "start_seconds": "82.168",
      "end_seconds": "83.368",
      "text": "was only the beginning"
    },
    {
      "start_seconds": "83.408",
      "end_seconds": "84.048",
      "text": "of their plan."
    },
    {
      "start_seconds": "84.408",
      "end_seconds": "85.468",
      "text": "The conspirators hoped"
    },
    {
      "start_seconds": "85.508",
      "end_seconds": "86.648",
      "text": "to launch an uprising"
    },
    {
      "start_seconds": "86.748",
      "end_seconds": "88.068",
      "text": "and seize the king's young"
    },
    {
      "start_seconds": "88.128",
      "end_seconds": "89.528",
      "text": "daughter, Princess Elizabeth."
    },
    {
      "start_seconds": "89.948",
      "end_seconds": "90.568",
      "text": "They believed"
    },
    {
      "start_seconds": "90.608",
      "end_seconds": "92.029",
      "text": "that once James was dead,"
    },
    {
      "start_seconds": "92.269",
      "end_seconds": "92.789",
      "text": "they could bring"
    },
    {
      "start_seconds": "92.849",
      "end_seconds": "94.769",
      "text": "about changes in the country."
    },
    {
      "start_seconds": "94.949",
      "end_seconds": "96.829",
      "text": "In 1605, the conspirators"
    },
    {
      "start_seconds": "96.929",
      "end_seconds": "97.649",
      "text": "rented a space"
    },
    {
      "start_seconds": "97.709",
      "end_seconds": "98.449",
      "text": "beneath the House"
    },
    {
      "start_seconds": "98.489",
      "end_seconds": "99.529",
      "text": "of Lords and brought"
    },
    {
      "start_seconds": "99.569",
      "end_seconds": "100.829",
      "text": "the gunpowder inside."
    },
    {
      "start_seconds": "101.189",
      "end_seconds": "102.309",
      "text": "The opening of Parliament"
    },
    {
      "start_seconds": "102.349",
      "end_seconds": "103.670",
      "text": "had been postponed several"
    },
    {
      "start_seconds": "103.730",
      "end_seconds": "105.190",
      "text": "times, but it was finally"
    },
    {
      "start_seconds": "105.250",
      "end_seconds": "106.690",
      "text": "scheduled for November 5."
    },
    {
      "start_seconds": "107.210",
      "end_seconds": "108.470",
      "text": "Everything seemed ready."
    },
    {
      "start_seconds": "108.930",
      "end_seconds": "110.470",
      "text": "Then a letter appeared."
    },
    {
      "start_seconds": "110.870",
      "end_seconds": "111.690",
      "text": "On October 26,"
    },
    {
      "start_seconds": "112.370",
      "end_seconds": "113.230",
      "text": "Lord Monteagle"
    },
    {
      "start_seconds": "113.290",
      "end_seconds": "114.391",
      "text": "received an anonymous"
    },
    {
      "start_seconds": "114.451",
      "end_seconds": "115.691",
      "text": "warning advising him"
    },
    {
      "start_seconds": "115.851",
      "end_seconds": "117.091",
      "text": "not to attend Parliament."
    },
    {
      "start_seconds": "117.451",
      "end_seconds": "118.251",
      "text": "The letter reached"
    },
    {
      "start_seconds": "118.291",
      "end_seconds": "119.231",
      "text": "the royal authorities."
    },
    {
      "start_seconds": "119.691",
      "end_seconds": "120.171",
      "text": "Who sent"
    },
    {
      "start_seconds": "120.211",
      "end_seconds": "121.571",
      "text": "it remains unknown."
    },
    {
      "start_seconds": "122.031",
      "end_seconds": "122.911",
      "text": "Suspicion fell"
    },
    {
      "start_seconds": "122.991",
      "end_seconds": "124.171",
      "text": "on one of the conspirators,"
    },
    {
      "start_seconds": "124.452",
      "end_seconds": "125.672",
      "text": "a relative of Monteagle,"
    },
    {
      "start_seconds": "125.932",
      "end_seconds": "126.912",
      "text": "but his authorship"
    },
    {
      "start_seconds": "126.992",
      "end_seconds": "127.912",
      "text": "was never proven."
    },
    {
      "start_seconds": "128.292",
      "end_seconds": "129.112",
      "text": "The conspirators"
    },
    {
      "start_seconds": "129.212",
      "end_seconds": "130.152",
      "text": "learned about the letter."
    },
    {
      "start_seconds": "130.572",
      "end_seconds": "131.652",
      "text": "Now there was a danger"
    },
    {
      "start_seconds": "131.692",
      "end_seconds": "132.472",
      "text": "that the authorities"
    },
    {
      "start_seconds": "132.512",
      "end_seconds": "133.532",
      "text": "would search the building"
    },
    {
      "start_seconds": "133.652",
      "end_seconds": "134.952",
      "text": "and discover the gunpowder."
    },
    {
      "start_seconds": "135.393",
      "end_seconds": "135.973",
      "text": "Even so,"
    },
    {
      "start_seconds": "136.233",
      "end_seconds": "137.633",
      "text": "they decided to go ahead."
    },
    {
      "start_seconds": "138.053",
      "end_seconds": "138.473",
      "text": "On the night"
    },
    {
      "start_seconds": "138.533",
      "end_seconds": "139.713",
      "text": "before Parliament was due"
    },
    {
      "start_seconds": "139.753",
      "end_seconds": "141.073",
      "text": "to open, the authorities"
    },
    {
      "start_seconds": "141.153",
      "end_seconds": "142.053",
      "text": "conducted a search."
    },
    {
      "start_seconds": "142.413",
      "end_seconds": "143.413",
      "text": "They found Fawkes"
    },
    {
      "start_seconds": "143.493",
      "end_seconds": "144.053",
      "text": "near the room"
    },
    {
      "start_seconds": "144.113",
      "end_seconds": "145.253",
      "text": "containing the gunpowder"
    },
    {
      "start_seconds": "145.453",
      "end_seconds": "146.234",
      "text": "and arrested him."
    },
    {
      "start_seconds": "146.614",
      "end_seconds": "147.414",
      "text": "The explosion"
    },
    {
      "start_seconds": "147.794",
      "end_seconds": "148.494",
      "text": "never happened."
    },
    {
      "start_seconds": "148.734",
      "end_seconds": "149.374",
      "text": "While Fawkes"
    },
    {
      "start_seconds": "149.434",
      "end_seconds": "150.354",
      "text": "was being questioned"
    },
    {
      "start_seconds": "150.414",
      "end_seconds": "151.654",
      "text": "in London, Catesby"
    },
    {
      "start_seconds": "151.714",
      "end_seconds": "153.214",
      "text": "and other conspirators tried"
    },
    {
      "start_seconds": "153.254",
      "end_seconds": "154.274",
      "text": "to gather supporters"
    },
    {
      "start_seconds": "154.394",
      "end_seconds": "155.374",
      "text": "outside the capital."
    },
    {
      "start_seconds": "155.694",
      "end_seconds": "156.294",
      "text": "But the large"
    },
    {
      "start_seconds": "156.394",
      "end_seconds": "157.455",
      "text": "uprising they had hoped"
    },
    {
      "start_seconds": "157.515",
      "end_seconds": "159.195",
      "text": "for never materialized."
    },
    {
      "start_seconds": "159.675",
      "end_seconds": "160.155",
      "text": "A few days"
    },
    {
      "start_seconds": "160.215",
      "end_seconds": "161.415",
      "text": "later, the authorities"
    },
    {
      "start_seconds": "161.515",
      "end_seconds": "162.675",
      "text": "caught up with the fugitives."
    },
    {
      "start_seconds": "163.095",
      "end_seconds": "164.215",
      "text": "Catesby was killed"
    },
    {
      "start_seconds": "164.255",
      "end_seconds": "164.855",
      "text": "in a shootout."
    },
    {
      "start_seconds": "165.315",
      "end_seconds": "166.475",
      "text": "Fawkes was imprisoned"
    },
    {
      "start_seconds": "166.515",
      "end_seconds": "167.035",
      "text": "in the Tower"
    },
    {
      "start_seconds": "167.075",
      "end_seconds": "168.576",
      "text": "of London and interrogated."
    },
    {
      "start_seconds": "168.996",
      "end_seconds": "170.576",
      "text": "A royal order has survived"
    },
    {
      "start_seconds": "170.836",
      "end_seconds": "172.496",
      "text": "authorizing the use of torture"
    },
    {
      "start_seconds": "172.536",
      "end_seconds": "173.056",
      "text": "against him."
    },
    {
      "start_seconds": "173.516",
      "end_seconds": "175.876",
      "text": "In January 1606, Fawkes"
    },
    {
      "start_seconds": "175.996",
      "end_seconds": "176.936",
      "text": "and the other surviving"
    },
    {
      "start_seconds": "176.976",
      "end_seconds": "178.657",
      "text": "conspirators were executed."
    },
    {
      "start_seconds": "179.077",
      "end_seconds": "180.337",
      "text": "The conspirators had wanted"
    },
    {
      "start_seconds": "180.377",
      "end_seconds": "181.517",
      "text": "to change the position"
    },
    {
      "start_seconds": "181.537",
      "end_seconds": "182.557",
      "text": "of English Catholics."
    },
    {
      "start_seconds": "182.897",
      "end_seconds": "183.677",
      "text": "But after the plot"
    },
    {
      "start_seconds": "183.777",
      "end_seconds": "184.977",
      "text": "failed, suspicion"
    },
    {
      "start_seconds": "185.017",
      "end_seconds": "186.737",
      "text": "toward Catholics intensified,"
    },
    {
      "start_seconds": "186.957",
      "end_seconds": "187.737",
      "text": "and the authorities"
    },
    {
      "start_seconds": "187.837",
      "end_seconds": "188.597",
      "text": "introduced new"
    },
    {
      "start_seconds": "188.657",
      "end_seconds": "189.898",
      "text": "requirements for their oath"
    },
    {
      "start_seconds": "189.938",
      "end_seconds": "190.498",
      "text": "of allegiance."
    },
    {
      "start_seconds": "191.018",
      "end_seconds": "192.318",
      "text": "November 5 itself"
    },
    {
      "start_seconds": "192.438",
      "end_seconds": "193.998",
      "text": "became a day of thanksgiving"
    },
    {
      "start_seconds": "194.078",
      "end_seconds": "194.858",
      "text": "for the survival"
    },
    {
      "start_seconds": "194.878",
      "end_seconds": "196.158",
      "text": "of the king and Parliament."
    },
    {
      "start_seconds": "196.598",
      "end_seconds": "197.198",
      "text": "Over time,"
    },
    {
      "start_seconds": "197.438",
      "end_seconds": "198.378",
      "text": "a tradition developed"
    },
    {
      "start_seconds": "198.438",
      "end_seconds": "199.818",
      "text": "in Britain of marking the day"
    },
    {
      "start_seconds": "199.858",
      "end_seconds": "201.639",
      "text": "with bonfires and fireworks."
    },
    {
      "start_seconds": "202.039",
      "end_seconds": "203.039",
      "text": "People began burning"
    },
    {
      "start_seconds": "203.199",
      "end_seconds": "204.519",
      "text": "effigies of Guy Fawkes"
    },
    {
      "start_seconds": "204.699",
      "end_seconds": "205.679",
      "text": "on those bonfires."
    },
    {
      "start_seconds": "206.099",
      "end_seconds": "207.219",
      "text": "And so a man"
    },
    {
      "start_seconds": "207.259",
      "end_seconds": "208.119",
      "text": "who had never led"
    },
    {
      "start_seconds": "208.159",
      "end_seconds": "209.979",
      "text": "the conspiracy gave his name"
    },
    {
      "start_seconds": "210.039",
      "end_seconds": "211.020",
      "text": "to a celebration"
    },
    {
      "start_seconds": "211.080",
      "end_seconds": "211.920",
      "text": "that commemorates"
    },
    {
      "start_seconds": "212.040",
      "end_seconds": "212.720",
      "text": "its failure."
    }
  ]
}
