{
  "cues": [
    {
      "start_seconds": "0.14",
      "end_seconds": "2.703",
      "text": "On November 21, 1915,"
    },
    {
      "start_seconds": "3.043",
      "end_seconds": "4.564",
      "text": "a ship called Endurance"
    },
    {
      "start_seconds": "4.845",
      "end_seconds": "6.166",
      "text": "sank in the Weddell Sea,"
    },
    {
      "start_seconds": "6.366",
      "end_seconds": "7.247",
      "text": "near Antarctica."
    },
    {
      "start_seconds": "7.787",
      "end_seconds": "8.988",
      "text": "All twenty-eight men"
    },
    {
      "start_seconds": "9.049",
      "end_seconds": "9.949",
      "text": "of her expedition"
    },
    {
      "start_seconds": "10.15",
      "end_seconds": "11.151",
      "text": "were still alive."
    },
    {
      "start_seconds": "11.611",
      "end_seconds": "12.692",
      "text": "But they had no ship,"
    },
    {
      "start_seconds": "13.132",
      "end_seconds": "14.914",
      "text": "no radio, and no way"
    },
    {
      "start_seconds": "14.954",
      "end_seconds": "16.295",
      "text": "to tell the outside world"
    },
    {
      "start_seconds": "16.395",
      "end_seconds": "17.036",
      "text": "where they were."
    },
    {
      "start_seconds": "17.617",
      "end_seconds": "18.497",
      "text": "They were stranded"
    },
    {
      "start_seconds": "18.578",
      "end_seconds": "19.87",
      "text": "on drifting sea ice,"
    },
    {
      "start_seconds": "20.15",
      "end_seconds": "21.823",
      "text": "with three small lifeboats"
    },
    {
      "start_seconds": "22.063",
      "end_seconds": "23.124",
      "text": "and whatever supplies"
    },
    {
      "start_seconds": "23.184",
      "end_seconds": "24.425",
      "text": "they had managed to save."
    },
    {
      "start_seconds": "24.945",
      "end_seconds": "26.147",
      "text": "To get everyone home,"
    },
    {
      "start_seconds": "26.567",
      "end_seconds": "27.948",
      "text": "six men would eventually"
    },
    {
      "start_seconds": "28.008",
      "end_seconds": "28.889",
      "text": "have to cross more"
    },
    {
      "start_seconds": "28.909",
      "end_seconds": "30.41",
      "text": "than eight hundred miles"
    },
    {
      "start_seconds": "30.47",
      "end_seconds": "32.772",
      "text": "of open ocean in a boat barely"
    },
    {
      "start_seconds": "32.953",
      "end_seconds": "34.094",
      "text": "seven metres long."
    },
    {
      "start_seconds": "34.654",
      "end_seconds": "35.595",
      "text": "The other twenty-two"
    },
    {
      "start_seconds": "35.835",
      "end_seconds": "36.596",
      "text": "would have to wait,"
    },
    {
      "start_seconds": "36.976",
      "end_seconds": "38.057",
      "text": "without knowing whether"
    },
    {
      "start_seconds": "38.117",
      "end_seconds": "39.659",
      "text": "those six had survived."
    },
    {
      "start_seconds": "40.19",
      "end_seconds": "41.282",
      "text": "And even if the boat"
    },
    {
      "start_seconds": "41.382",
      "end_seconds": "42.824",
      "text": "reached help, someone"
    },
    {
      "start_seconds": "42.884",
      "end_seconds": "44.445",
      "text": "would still have to find a way"
    },
    {
      "start_seconds": "44.585",
      "end_seconds": "46.727",
      "text": "back through the ice."
    },
    {
      "start_seconds": "46.867",
      "end_seconds": "49.149",
      "text": "In 1914, Ernest Shackleton"
    },
    {
      "start_seconds": "49.249",
      "end_seconds": "50.571",
      "text": "set out to lead the first"
    },
    {
      "start_seconds": "50.711",
      "end_seconds": "52.432",
      "text": "expedition across Antarctica,"
    },
    {
      "start_seconds": "52.692",
      "end_seconds": "53.954",
      "text": "travelling from one coast"
    },
    {
      "start_seconds": "53.994",
      "end_seconds": "55.095",
      "text": "to the other by way"
    },
    {
      "start_seconds": "55.135",
      "end_seconds": "56.075",
      "text": "of the South Pole."
    },
    {
      "start_seconds": "56.616",
      "end_seconds": "57.156",
      "text": "His ship,"
    },
    {
      "start_seconds": "57.457",
      "end_seconds": "58.878",
      "text": "Endurance, was supposed"
    },
    {
      "start_seconds": "58.918",
      "end_seconds": "60.07",
      "text": "to carry the expedition"
    },
    {
      "start_seconds": "60.21",
      "end_seconds": "61.282",
      "text": "into the Weddell Sea,"
    },
    {
      "start_seconds": "61.522",
      "end_seconds": "62.243",
      "text": "where the crossing"
    },
    {
      "start_seconds": "62.303",
      "end_seconds": "62.844",
      "text": "would begin."
    },
    {
      "start_seconds": "63.384",
      "end_seconds": "65.426",
      "text": "But in January 1915,"
    },
    {
      "start_seconds": "65.766",
      "end_seconds": "66.807",
      "text": "moving pack ice"
    },
    {
      "start_seconds": "66.947",
      "end_seconds": "68.228",
      "text": "closed around the vessel."
    },
    {
      "start_seconds": "68.749",
      "end_seconds": "69.349",
      "text": "For months,"
    },
    {
      "start_seconds": "69.67",
      "end_seconds": "70.951",
      "text": "Captain Frank Worsley"
    },
    {
      "start_seconds": "71.051",
      "end_seconds": "72.052",
      "text": "tracked their position"
    },
    {
      "start_seconds": "72.232",
      "end_seconds": "73.433",
      "text": "while the crew maintained"
    },
    {
      "start_seconds": "73.453",
      "end_seconds": "74.594",
      "text": "the ship and waited"
    },
    {
      "start_seconds": "74.654",
      "end_seconds": "75.795",
      "text": "for a chance to escape."
    },
    {
      "start_seconds": "76.356",
      "end_seconds": "77.577",
      "text": "The sea ice moved"
    },
    {
      "start_seconds": "77.617",
      "end_seconds": "78.938",
      "text": "with the winds and currents."
    },
    {
      "start_seconds": "79.409",
      "end_seconds": "80.43",
      "text": "Instead of carrying them"
    },
    {
      "start_seconds": "80.51",
      "end_seconds": "81.863",
      "text": "toward their destination,"
    },
    {
      "start_seconds": "82.143",
      "end_seconds": "83.364",
      "text": "it took the trapped ship"
    },
    {
      "start_seconds": "83.544",
      "end_seconds": "84.645",
      "text": "wherever it drifted."
    },
    {
      "start_seconds": "85.226",
      "end_seconds": "86.507",
      "text": "Then, in October,"
    },
    {
      "start_seconds": "86.767",
      "end_seconds": "87.328",
      "text": "the pressure"
    },
    {
      "start_seconds": "87.408",
      "end_seconds": "88.449",
      "text": "became too great."
    },
    {
      "start_seconds": "88.849",
      "end_seconds": "90.13",
      "text": "The wooden hull began"
    },
    {
      "start_seconds": "90.17",
      "end_seconds": "90.851",
      "text": "to give way."
    },
    {
      "start_seconds": "91.351",
      "end_seconds": "92.152",
      "text": "Water entered,"
    },
    {
      "start_seconds": "92.492",
      "end_seconds": "93.493",
      "text": "and on October 27,"
    },
    {
      "start_seconds": "93.553",
      "end_seconds": "95.595",
      "text": "Shackleton ordered the men"
    },
    {
      "start_seconds": "95.715",
      "end_seconds": "96.796",
      "text": "to abandon ship."
    },
    {
      "start_seconds": "97.297",
      "end_seconds": "98.798",
      "text": "They carried three lifeboats,"
    },
    {
      "start_seconds": "99.078",
      "end_seconds": "100.47",
      "text": "provisions and equipment"
    },
    {
      "start_seconds": "100.751",
      "end_seconds": "101.903",
      "text": "onto the surrounding ice."
    },
    {
      "start_seconds": "102.543",
      "end_seconds": "103.784",
      "text": "On November 21,"
    },
    {
      "start_seconds": "104.265",
      "end_seconds": "105.546",
      "text": "Endurance sank."
    },
    {
      "start_seconds": "106.087",
      "end_seconds": "106.907",
      "text": "The expedition"
    },
    {
      "start_seconds": "106.967",
      "end_seconds": "107.968",
      "text": "had never reached"
    },
    {
      "start_seconds": "108.028",
      "end_seconds": "108.869",
      "text": "its starting point"
    },
    {
      "start_seconds": "108.949",
      "end_seconds": "110.19",
      "text": "on the Antarctic continent."
    },
    {
      "start_seconds": "110.771",
      "end_seconds": "112.512",
      "text": "Now the men had to find"
    },
    {
      "start_seconds": "112.672",
      "end_seconds": "113.673",
      "text": "another way home."
    },
    {
      "start_seconds": "114.774",
      "end_seconds": "116.055",
      "text": "Shackleton first tried"
    },
    {
      "start_seconds": "116.135",
      "end_seconds": "117.777",
      "text": "moving toward land on foot."
    },
    {
      "start_seconds": "118.137",
      "end_seconds": "119.69",
      "text": "But hauling heavy lifeboats"
    },
    {
      "start_seconds": "119.75",
      "end_seconds": "120.831",
      "text": "across broken ice"
    },
    {
      "start_seconds": "120.962",
      "end_seconds": "122.503",
      "text": "proved almost impossible."
    },
    {
      "start_seconds": "123.044",
      "end_seconds": "124.425",
      "text": "Ridges blocked their path,"
    },
    {
      "start_seconds": "124.805",
      "end_seconds": "126.227",
      "text": "cracks forced detours,"
    },
    {
      "start_seconds": "126.527",
      "end_seconds": "127.047",
      "text": "and the men"
    },
    {
      "start_seconds": "127.127",
      "end_seconds": "128.288",
      "text": "made little progress."
    },
    {
      "start_seconds": "128.849",
      "end_seconds": "129.99",
      "text": "They abandoned the march"
    },
    {
      "start_seconds": "130.23",
      "end_seconds": "131.351",
      "text": "and established a camp"
    },
    {
      "start_seconds": "131.431",
      "end_seconds": "132.472",
      "text": "on a drifting floe."
    },
    {
      "start_seconds": "133.053",
      "end_seconds": "133.673",
      "text": "For months,"
    },
    {
      "start_seconds": "133.994",
      "end_seconds": "135.395",
      "text": "they waited as the current"
    },
    {
      "start_seconds": "135.475",
      "end_seconds": "136.276",
      "text": "carried them north."
    },
    {
      "start_seconds": "136.776",
      "end_seconds": "137.937",
      "text": "They rationed their food,"
    },
    {
      "start_seconds": "138.237",
      "end_seconds": "139.81",
      "text": "hunted seals and penguins,"
    },
    {
      "start_seconds": "140.09",
      "end_seconds": "141.522",
      "text": "and kept the lifeboats ready."
    },
    {
      "start_seconds": "142.163",
      "end_seconds": "143.885",
      "text": "In April 1916,"
    },
    {
      "start_seconds": "144.145",
      "end_seconds": "145.186",
      "text": "the ice beneath them"
    },
    {
      "start_seconds": "145.286",
      "end_seconds": "146.547",
      "text": "began breaking apart."
    },
    {
      "start_seconds": "147.067",
      "end_seconds": "148.669",
      "text": "On April 9, they launched"
    },
    {
      "start_seconds": "148.709",
      "end_seconds": "150.01",
      "text": "their boats into the water."
    },
    {
      "start_seconds": "150.55",
      "end_seconds": "151.531",
      "text": "For nearly a week,"
    },
    {
      "start_seconds": "151.772",
      "end_seconds": "153.433",
      "text": "the crews rowed and sailed"
    },
    {
      "start_seconds": "153.493",
      "end_seconds": "154.774",
      "text": "between moving floes,"
    },
    {
      "start_seconds": "155.135",
      "end_seconds": "156.115",
      "text": "struggling to reach"
    },
    {
      "start_seconds": "156.296",
      "end_seconds": "157.096",
      "text": "Elephant Island."
    },
    {
      "start_seconds": "157.657",
      "end_seconds": "158.618",
      "text": "On April 15,"
    },
    {
      "start_seconds": "159.058",
      "end_seconds": "160.23",
      "text": "all twenty-eight men"
    },
    {
      "start_seconds": "160.49",
      "end_seconds": "161.382",
      "text": "finally landed."
    },
    {
      "start_seconds": "161.723",
      "end_seconds": "162.403",
      "text": "They had reached"
    },
    {
      "start_seconds": "162.523",
      "end_seconds": "163.384",
      "text": "solid ground,"
    },
    {
      "start_seconds": "163.764",
      "end_seconds": "164.865",
      "text": "but Elephant Island"
    },
    {
      "start_seconds": "164.945",
      "end_seconds": "166.627",
      "text": "was uninhabited and far"
    },
    {
      "start_seconds": "166.727",
      "end_seconds": "167.948",
      "text": "from normal shipping routes."
    },
    {
      "start_seconds": "168.509",
      "end_seconds": "169.81",
      "text": "No rescue ship knew"
    },
    {
      "start_seconds": "169.87",
      "end_seconds": "170.47",
      "text": "they were there."
    },
    {
      "start_seconds": "171.131",
      "end_seconds": "172.152",
      "text": "Shackleton decided"
    },
    {
      "start_seconds": "172.212",
      "end_seconds": "173.974",
      "text": "that a small crew must leave"
    },
    {
      "start_seconds": "174.034",
      "end_seconds": "174.754",
      "text": "to find help."
    },
    {
      "start_seconds": "175.155",
      "end_seconds": "176.075",
      "text": "Their destination"
    },
    {
      "start_seconds": "176.176",
      "end_seconds": "177.256",
      "text": "was South Georgia,"
    },
    {
      "start_seconds": "177.617",
      "end_seconds": "179.866",
      "text": "roughly 1,300 kilometres —"
    },
    {
      "start_seconds": "180.49",
      "end_seconds": "181.97",
      "text": "over 800 miles —"
    },
    {
      "start_seconds": "182.023",
      "end_seconds": "182.844",
      "text": "to the northeast,"
    },
    {
      "start_seconds": "183.164",
      "end_seconds": "184.545",
      "text": "across the Scotia Sea."
    },
    {
      "start_seconds": "184.966",
      "end_seconds": "186.187",
      "text": "There were whaling stations"
    },
    {
      "start_seconds": "186.267",
      "end_seconds": "186.847",
      "text": "on the island."
    },
    {
      "start_seconds": "187.308",
      "end_seconds": "188.489",
      "text": "If the men could reach one,"
    },
    {
      "start_seconds": "188.749",
      "end_seconds": "189.429",
      "text": "they could obtain"
    },
    {
      "start_seconds": "189.49",
      "end_seconds": "191.171",
      "text": "help and organise a rescue."
    },
    {
      "start_seconds": "191.651",
      "end_seconds": "192.692",
      "text": "Their only suitable"
    },
    {
      "start_seconds": "192.772",
      "end_seconds": "194.074",
      "text": "vessel was the largest"
    },
    {
      "start_seconds": "194.174",
      "end_seconds": "196.015",
      "text": "lifeboat, the James Caird."
    },
    {
      "start_seconds": "196.436",
      "end_seconds": "197.096",
      "text": "The carpenter,"
    },
    {
      "start_seconds": "197.236",
      "end_seconds": "198.618",
      "text": "Harry McNish, raised"
    },
    {
      "start_seconds": "198.678",
      "end_seconds": "200.43",
      "text": "its sides, fitted a partial"
    },
    {
      "start_seconds": "200.49",
      "end_seconds": "201.963",
      "text": "covering of wood and canvas,"
    },
    {
      "start_seconds": "202.303",
      "end_seconds": "203.184",
      "text": "and worked to make"
    },
    {
      "start_seconds": "203.224",
      "end_seconds": "204.605",
      "text": "the hull more watertight."
    },
    {
      "start_seconds": "205.146",
      "end_seconds": "206.787",
      "text": "Shackleton initially intended"
    },
    {
      "start_seconds": "206.847",
      "end_seconds": "208.108",
      "text": "to leave Thomas Crean"
    },
    {
      "start_seconds": "208.188",
      "end_seconds": "209.87",
      "text": "on Elephant Island to assist"
    },
    {
      "start_seconds": "209.93",
      "end_seconds": "211.051",
      "text": "his second-in-command,"
    },
    {
      "start_seconds": "211.231",
      "end_seconds": "211.992",
      "text": "Frank Wild."
    },
    {
      "start_seconds": "212.332",
      "end_seconds": "213.793",
      "text": "But after discussing the plan,"
    },
    {
      "start_seconds": "214.074",
      "end_seconds": "215.075",
      "text": "he decided to take"
    },
    {
      "start_seconds": "215.175",
      "end_seconds": "216.095",
      "text": "Crean on the ocean"
    },
    {
      "start_seconds": "216.155",
      "end_seconds": "217.076",
      "text": "crossing instead."
    },
    {
      "start_seconds": "217.657",
      "end_seconds": "219.639",
      "text": "On April 24, Shackleton"
    },
    {
      "start_seconds": "219.67",
      "end_seconds": "220.931",
      "text": "departed with Worsley,"
    },
    {
      "start_seconds": "221.162",
      "end_seconds": "222.463",
      "text": "McNish, Crean,"
    },
    {
      "start_seconds": "222.724",
      "end_seconds": "223.684",
      "text": "Timothy McCarthy"
    },
    {
      "start_seconds": "223.925",
      "end_seconds": "224.905",
      "text": "and John Vincent."
    },
    {
      "start_seconds": "225.386",
      "end_seconds": "226.907",
      "text": "Twenty-two men remained"
    },
    {
      "start_seconds": "227.067",
      "end_seconds": "228.268",
      "text": "under Wild's command."
    },
    {
      "start_seconds": "228.869",
      "end_seconds": "230.15",
      "text": "Wild's first challenge"
    },
    {
      "start_seconds": "230.23",
      "end_seconds": "231.371",
      "text": "was finding shelter."
    },
    {
      "start_seconds": "231.852",
      "end_seconds": "232.933",
      "text": "An ice cave offered"
    },
    {
      "start_seconds": "232.993",
      "end_seconds": "234.134",
      "text": "protection from the wind,"
    },
    {
      "start_seconds": "234.434",
      "end_seconds": "235.215",
      "text": "but it was wet"
    },
    {
      "start_seconds": "235.435",
      "end_seconds": "236.876",
      "text": "and unsuitable for living in."
    },
    {
      "start_seconds": "237.357",
      "end_seconds": "238.598",
      "text": "The men abandoned it."
    },
    {
      "start_seconds": "239.078",
      "end_seconds": "240.611",
      "text": "Instead, they built low"
    },
    {
      "start_seconds": "240.711",
      "end_seconds": "242.503",
      "text": "stone walls and used two"
    },
    {
      "start_seconds": "242.703",
      "end_seconds": "243.824",
      "text": "overturned lifeboats,"
    },
    {
      "start_seconds": "244.145",
      "end_seconds": "245.626",
      "text": "canvas and other salvaged"
    },
    {
      "start_seconds": "245.666",
      "end_seconds": "247.187",
      "text": "materials to form a roof."
    },
    {
      "start_seconds": "247.668",
      "end_seconds": "248.929",
      "text": "The shelter was cramped,"
    },
    {
      "start_seconds": "249.189",
      "end_seconds": "249.69",
      "text": "but it gave"
    },
    {
      "start_seconds": "249.73",
      "end_seconds": "250.55",
      "text": "the men somewhere"
    },
    {
      "start_seconds": "250.591",
      "end_seconds": "252.292",
      "text": "to live as winter approached."
    },
    {
      "start_seconds": "252.772",
      "end_seconds": "254.334",
      "text": "While Wild organised life"
    },
    {
      "start_seconds": "254.394",
      "end_seconds": "256.236",
      "text": "inside it, the James Caird"
    },
    {
      "start_seconds": "256.296",
      "end_seconds": "258.237",
      "text": "was already far out at sea."
    },
    {
      "start_seconds": "258.858",
      "end_seconds": "260.05",
      "text": "Finding South Georgia"
    },
    {
      "start_seconds": "260.13",
      "end_seconds": "260.891",
      "text": "required more"
    },
    {
      "start_seconds": "260.942",
      "end_seconds": "262.183",
      "text": "than sailing northeast."
    },
    {
      "start_seconds": "262.623",
      "end_seconds": "263.424",
      "text": "It was a small"
    },
    {
      "start_seconds": "263.644",
      "end_seconds": "265.446",
      "text": "island in an enormous ocean."
    },
    {
      "start_seconds": "265.926",
      "end_seconds": "267.548",
      "text": "If the James Caird passed too"
    },
    {
      "start_seconds": "267.628",
      "end_seconds": "269.47",
      "text": "far to either side, the men"
    },
    {
      "start_seconds": "269.55",
      "end_seconds": "270.851",
      "text": "might miss it entirely."
    },
    {
      "start_seconds": "271.331",
      "end_seconds": "272.632",
      "text": "Worsley had to navigate"
    },
    {
      "start_seconds": "272.692",
      "end_seconds": "273.493",
      "text": "with a sextant,"
    },
    {
      "start_seconds": "273.793",
      "end_seconds": "275.495",
      "text": "a compass and calculations"
    },
    {
      "start_seconds": "275.535",
      "end_seconds": "276.936",
      "text": "of their estimated progress."
    },
    {
      "start_seconds": "277.397",
      "end_seconds": "278.357",
      "text": "He needed the sun"
    },
    {
      "start_seconds": "278.418",
      "end_seconds": "279.65",
      "text": "to determine their position."
    },
    {
      "start_seconds": "280.09",
      "end_seconds": "280.991",
      "text": "But cloud cover,"
    },
    {
      "start_seconds": "281.222",
      "end_seconds": "282.944",
      "text": "heavy seas and the constant"
    },
    {
      "start_seconds": "282.984",
      "end_seconds": "283.845",
      "text": "movement of the boat"
    },
    {
      "start_seconds": "284.085",
      "end_seconds": "285.666",
      "text": "made observations difficult."
    },
    {
      "start_seconds": "286.087",
      "end_seconds": "286.967",
      "text": "During the crossing,"
    },
    {
      "start_seconds": "287.187",
      "end_seconds": "287.728",
      "text": "he obtained"
    },
    {
      "start_seconds": "287.828",
      "end_seconds": "289.81",
      "text": "only four usable observations"
    },
    {
      "start_seconds": "289.85",
      "end_seconds": "290.37",
      "text": "of the sun."
    },
    {
      "start_seconds": "290.791",
      "end_seconds": "291.371",
      "text": "Between them,"
    },
    {
      "start_seconds": "291.611",
      "end_seconds": "292.953",
      "text": "he estimated their position"
    },
    {
      "start_seconds": "293.033",
      "end_seconds": "294.154",
      "text": "from the course steered"
    },
    {
      "start_seconds": "294.294",
      "end_seconds": "295.355",
      "text": "and distance travelled,"
    },
    {
      "start_seconds": "295.675",
      "end_seconds": "296.856",
      "text": "adjusting whenever new"
    },
    {
      "start_seconds": "296.956",
      "end_seconds": "297.797",
      "text": "evidence allowed."
    },
    {
      "start_seconds": "298.257",
      "end_seconds": "299.438",
      "text": "The others kept the boat"
    },
    {
      "start_seconds": "299.51",
      "end_seconds": "300.53",
      "text": "moving and afloat."
    },
    {
      "start_seconds": "300.942",
      "end_seconds": "302.003",
      "text": "They worked in watches,"
    },
    {
      "start_seconds": "302.323",
      "end_seconds": "303.284",
      "text": "handling the sails,"
    },
    {
      "start_seconds": "303.624",
      "end_seconds": "305.206",
      "text": "steering and bailing water."
    },
    {
      "start_seconds": "305.746",
      "end_seconds": "306.687",
      "text": "Ice accumulated"
    },
    {
      "start_seconds": "306.747",
      "end_seconds": "308.248",
      "text": "on the vessel, adding weight"
    },
    {
      "start_seconds": "308.288",
      "end_seconds": "309.53",
      "text": "that had to be removed."
    },
    {
      "start_seconds": "310.05",
      "end_seconds": "311.812",
      "text": "After nearly two weeks at sea,"
    },
    {
      "start_seconds": "312.072",
      "end_seconds": "312.913",
      "text": "they were approaching"
    },
    {
      "start_seconds": "312.953",
      "end_seconds": "314.334",
      "text": "where Worsley calculated"
    },
    {
      "start_seconds": "314.434",
      "end_seconds": "315.675",
      "text": "South Georgia should be."
    },
    {
      "start_seconds": "316.216",
      "end_seconds": "317.657",
      "text": "On May 8, land"
    },
    {
      "start_seconds": "317.697",
      "end_seconds": "318.758",
      "text": "appeared through a break"
    },
    {
      "start_seconds": "318.798",
      "end_seconds": "319.458",
      "text": "in the clouds."
    },
    {
      "start_seconds": "319.93",
      "end_seconds": "321.382",
      "text": "They had found the island."
    },
    {
      "start_seconds": "321.683",
      "end_seconds": "322.744",
      "text": "But heavy seas"
    },
    {
      "start_seconds": "322.844",
      "end_seconds": "324.005",
      "text": "and dangerous surf"
    },
    {
      "start_seconds": "324.145",
      "end_seconds": "324.685",
      "text": "prevented"
    },
    {
      "start_seconds": "324.765",
      "end_seconds": "325.806",
      "text": "an immediate landing."
    },
    {
      "start_seconds": "326.227",
      "end_seconds": "327.348",
      "text": "For two more days,"
    },
    {
      "start_seconds": "327.428",
      "end_seconds": "328.028",
      "text": "they remained"
    },
    {
      "start_seconds": "328.108",
      "end_seconds": "329.409",
      "text": "offshore, searching"
    },
    {
      "start_seconds": "329.49",
      "end_seconds": "330.51",
      "text": "for a safe approach."
    },
    {
      "start_seconds": "331.071",
      "end_seconds": "331.812",
      "text": "On May 10,"
    },
    {
      "start_seconds": "332.132",
      "end_seconds": "333.473",
      "text": "the six men finally"
    },
    {
      "start_seconds": "333.533",
      "end_seconds": "335.155",
      "text": "landed in King Haakon Bay,"
    },
    {
      "start_seconds": "335.455",
      "end_seconds": "336.396",
      "text": "on South Georgia's"
    },
    {
      "start_seconds": "336.476",
      "end_seconds": "337.276",
      "text": "western coast."
    },
    {
      "start_seconds": "337.737",
      "end_seconds": "338.738",
      "text": "The whaling stations"
    },
    {
      "start_seconds": "338.798",
      "end_seconds": "339.47",
      "text": "were on the other"
    },
    {
      "start_seconds": "339.55",
      "end_seconds": "340.41",
      "text": "side of the island."
    },
    {
      "start_seconds": "340.862",
      "end_seconds": "341.963",
      "text": "With the James Caird"
    },
    {
      "start_seconds": "342.003",
      "end_seconds": "342.623",
      "text": "and its crew"
    },
    {
      "start_seconds": "342.683",
      "end_seconds": "344.085",
      "text": "in their exhausted condition,"
    },
    {
      "start_seconds": "344.405",
      "end_seconds": "345.306",
      "text": "attempting to reach"
    },
    {
      "start_seconds": "345.346",
      "end_seconds": "346.667",
      "text": "those stations by sailing"
    },
    {
      "start_seconds": "346.727",
      "end_seconds": "347.528",
      "text": "around the coast"
    },
    {
      "start_seconds": "347.728",
      "end_seconds": "348.749",
      "text": "was too dangerous."
    },
    {
      "start_seconds": "349.289",
      "end_seconds": "350.871",
      "text": "Shackleton decided to cross"
    },
    {
      "start_seconds": "350.931",
      "end_seconds": "352.152",
      "text": "the mountains instead."
    },
    {
      "start_seconds": "352.632",
      "end_seconds": "353.893",
      "text": "McNish, Vincent"
    },
    {
      "start_seconds": "354.014",
      "end_seconds": "354.714",
      "text": "and McCarthy"
    },
    {
      "start_seconds": "354.934",
      "end_seconds": "355.815",
      "text": "remained behind."
    },
    {
      "start_seconds": "356.396",
      "end_seconds": "357.657",
      "text": "Shackleton, Worsley"
    },
    {
      "start_seconds": "357.737",
      "end_seconds": "359.378",
      "text": "and Crean set out on foot"
    },
    {
      "start_seconds": "359.57",
      "end_seconds": "360.53",
      "text": "on May 19."
    },
    {
      "start_seconds": "360.991",
      "end_seconds": "362.103",
      "text": "There was no established"
    },
    {
      "start_seconds": "362.203",
      "end_seconds": "363.224",
      "text": "route through the mountains"
    },
    {
      "start_seconds": "363.304",
      "end_seconds": "363.905",
      "text": "and glaciers."
    },
    {
      "start_seconds": "364.405",
      "end_seconds": "366.407",
      "text": "At one steep icy descent,"
    },
    {
      "start_seconds": "366.707",
      "end_seconds": "368.048",
      "text": "Worsley and Crean held"
    },
    {
      "start_seconds": "368.088",
      "end_seconds": "369.51",
      "text": "the rope while Shackleton"
    },
    {
      "start_seconds": "369.61",
      "end_seconds": "370.951",
      "text": "used a carpenter's adze"
    },
    {
      "start_seconds": "371.011",
      "end_seconds": "372.532",
      "text": "to cut steps into the ice."
    },
    {
      "start_seconds": "372.993",
      "end_seconds": "373.934",
      "text": "Descending roughly"
    },
    {
      "start_seconds": "374.094",
      "end_seconds": "375.475",
      "text": "five hundred feet took"
    },
    {
      "start_seconds": "375.515",
      "end_seconds": "376.696",
      "text": "them about two hours."
    },
    {
      "start_seconds": "377.196",
      "end_seconds": "378.498",
      "text": "Then the three continued"
    },
    {
      "start_seconds": "378.558",
      "end_seconds": "380.17",
      "text": "across snowfields and ridges,"
    },
    {
      "start_seconds": "380.55",
      "end_seconds": "381.743",
      "text": "searching for a passage"
    },
    {
      "start_seconds": "381.823",
      "end_seconds": "383.204",
      "text": "toward the inhabited coast."
    },
    {
      "start_seconds": "383.704",
      "end_seconds": "384.585",
      "text": "On May 20,"
    },
    {
      "start_seconds": "384.905",
      "end_seconds": "385.846",
      "text": "after approximately"
    },
    {
      "start_seconds": "385.986",
      "end_seconds": "387.708",
      "text": "thirty-six hours of travelling,"
    },
    {
      "start_seconds": "387.948",
      "end_seconds": "388.949",
      "text": "they reached the whaling"
    },
    {
      "start_seconds": "389.009",
      "end_seconds": "390.25",
      "text": "station at Stromness."
    },
    {
      "start_seconds": "390.731",
      "end_seconds": "391.752",
      "text": "The three men left"
    },
    {
      "start_seconds": "391.852",
      "end_seconds": "392.772",
      "text": "on South Georgia's"
    },
    {
      "start_seconds": "392.833",
      "end_seconds": "393.633",
      "text": "western shore"
    },
    {
      "start_seconds": "393.853",
      "end_seconds": "394.734",
      "text": "were subsequently"
    },
    {
      "start_seconds": "394.794",
      "end_seconds": "395.655",
      "text": "brought to safety."
    },
    {
      "start_seconds": "396.095",
      "end_seconds": "396.956",
      "text": "But no news"
    },
    {
      "start_seconds": "397.016",
      "end_seconds": "398.518",
      "text": "of any of this had reached"
    },
    {
      "start_seconds": "398.658",
      "end_seconds": "399.358",
      "text": "Elephant Island."
    },
    {
      "start_seconds": "399.91",
      "end_seconds": "400.931",
      "text": "Wild and the other"
    },
    {
      "start_seconds": "401.022",
      "end_seconds": "401.883",
      "text": "twenty-one men"
    },
    {
      "start_seconds": "402.103",
      "end_seconds": "403.104",
      "text": "were still waiting."
    },
    {
      "start_seconds": "403.664",
      "end_seconds": "404.725",
      "text": "Inside their shelter,"
    },
    {
      "start_seconds": "404.925",
      "end_seconds": "406.107",
      "text": "they maintained a daily"
    },
    {
      "start_seconds": "406.167",
      "end_seconds": "407.728",
      "text": "routine, gathered food"
    },
    {
      "start_seconds": "407.788",
      "end_seconds": "409.269",
      "text": "when they could and endured"
    },
    {
      "start_seconds": "409.309",
      "end_seconds": "410.47",
      "text": "the Antarctic winter"
    },
    {
      "start_seconds": "410.55",
      "end_seconds": "411.591",
      "text": "without knowing whether"
    },
    {
      "start_seconds": "411.631",
      "end_seconds": "413.113",
      "text": "the James Caird had reached"
    },
    {
      "start_seconds": "413.173",
      "end_seconds": "414.014",
      "text": "its destination."
    },
    {
      "start_seconds": "414.514",
      "end_seconds": "415.215",
      "text": "Wild kept"
    },
    {
      "start_seconds": "415.255",
      "end_seconds": "416.296",
      "text": "the group organised."
    },
    {
      "start_seconds": "416.736",
      "end_seconds": "417.797",
      "text": "Each day, he rolled"
    },
    {
      "start_seconds": "417.857",
      "end_seconds": "419.198",
      "text": "up his own sleeping bag,"
    },
    {
      "start_seconds": "419.45",
      "end_seconds": "420.711",
      "text": "repeating that Shackleton"
    },
    {
      "start_seconds": "420.842",
      "end_seconds": "422.063",
      "text": "might arrive that day."
    },
    {
      "start_seconds": "422.523",
      "end_seconds": "423.584",
      "text": "The others continued"
    },
    {
      "start_seconds": "423.624",
      "end_seconds": "424.685",
      "text": "the work of maintaining"
    },
    {
      "start_seconds": "424.725",
      "end_seconds": "426.267",
      "text": "the camp and finding food."
    },
    {
      "start_seconds": "426.767",
      "end_seconds": "428.789",
      "text": "Days passed. Then weeks."
    },
    {
      "start_seconds": "429.409",
      "end_seconds": "430.771",
      "text": "Shackleton's first rescue"
    },
    {
      "start_seconds": "430.811",
      "end_seconds": "432.132",
      "text": "attempt, aboard the whaling"
    },
    {
      "start_seconds": "432.172",
      "end_seconds": "433.313",
      "text": "ship Southern Sky,"
    },
    {
      "start_seconds": "433.553",
      "end_seconds": "434.954",
      "text": "was stopped by pack ice."
    },
    {
      "start_seconds": "435.395",
      "end_seconds": "436.196",
      "text": "The next attempt,"
    },
    {
      "start_seconds": "436.496",
      "end_seconds": "437.857",
      "text": "using the Uruguayan vessel"
    },
    {
      "start_seconds": "438.037",
      "end_seconds": "439.85",
      "text": "Instituto de Pesca No. 1,"
    },
    {
      "start_seconds": "440.09",
      "end_seconds": "441.051",
      "text": "and a later voyage"
    },
    {
      "start_seconds": "441.082",
      "end_seconds": "441.863",
      "text": "aboard the schooner"
    },
    {
      "start_seconds": "442.023",
      "end_seconds": "443.344",
      "text": "Emma also failed"
    },
    {
      "start_seconds": "443.384",
      "end_seconds": "444.645",
      "text": "to reach Elephant Island."
    },
    {
      "start_seconds": "445.226",
      "end_seconds": "446.687",
      "text": "Three attempts had failed,"
    },
    {
      "start_seconds": "446.987",
      "end_seconds": "448.108",
      "text": "and the men on the island"
    },
    {
      "start_seconds": "448.248",
      "end_seconds": "449.59",
      "text": "still had no news."
    },
    {
      "start_seconds": "450.13",
      "end_seconds": "451.852",
      "text": "As winter continued, food"
    },
    {
      "start_seconds": "451.912",
      "end_seconds": "453.493",
      "text": "became increasingly scarce."
    },
    {
      "start_seconds": "453.934",
      "end_seconds": "455.375",
      "text": "By late August, the men"
    },
    {
      "start_seconds": "455.415",
      "end_seconds": "456.676",
      "text": "were using what remained"
    },
    {
      "start_seconds": "456.896",
      "end_seconds": "457.957",
      "text": "and gathering limpets"
    },
    {
      "start_seconds": "458.017",
      "end_seconds": "459.398",
      "text": "and seaweed along the shore."
    },
    {
      "start_seconds": "459.95",
      "end_seconds": "460.991",
      "text": "Shackleton secured"
    },
    {
      "start_seconds": "461.002",
      "end_seconds": "462.303",
      "text": "a fourth opportunity."
    },
    {
      "start_seconds": "462.744",
      "end_seconds": "463.804",
      "text": "The Chilean government"
    },
    {
      "start_seconds": "463.865",
      "end_seconds": "465.666",
      "text": "provided Yelcho, a small"
    },
    {
      "start_seconds": "465.746",
      "end_seconds": "466.867",
      "text": "steam tug commanded"
    },
    {
      "start_seconds": "466.927",
      "end_seconds": "468.889",
      "text": "by naval officer Luis Pardo."
    },
    {
      "start_seconds": "469.309",
      "end_seconds": "470.631",
      "text": "It was not an icebreaker."
    },
    {
      "start_seconds": "471.031",
      "end_seconds": "472.252",
      "text": "The ship could not force"
    },
    {
      "start_seconds": "472.312",
      "end_seconds": "473.493",
      "text": "its way through a solid"
    },
    {
      "start_seconds": "473.553",
      "end_seconds": "474.694",
      "text": "barrier of pack ice."
    },
    {
      "start_seconds": "475.235",
      "end_seconds": "476.396",
      "text": "On August 25,"
    },
    {
      "start_seconds": "476.716",
      "end_seconds": "477.637",
      "text": "Yelcho departed"
    },
    {
      "start_seconds": "477.797",
      "end_seconds": "478.958",
      "text": "with Shackleton aboard."
    },
    {
      "start_seconds": "479.269",
      "end_seconds": "480.09",
      "text": "As the pack ice"
    },
    {
      "start_seconds": "480.19",
      "end_seconds": "481.623",
      "text": "shifted toward the northeast,"
    },
    {
      "start_seconds": "482.003",
      "end_seconds": "482.884",
      "text": "Shackleton chose"
    },
    {
      "start_seconds": "482.924",
      "end_seconds": "484.405",
      "text": "to approach Elephant Island"
    },
    {
      "start_seconds": "484.505",
      "end_seconds": "485.486",
      "text": "from the northwest."
    },
    {
      "start_seconds": "485.966",
      "end_seconds": "487.308",
      "text": "Pardo then had to bring"
    },
    {
      "start_seconds": "487.348",
      "end_seconds": "488.369",
      "text": "the vessel safely"
    },
    {
      "start_seconds": "488.409",
      "end_seconds": "489.189",
      "text": "through the waters"
    },
    {
      "start_seconds": "489.269",
      "end_seconds": "490.01",
      "text": "near the island."
    },
    {
      "start_seconds": "490.49",
      "end_seconds": "492.212",
      "text": "In fog, he navigated"
    },
    {
      "start_seconds": "492.272",
      "end_seconds": "493.633",
      "text": "among numerous grounded"
    },
    {
      "start_seconds": "493.773",
      "end_seconds": "495.595",
      "text": "icebergs, guiding the small"
    },
    {
      "start_seconds": "495.675",
      "end_seconds": "496.816",
      "text": "tug toward the camp."
    },
    {
      "start_seconds": "497.437",
      "end_seconds": "499.378",
      "text": "On August 30, Yelcho"
    },
    {
      "start_seconds": "499.47",
      "end_seconds": "500.711",
      "text": "reached Elephant Island."
    },
    {
      "start_seconds": "501.202",
      "end_seconds": "501.963",
      "text": "The men ashore"
    },
    {
      "start_seconds": "502.043",
      "end_seconds": "502.623",
      "text": "were preparing"
    },
    {
      "start_seconds": "502.784",
      "end_seconds": "504.385",
      "text": "food when a cry announced"
    },
    {
      "start_seconds": "504.425",
      "end_seconds": "505.366",
      "text": "the approaching ship."
    },
    {
      "start_seconds": "505.866",
      "end_seconds": "508.008",
      "text": "At first, the words “Ship O!”"
    },
    {
      "start_seconds": "508.349",
      "end_seconds": "510.41",
      "text": "were mistaken for “Lunch O!”"
    },
    {
      "start_seconds": "510.971",
      "end_seconds": "513.033",
      "text": "Then the men saw the vessel."
    },
    {
      "start_seconds": "513.573",
      "end_seconds": "514.674",
      "text": "After more than four"
    },
    {
      "start_seconds": "514.834",
      "end_seconds": "516.896",
      "text": "months of isolation, a ship"
    },
    {
      "start_seconds": "517.016",
      "end_seconds": "518.157",
      "text": "had reached their shore."
    },
    {
      "start_seconds": "518.618",
      "end_seconds": "520.13",
      "text": "Pardo brought Yelcho close"
    },
    {
      "start_seconds": "520.17",
      "end_seconds": "521.451",
      "text": "enough for the evacuation"
    },
    {
      "start_seconds": "521.502",
      "end_seconds": "522.003",
      "text": "to begin."
    },
    {
      "start_seconds": "522.523",
      "end_seconds": "523.684",
      "text": "All twenty-two men"
    },
    {
      "start_seconds": "523.744",
      "end_seconds": "524.485",
      "text": "who had remained"
    },
    {
      "start_seconds": "524.565",
      "end_seconds": "525.506",
      "text": "on Elephant Island"
    },
    {
      "start_seconds": "525.686",
      "end_seconds": "526.607",
      "text": "were taken aboard."
    },
    {
      "start_seconds": "527.147",
      "end_seconds": "529.069",
      "text": "Every one of them was alive."
    },
    {
      "start_seconds": "529.71",
      "end_seconds": "530.971",
      "text": "The wider Imperial"
    },
    {
      "start_seconds": "531.051",
      "end_seconds": "532.712",
      "text": "Trans-Antarctic Expedition"
    },
    {
      "start_seconds": "533.013",
      "end_seconds": "534.134",
      "text": "had a different outcome."
    },
    {
      "start_seconds": "534.654",
      "end_seconds": "535.335",
      "text": "On the opposite"
    },
    {
      "start_seconds": "535.395",
      "end_seconds": "536.396",
      "text": "side of Antarctica,"
    },
    {
      "start_seconds": "536.676",
      "end_seconds": "538.297",
      "text": "the separate Ross Sea Party"
    },
    {
      "start_seconds": "538.377",
      "end_seconds": "539.559",
      "text": "suffered its own ordeal,"
    },
    {
      "start_seconds": "539.93",
      "end_seconds": "541.322",
      "text": "and three men died."
    },
    {
      "start_seconds": "541.843",
      "end_seconds": "542.343",
      "text": "The planned"
    },
    {
      "start_seconds": "542.423",
      "end_seconds": "543.685",
      "text": "crossing of Antarctica"
    },
    {
      "start_seconds": "543.945",
      "end_seconds": "545.066",
      "text": "was never completed."
    },
    {
      "start_seconds": "545.526",
      "end_seconds": "546.708",
      "text": "But the twenty-two men"
    },
    {
      "start_seconds": "546.808",
      "end_seconds": "547.228",
      "text": "rescued"
    },
    {
      "start_seconds": "547.268",
      "end_seconds": "548.269",
      "text": "from Elephant Island,"
    },
    {
      "start_seconds": "548.549",
      "end_seconds": "549.63",
      "text": "together with the six"
    },
    {
      "start_seconds": "549.67",
      "end_seconds": "550.751",
      "text": "who had sailed for help,"
    },
    {
      "start_seconds": "551.072",
      "end_seconds": "552.633",
      "text": "accounted for every member"
    },
    {
      "start_seconds": "552.693",
      "end_seconds": "553.834",
      "text": "of the Endurance party."
    },
    {
      "start_seconds": "554.335",
      "end_seconds": "556.156",
      "text": "The expedition lost its ship."
    },
    {
      "start_seconds": "556.757",
      "end_seconds": "557.958",
      "text": "All twenty-eight men"
    },
    {
      "start_seconds": "558.319",
      "end_seconds": "559.56",
      "text": "came home alive."
    }
  ]
}
