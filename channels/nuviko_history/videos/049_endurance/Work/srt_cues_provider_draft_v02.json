{
  "cues": [
    {
      "start_seconds": "0.0",
      "end_seconds": "2.64",
      "text": "On November 21, 1915,"
    },
    {
      "start_seconds": "3.04",
      "end_seconds": "4.64",
      "text": "a ship called Endurance"
    },
    {
      "start_seconds": "4.8",
      "end_seconds": "6.16",
      "text": "sank in the Weddell Sea,"
    },
    {
      "start_seconds": "6.4",
      "end_seconds": "7.2",
      "text": "near Antarctica."
    },
    {
      "start_seconds": "7.68",
      "end_seconds": "8.96",
      "text": "All twenty-eight men"
    },
    {
      "start_seconds": "9.0",
      "end_seconds": "9.92",
      "text": "of her expedition"
    },
    {
      "start_seconds": "10.08",
      "end_seconds": "11.2",
      "text": "were still alive."
    },
    {
      "start_seconds": "11.6",
      "end_seconds": "12.72",
      "text": "But they had no ship,"
    },
    {
      "start_seconds": "13.12",
      "end_seconds": "14.88",
      "text": "no radio, and no way"
    },
    {
      "start_seconds": "14.96",
      "end_seconds": "16.32",
      "text": "to tell the outside world"
    },
    {
      "start_seconds": "16.44",
      "end_seconds": "17.04",
      "text": "where they were."
    },
    {
      "start_seconds": "17.6",
      "end_seconds": "18.48",
      "text": "They were stranded"
    },
    {
      "start_seconds": "18.6",
      "end_seconds": "19.92",
      "text": "on drifting sea ice,"
    },
    {
      "start_seconds": "20.2",
      "end_seconds": "21.92",
      "text": "with three small lifeboats"
    },
    {
      "start_seconds": "22.0",
      "end_seconds": "23.12",
      "text": "and whatever supplies"
    },
    {
      "start_seconds": "23.2",
      "end_seconds": "24.48",
      "text": "they had managed to save."
    },
    {
      "start_seconds": "24.96",
      "end_seconds": "26.16",
      "text": "To get everyone home,"
    },
    {
      "start_seconds": "26.56",
      "end_seconds": "27.92",
      "text": "six men would eventually"
    },
    {
      "start_seconds": "28.0",
      "end_seconds": "28.8",
      "text": "have to cross more"
    },
    {
      "start_seconds": "28.88",
      "end_seconds": "30.4",
      "text": "than eight hundred miles"
    },
    {
      "start_seconds": "30.52",
      "end_seconds": "32.88",
      "text": "of open ocean in a boat barely"
    },
    {
      "start_seconds": "32.96",
      "end_seconds": "34.08",
      "text": "seven metres long."
    },
    {
      "start_seconds": "34.64",
      "end_seconds": "35.76",
      "text": "The other twenty-two"
    },
    {
      "start_seconds": "35.84",
      "end_seconds": "36.56",
      "text": "would have to wait,"
    },
    {
      "start_seconds": "36.96",
      "end_seconds": "38.08",
      "text": "without knowing whether"
    },
    {
      "start_seconds": "38.24",
      "end_seconds": "39.68",
      "text": "those six had survived."
    },
    {
      "start_seconds": "40.2",
      "end_seconds": "41.28",
      "text": "And even if the boat"
    },
    {
      "start_seconds": "41.36",
      "end_seconds": "42.8",
      "text": "reached help, someone"
    },
    {
      "start_seconds": "42.88",
      "end_seconds": "44.56",
      "text": "would still have to find a way"
    },
    {
      "start_seconds": "44.72",
      "end_seconds": "45.68",
      "text": "back through the ice."
    },
    {
      "start_seconds": "46.56",
      "end_seconds": "49.12",
      "text": "In 1914, Ernest Shackleton"
    },
    {
      "start_seconds": "49.2",
      "end_seconds": "50.56",
      "text": "set out to lead the first"
    },
    {
      "start_seconds": "50.64",
      "end_seconds": "52.4",
      "text": "expedition across Antarctica,"
    },
    {
      "start_seconds": "52.72",
      "end_seconds": "53.92",
      "text": "travelling from one coast"
    },
    {
      "start_seconds": "53.96",
      "end_seconds": "55.04",
      "text": "to the other by way"
    },
    {
      "start_seconds": "55.08",
      "end_seconds": "56.08",
      "text": "of the South Pole."
    },
    {
      "start_seconds": "56.56",
      "end_seconds": "57.12",
      "text": "His ship,"
    },
    {
      "start_seconds": "57.48",
      "end_seconds": "58.8",
      "text": "Endurance, was supposed"
    },
    {
      "start_seconds": "58.88",
      "end_seconds": "60.08",
      "text": "to carry the expedition"
    },
    {
      "start_seconds": "60.16",
      "end_seconds": "61.28",
      "text": "into the Weddell Sea,"
    },
    {
      "start_seconds": "61.56",
      "end_seconds": "62.24",
      "text": "where the crossing"
    },
    {
      "start_seconds": "62.32",
      "end_seconds": "62.88",
      "text": "would begin."
    },
    {
      "start_seconds": "63.36",
      "end_seconds": "65.44",
      "text": "But in January 1915,"
    },
    {
      "start_seconds": "65.76",
      "end_seconds": "66.8",
      "text": "moving pack ice"
    },
    {
      "start_seconds": "66.96",
      "end_seconds": "68.24",
      "text": "closed around the vessel."
    },
    {
      "start_seconds": "68.72",
      "end_seconds": "69.44",
      "text": "For months,"
    },
    {
      "start_seconds": "69.68",
      "end_seconds": "70.96",
      "text": "Captain Frank Worsley"
    },
    {
      "start_seconds": "71.04",
      "end_seconds": "72.08",
      "text": "tracked their position"
    },
    {
      "start_seconds": "72.24",
      "end_seconds": "73.36",
      "text": "while the crew maintained"
    },
    {
      "start_seconds": "73.44",
      "end_seconds": "74.56",
      "text": "the ship and waited"
    },
    {
      "start_seconds": "74.64",
      "end_seconds": "75.84",
      "text": "for a chance to escape."
    },
    {
      "start_seconds": "76.32",
      "end_seconds": "77.52",
      "text": "The sea ice moved"
    },
    {
      "start_seconds": "77.6",
      "end_seconds": "78.96",
      "text": "with the winds and currents."
    },
    {
      "start_seconds": "79.36",
      "end_seconds": "80.48",
      "text": "Instead of carrying them"
    },
    {
      "start_seconds": "80.52",
      "end_seconds": "81.84",
      "text": "toward their destination,"
    },
    {
      "start_seconds": "82.16",
      "end_seconds": "83.36",
      "text": "it took the trapped ship"
    },
    {
      "start_seconds": "83.52",
      "end_seconds": "84.64",
      "text": "wherever it drifted."
    },
    {
      "start_seconds": "85.2",
      "end_seconds": "86.48",
      "text": "Then, in October,"
    },
    {
      "start_seconds": "86.8",
      "end_seconds": "87.36",
      "text": "the pressure"
    },
    {
      "start_seconds": "87.44",
      "end_seconds": "88.48",
      "text": "became too great."
    },
    {
      "start_seconds": "88.8",
      "end_seconds": "90.08",
      "text": "The wooden hull began"
    },
    {
      "start_seconds": "90.16",
      "end_seconds": "90.88",
      "text": "to give way."
    },
    {
      "start_seconds": "91.28",
      "end_seconds": "92.16",
      "text": "Water entered,"
    },
    {
      "start_seconds": "92.48",
      "end_seconds": "93.92",
      "text": "and on October 27,"
    },
    {
      "start_seconds": "94.24",
      "end_seconds": "95.6",
      "text": "Shackleton ordered the men"
    },
    {
      "start_seconds": "95.68",
      "end_seconds": "96.8",
      "text": "to abandon ship."
    },
    {
      "start_seconds": "97.28",
      "end_seconds": "98.88",
      "text": "They carried three lifeboats,"
    },
    {
      "start_seconds": "99.12",
      "end_seconds": "100.48",
      "text": "provisions and equipment"
    },
    {
      "start_seconds": "100.64",
      "end_seconds": "102.0",
      "text": "onto the surrounding ice."
    },
    {
      "start_seconds": "102.48",
      "end_seconds": "103.84",
      "text": "On November 21,"
    },
    {
      "start_seconds": "104.24",
      "end_seconds": "105.6",
      "text": "Endurance sank."
    },
    {
      "start_seconds": "106.08",
      "end_seconds": "106.88",
      "text": "The expedition"
    },
    {
      "start_seconds": "106.96",
      "end_seconds": "107.92",
      "text": "had never reached"
    },
    {
      "start_seconds": "108.0",
      "end_seconds": "108.8",
      "text": "its starting point"
    },
    {
      "start_seconds": "108.88",
      "end_seconds": "110.16",
      "text": "on the Antarctic continent."
    },
    {
      "start_seconds": "110.72",
      "end_seconds": "112.48",
      "text": "Now the men had to find"
    },
    {
      "start_seconds": "112.64",
      "end_seconds": "113.68",
      "text": "another way home."
    },
    {
      "start_seconds": "114.72",
      "end_seconds": "116.0",
      "text": "Shackleton first tried"
    },
    {
      "start_seconds": "116.08",
      "end_seconds": "117.76",
      "text": "moving toward land on foot."
    },
    {
      "start_seconds": "118.08",
      "end_seconds": "119.68",
      "text": "But hauling heavy lifeboats"
    },
    {
      "start_seconds": "119.76",
      "end_seconds": "120.8",
      "text": "across broken ice"
    },
    {
      "start_seconds": "120.96",
      "end_seconds": "122.48",
      "text": "proved almost impossible."
    },
    {
      "start_seconds": "122.96",
      "end_seconds": "124.48",
      "text": "Ridges blocked their path,"
    },
    {
      "start_seconds": "124.8",
      "end_seconds": "126.24",
      "text": "cracks forced detours,"
    },
    {
      "start_seconds": "126.52",
      "end_seconds": "127.04",
      "text": "and the men"
    },
    {
      "start_seconds": "127.12",
      "end_seconds": "128.32",
      "text": "made little progress."
    },
    {
      "start_seconds": "128.8",
      "end_seconds": "130.08",
      "text": "They abandoned the march"
    },
    {
      "start_seconds": "130.16",
      "end_seconds": "131.36",
      "text": "and established a camp"
    },
    {
      "start_seconds": "131.4",
      "end_seconds": "132.48",
      "text": "on a drifting floe."
    },
    {
      "start_seconds": "132.96",
      "end_seconds": "133.76",
      "text": "For months,"
    },
    {
      "start_seconds": "134.0",
      "end_seconds": "135.36",
      "text": "they waited as the current"
    },
    {
      "start_seconds": "135.44",
      "end_seconds": "136.32",
      "text": "carried them north."
    },
    {
      "start_seconds": "136.72",
      "end_seconds": "137.92",
      "text": "They rationed their food,"
    },
    {
      "start_seconds": "138.2",
      "end_seconds": "139.84",
      "text": "hunted seals and penguins,"
    },
    {
      "start_seconds": "140.08",
      "end_seconds": "141.52",
      "text": "and kept the lifeboats ready."
    },
    {
      "start_seconds": "142.08",
      "end_seconds": "143.92",
      "text": "In April 1916,"
    },
    {
      "start_seconds": "144.16",
      "end_seconds": "145.2",
      "text": "the ice beneath them"
    },
    {
      "start_seconds": "145.28",
      "end_seconds": "146.56",
      "text": "began breaking apart."
    },
    {
      "start_seconds": "146.96",
      "end_seconds": "148.64",
      "text": "On April 9, they launched"
    },
    {
      "start_seconds": "148.72",
      "end_seconds": "150.0",
      "text": "their boats into the water."
    },
    {
      "start_seconds": "150.48",
      "end_seconds": "151.68",
      "text": "For nearly a week,"
    },
    {
      "start_seconds": "151.76",
      "end_seconds": "153.44",
      "text": "the crews rowed and sailed"
    },
    {
      "start_seconds": "153.64",
      "end_seconds": "154.96",
      "text": "between moving floes,"
    },
    {
      "start_seconds": "155.12",
      "end_seconds": "156.16",
      "text": "struggling to reach"
    },
    {
      "start_seconds": "156.24",
      "end_seconds": "157.12",
      "text": "Elephant Island."
    },
    {
      "start_seconds": "157.6",
      "end_seconds": "158.64",
      "text": "On April 15,"
    },
    {
      "start_seconds": "158.96",
      "end_seconds": "160.4",
      "text": "all twenty-eight men"
    },
    {
      "start_seconds": "160.48",
      "end_seconds": "161.44",
      "text": "finally landed."
    },
    {
      "start_seconds": "161.68",
      "end_seconds": "162.56",
      "text": "They had reached"
    },
    {
      "start_seconds": "162.72",
      "end_seconds": "163.44",
      "text": "solid ground,"
    },
    {
      "start_seconds": "163.84",
      "end_seconds": "164.96",
      "text": "but Elephant Island"
    },
    {
      "start_seconds": "165.08",
      "end_seconds": "166.72",
      "text": "was uninhabited and far"
    },
    {
      "start_seconds": "166.8",
      "end_seconds": "168.08",
      "text": "from normal shipping routes."
    },
    {
      "start_seconds": "168.56",
      "end_seconds": "169.92",
      "text": "No rescue ship knew"
    },
    {
      "start_seconds": "170.0",
      "end_seconds": "170.56",
      "text": "they were there."
    },
    {
      "start_seconds": "171.2",
      "end_seconds": "172.24",
      "text": "Shackleton decided"
    },
    {
      "start_seconds": "172.28",
      "end_seconds": "174.08",
      "text": "that a small crew must leave"
    },
    {
      "start_seconds": "174.16",
      "end_seconds": "174.8",
      "text": "to find help."
    },
    {
      "start_seconds": "175.28",
      "end_seconds": "176.16",
      "text": "Their destination"
    },
    {
      "start_seconds": "176.24",
      "end_seconds": "177.28",
      "text": "was South Georgia,"
    },
    {
      "start_seconds": "177.68",
      "end_seconds": "180.613",
      "text": "roughly 1,300 kilometres —"
    },
    {
      "start_seconds": "180.747",
      "end_seconds": "182.107",
      "text": "over 800 miles —"
    },
    {
      "start_seconds": "182.133",
      "end_seconds": "182.96",
      "text": "to the northeast,"
    },
    {
      "start_seconds": "183.24",
      "end_seconds": "184.64",
      "text": "across the Scotia Sea."
    },
    {
      "start_seconds": "185.08",
      "end_seconds": "186.24",
      "text": "There were whaling stations"
    },
    {
      "start_seconds": "186.32",
      "end_seconds": "186.96",
      "text": "on the island."
    },
    {
      "start_seconds": "187.36",
      "end_seconds": "188.56",
      "text": "If the men could reach one,"
    },
    {
      "start_seconds": "188.84",
      "end_seconds": "189.44",
      "text": "they could obtain"
    },
    {
      "start_seconds": "189.52",
      "end_seconds": "191.28",
      "text": "help and organise a rescue."
    },
    {
      "start_seconds": "191.8",
      "end_seconds": "192.72",
      "text": "Their only suitable"
    },
    {
      "start_seconds": "192.8",
      "end_seconds": "194.16",
      "text": "vessel was the largest"
    },
    {
      "start_seconds": "194.24",
      "end_seconds": "196.08",
      "text": "lifeboat, the James Caird."
    },
    {
      "start_seconds": "196.52",
      "end_seconds": "197.12",
      "text": "The carpenter,"
    },
    {
      "start_seconds": "197.44",
      "end_seconds": "198.64",
      "text": "Harry McNish, raised"
    },
    {
      "start_seconds": "198.72",
      "end_seconds": "200.48",
      "text": "its sides, fitted a partial"
    },
    {
      "start_seconds": "200.56",
      "end_seconds": "202.08",
      "text": "covering of wood and canvas,"
    },
    {
      "start_seconds": "202.4",
      "end_seconds": "203.28",
      "text": "and worked to make"
    },
    {
      "start_seconds": "203.32",
      "end_seconds": "204.72",
      "text": "the hull more watertight."
    },
    {
      "start_seconds": "205.2",
      "end_seconds": "206.88",
      "text": "Shackleton initially intended"
    },
    {
      "start_seconds": "206.96",
      "end_seconds": "208.16",
      "text": "to leave Thomas Crean"
    },
    {
      "start_seconds": "208.24",
      "end_seconds": "209.92",
      "text": "on Elephant Island to assist"
    },
    {
      "start_seconds": "210.04",
      "end_seconds": "211.12",
      "text": "his second-in-command,"
    },
    {
      "start_seconds": "211.44",
      "end_seconds": "212.08",
      "text": "Frank Wild."
    },
    {
      "start_seconds": "212.44",
      "end_seconds": "213.84",
      "text": "But after discussing the plan,"
    },
    {
      "start_seconds": "214.16",
      "end_seconds": "215.12",
      "text": "he decided to take"
    },
    {
      "start_seconds": "215.2",
      "end_seconds": "216.08",
      "text": "Crean on the ocean"
    },
    {
      "start_seconds": "216.24",
      "end_seconds": "217.2",
      "text": "crossing instead."
    },
    {
      "start_seconds": "217.68",
      "end_seconds": "219.68",
      "text": "On April 24, Shackleton"
    },
    {
      "start_seconds": "219.88",
      "end_seconds": "220.96",
      "text": "departed with Worsley,"
    },
    {
      "start_seconds": "221.32",
      "end_seconds": "222.56",
      "text": "McNish, Crean,"
    },
    {
      "start_seconds": "222.88",
      "end_seconds": "223.92",
      "text": "Timothy McCarthy"
    },
    {
      "start_seconds": "224.04",
      "end_seconds": "225.04",
      "text": "and John Vincent."
    },
    {
      "start_seconds": "225.6",
      "end_seconds": "227.04",
      "text": "Twenty-two men remained"
    },
    {
      "start_seconds": "227.12",
      "end_seconds": "228.32",
      "text": "under Wild's command."
    },
    {
      "start_seconds": "228.96",
      "end_seconds": "230.24",
      "text": "Wild's first challenge"
    },
    {
      "start_seconds": "230.36",
      "end_seconds": "231.44",
      "text": "was finding shelter."
    },
    {
      "start_seconds": "231.92",
      "end_seconds": "233.04",
      "text": "An ice cave offered"
    },
    {
      "start_seconds": "233.12",
      "end_seconds": "234.24",
      "text": "protection from the wind,"
    },
    {
      "start_seconds": "234.52",
      "end_seconds": "235.44",
      "text": "but it was wet"
    },
    {
      "start_seconds": "235.52",
      "end_seconds": "236.96",
      "text": "and unsuitable for living in."
    },
    {
      "start_seconds": "237.44",
      "end_seconds": "238.64",
      "text": "The men abandoned it."
    },
    {
      "start_seconds": "239.12",
      "end_seconds": "240.64",
      "text": "Instead, they built low"
    },
    {
      "start_seconds": "240.8",
      "end_seconds": "242.56",
      "text": "stone walls and used two"
    },
    {
      "start_seconds": "242.72",
      "end_seconds": "243.92",
      "text": "overturned lifeboats,"
    },
    {
      "start_seconds": "244.24",
      "end_seconds": "245.68",
      "text": "canvas and other salvaged"
    },
    {
      "start_seconds": "246.0",
      "end_seconds": "247.36",
      "text": "materials to form a roof."
    },
    {
      "start_seconds": "247.76",
      "end_seconds": "249.04",
      "text": "The shelter was cramped,"
    },
    {
      "start_seconds": "249.32",
      "end_seconds": "249.76",
      "text": "but it gave"
    },
    {
      "start_seconds": "249.8",
      "end_seconds": "250.64",
      "text": "the men somewhere"
    },
    {
      "start_seconds": "250.72",
      "end_seconds": "252.4",
      "text": "to live as winter approached."
    },
    {
      "start_seconds": "252.92",
      "end_seconds": "254.4",
      "text": "While Wild organised life"
    },
    {
      "start_seconds": "254.48",
      "end_seconds": "256.32",
      "text": "inside it, the James Caird"
    },
    {
      "start_seconds": "256.44",
      "end_seconds": "258.32",
      "text": "was already far out at sea."
    },
    {
      "start_seconds": "259.08",
      "end_seconds": "260.16",
      "text": "Finding South Georgia"
    },
    {
      "start_seconds": "260.4",
      "end_seconds": "260.96",
      "text": "required more"
    },
    {
      "start_seconds": "261.04",
      "end_seconds": "262.32",
      "text": "than sailing northeast."
    },
    {
      "start_seconds": "262.72",
      "end_seconds": "263.52",
      "text": "It was a small"
    },
    {
      "start_seconds": "263.68",
      "end_seconds": "265.6",
      "text": "island in an enormous ocean."
    },
    {
      "start_seconds": "266.0",
      "end_seconds": "267.6",
      "text": "If the James Caird passed too"
    },
    {
      "start_seconds": "267.76",
      "end_seconds": "269.52",
      "text": "far to either side, the men"
    },
    {
      "start_seconds": "269.6",
      "end_seconds": "270.96",
      "text": "might miss it entirely."
    },
    {
      "start_seconds": "271.4",
      "end_seconds": "272.72",
      "text": "Worsley had to navigate"
    },
    {
      "start_seconds": "272.8",
      "end_seconds": "273.6",
      "text": "with a sextant,"
    },
    {
      "start_seconds": "273.84",
      "end_seconds": "275.52",
      "text": "a compass and calculations"
    },
    {
      "start_seconds": "275.6",
      "end_seconds": "277.04",
      "text": "of their estimated progress."
    },
    {
      "start_seconds": "277.52",
      "end_seconds": "278.48",
      "text": "He needed the sun"
    },
    {
      "start_seconds": "278.52",
      "end_seconds": "280.16",
      "text": "to determine their position."
    },
    {
      "start_seconds": "280.267",
      "end_seconds": "281.04",
      "text": "But cloud cover,"
    },
    {
      "start_seconds": "281.44",
      "end_seconds": "283.04",
      "text": "heavy seas and the constant"
    },
    {
      "start_seconds": "283.2",
      "end_seconds": "284.16",
      "text": "movement of the boat"
    },
    {
      "start_seconds": "284.28",
      "end_seconds": "286.08",
      "text": "made observations difficult."
    },
    {
      "start_seconds": "286.28",
      "end_seconds": "287.2",
      "text": "During the crossing,"
    },
    {
      "start_seconds": "287.28",
      "end_seconds": "287.84",
      "text": "he obtained"
    },
    {
      "start_seconds": "287.92",
      "end_seconds": "289.84",
      "text": "only four usable observations"
    },
    {
      "start_seconds": "289.92",
      "end_seconds": "290.8",
      "text": "of the sun."
    },
    {
      "start_seconds": "290.88",
      "end_seconds": "291.6",
      "text": "Between them,"
    },
    {
      "start_seconds": "291.68",
      "end_seconds": "293.04",
      "text": "he estimated their position"
    },
    {
      "start_seconds": "293.12",
      "end_seconds": "294.32",
      "text": "from the course steered"
    },
    {
      "start_seconds": "294.4",
      "end_seconds": "295.68",
      "text": "and distance travelled,"
    },
    {
      "start_seconds": "296.0",
      "end_seconds": "296.96",
      "text": "adjusting whenever new"
    },
    {
      "start_seconds": "297.04",
      "end_seconds": "298.24",
      "text": "evidence allowed."
    },
    {
      "start_seconds": "298.4",
      "end_seconds": "299.52",
      "text": "The others kept the boat"
    },
    {
      "start_seconds": "299.6",
      "end_seconds": "300.96",
      "text": "moving and afloat."
    },
    {
      "start_seconds": "301.04",
      "end_seconds": "302.4",
      "text": "They worked in watches,"
    },
    {
      "start_seconds": "302.667",
      "end_seconds": "303.6",
      "text": "handling the sails,"
    },
    {
      "start_seconds": "303.76",
      "end_seconds": "305.6",
      "text": "steering and bailing water."
    },
    {
      "start_seconds": "305.76",
      "end_seconds": "306.72",
      "text": "Ice accumulated"
    },
    {
      "start_seconds": "306.8",
      "end_seconds": "308.32",
      "text": "on the vessel, adding weight"
    },
    {
      "start_seconds": "308.4",
      "end_seconds": "310.0",
      "text": "that had to be removed."
    },
    {
      "start_seconds": "310.08",
      "end_seconds": "312.16",
      "text": "After nearly two weeks at sea,"
    },
    {
      "start_seconds": "312.213",
      "end_seconds": "313.04",
      "text": "they were approaching"
    },
    {
      "start_seconds": "313.16",
      "end_seconds": "314.48",
      "text": "where Worsley calculated"
    },
    {
      "start_seconds": "314.56",
      "end_seconds": "316.16",
      "text": "South Georgia should be."
    },
    {
      "start_seconds": "316.24",
      "end_seconds": "317.68",
      "text": "On May 8, land"
    },
    {
      "start_seconds": "317.76",
      "end_seconds": "318.8",
      "text": "appeared through a break"
    },
    {
      "start_seconds": "318.88",
      "end_seconds": "320.0",
      "text": "in the clouds."
    },
    {
      "start_seconds": "320.107",
      "end_seconds": "321.52",
      "text": "They had found the island."
    },
    {
      "start_seconds": "321.76",
      "end_seconds": "322.88",
      "text": "But heavy seas"
    },
    {
      "start_seconds": "323.0",
      "end_seconds": "324.24",
      "text": "and dangerous surf"
    },
    {
      "start_seconds": "324.36",
      "end_seconds": "324.8",
      "text": "prevented"
    },
    {
      "start_seconds": "324.88",
      "end_seconds": "326.0",
      "text": "an immediate landing."
    },
    {
      "start_seconds": "326.44",
      "end_seconds": "327.52",
      "text": "For two more days,"
    },
    {
      "start_seconds": "327.6",
      "end_seconds": "328.16",
      "text": "they remained"
    },
    {
      "start_seconds": "328.24",
      "end_seconds": "329.6",
      "text": "offshore, searching"
    },
    {
      "start_seconds": "329.68",
      "end_seconds": "330.72",
      "text": "for a safe approach."
    },
    {
      "start_seconds": "331.2",
      "end_seconds": "332.0",
      "text": "On May 10,"
    },
    {
      "start_seconds": "332.32",
      "end_seconds": "333.6",
      "text": "the six men finally"
    },
    {
      "start_seconds": "333.68",
      "end_seconds": "335.28",
      "text": "landed in King Haakon Bay,"
    },
    {
      "start_seconds": "335.64",
      "end_seconds": "336.56",
      "text": "on South Georgia's"
    },
    {
      "start_seconds": "336.64",
      "end_seconds": "337.44",
      "text": "western coast."
    },
    {
      "start_seconds": "337.92",
      "end_seconds": "338.88",
      "text": "The whaling stations"
    },
    {
      "start_seconds": "338.96",
      "end_seconds": "339.68",
      "text": "were on the other"
    },
    {
      "start_seconds": "339.8",
      "end_seconds": "340.64",
      "text": "side of the island."
    },
    {
      "start_seconds": "341.04",
      "end_seconds": "342.08",
      "text": "With the James Caird"
    },
    {
      "start_seconds": "342.16",
      "end_seconds": "342.8",
      "text": "and its crew"
    },
    {
      "start_seconds": "342.84",
      "end_seconds": "344.24",
      "text": "in their exhausted condition,"
    },
    {
      "start_seconds": "344.68",
      "end_seconds": "345.44",
      "text": "attempting to reach"
    },
    {
      "start_seconds": "345.52",
      "end_seconds": "346.8",
      "text": "those stations by sailing"
    },
    {
      "start_seconds": "346.88",
      "end_seconds": "347.68",
      "text": "around the coast"
    },
    {
      "start_seconds": "347.84",
      "end_seconds": "348.96",
      "text": "was too dangerous."
    },
    {
      "start_seconds": "349.44",
      "end_seconds": "351.04",
      "text": "Shackleton decided to cross"
    },
    {
      "start_seconds": "351.12",
      "end_seconds": "352.32",
      "text": "the mountains instead."
    },
    {
      "start_seconds": "352.84",
      "end_seconds": "354.08",
      "text": "McNish, Vincent"
    },
    {
      "start_seconds": "354.16",
      "end_seconds": "354.88",
      "text": "and McCarthy"
    },
    {
      "start_seconds": "355.04",
      "end_seconds": "356.0",
      "text": "remained behind."
    },
    {
      "start_seconds": "356.56",
      "end_seconds": "357.84",
      "text": "Shackleton, Worsley"
    },
    {
      "start_seconds": "357.88",
      "end_seconds": "359.6",
      "text": "and Crean set out on foot"
    },
    {
      "start_seconds": "359.68",
      "end_seconds": "360.8",
      "text": "on May 19."
    },
    {
      "start_seconds": "361.16",
      "end_seconds": "362.24",
      "text": "There was no established"
    },
    {
      "start_seconds": "362.32",
      "end_seconds": "363.36",
      "text": "route through the mountains"
    },
    {
      "start_seconds": "363.44",
      "end_seconds": "364.16",
      "text": "and glaciers."
    },
    {
      "start_seconds": "364.6",
      "end_seconds": "366.56",
      "text": "At one steep icy descent,"
    },
    {
      "start_seconds": "366.88",
      "end_seconds": "368.16",
      "text": "Worsley and Crean held"
    },
    {
      "start_seconds": "368.24",
      "end_seconds": "369.68",
      "text": "the rope while Shackleton"
    },
    {
      "start_seconds": "369.76",
      "end_seconds": "371.12",
      "text": "used a carpenter's adze"
    },
    {
      "start_seconds": "371.2",
      "end_seconds": "372.8",
      "text": "to cut steps into the ice."
    },
    {
      "start_seconds": "373.12",
      "end_seconds": "374.16",
      "text": "Descending roughly"
    },
    {
      "start_seconds": "374.24",
      "end_seconds": "375.6",
      "text": "five hundred feet took"
    },
    {
      "start_seconds": "375.68",
      "end_seconds": "376.96",
      "text": "them about two hours."
    },
    {
      "start_seconds": "377.36",
      "end_seconds": "378.64",
      "text": "Then the three continued"
    },
    {
      "start_seconds": "378.72",
      "end_seconds": "380.4",
      "text": "across snowfields and ridges,"
    },
    {
      "start_seconds": "380.72",
      "end_seconds": "381.92",
      "text": "searching for a passage"
    },
    {
      "start_seconds": "382.0",
      "end_seconds": "383.44",
      "text": "toward the inhabited coast."
    },
    {
      "start_seconds": "383.84",
      "end_seconds": "384.8",
      "text": "On May 20,"
    },
    {
      "start_seconds": "385.08",
      "end_seconds": "386.0",
      "text": "after approximately"
    },
    {
      "start_seconds": "386.16",
      "end_seconds": "387.84",
      "text": "thirty-six hours of travelling,"
    },
    {
      "start_seconds": "388.2",
      "end_seconds": "389.04",
      "text": "they reached the whaling"
    },
    {
      "start_seconds": "389.2",
      "end_seconds": "390.48",
      "text": "station at Stromness."
    },
    {
      "start_seconds": "390.96",
      "end_seconds": "391.92",
      "text": "The three men left"
    },
    {
      "start_seconds": "392.0",
      "end_seconds": "392.96",
      "text": "on South Georgia's"
    },
    {
      "start_seconds": "393.16",
      "end_seconds": "394.0",
      "text": "western shore"
    },
    {
      "start_seconds": "394.12",
      "end_seconds": "394.88",
      "text": "were subsequently"
    },
    {
      "start_seconds": "394.96",
      "end_seconds": "395.84",
      "text": "brought to safety."
    },
    {
      "start_seconds": "396.36",
      "end_seconds": "397.12",
      "text": "But no news"
    },
    {
      "start_seconds": "397.24",
      "end_seconds": "398.72",
      "text": "of any of this had reached"
    },
    {
      "start_seconds": "398.8",
      "end_seconds": "399.6",
      "text": "Elephant Island."
    },
    {
      "start_seconds": "400.08",
      "end_seconds": "401.12",
      "text": "Wild and the other"
    },
    {
      "start_seconds": "401.2",
      "end_seconds": "402.24",
      "text": "twenty-one men"
    },
    {
      "start_seconds": "402.36",
      "end_seconds": "403.28",
      "text": "were still waiting."
    },
    {
      "start_seconds": "404.0",
      "end_seconds": "405.04",
      "text": "Inside their shelter,"
    },
    {
      "start_seconds": "405.12",
      "end_seconds": "406.24",
      "text": "they maintained a daily"
    },
    {
      "start_seconds": "406.32",
      "end_seconds": "407.92",
      "text": "routine, gathered food"
    },
    {
      "start_seconds": "408.0",
      "end_seconds": "409.44",
      "text": "when they could and endured"
    },
    {
      "start_seconds": "409.52",
      "end_seconds": "410.72",
      "text": "the Antarctic winter"
    },
    {
      "start_seconds": "410.92",
      "end_seconds": "411.76",
      "text": "without knowing whether"
    },
    {
      "start_seconds": "411.84",
      "end_seconds": "413.28",
      "text": "the James Caird had reached"
    },
    {
      "start_seconds": "413.36",
      "end_seconds": "414.64",
      "text": "its destination."
    },
    {
      "start_seconds": "414.96",
      "end_seconds": "415.36",
      "text": "Wild kept"
    },
    {
      "start_seconds": "415.44",
      "end_seconds": "416.48",
      "text": "the group organised."
    },
    {
      "start_seconds": "416.88",
      "end_seconds": "417.92",
      "text": "Each day, he rolled"
    },
    {
      "start_seconds": "418.0",
      "end_seconds": "419.36",
      "text": "up his own sleeping bag,"
    },
    {
      "start_seconds": "419.6",
      "end_seconds": "420.96",
      "text": "repeating that Shackleton"
    },
    {
      "start_seconds": "421.04",
      "end_seconds": "422.64",
      "text": "might arrive that day."
    },
    {
      "start_seconds": "422.72",
      "end_seconds": "423.76",
      "text": "The others continued"
    },
    {
      "start_seconds": "423.84",
      "end_seconds": "424.8",
      "text": "the work of maintaining"
    },
    {
      "start_seconds": "424.88",
      "end_seconds": "426.88",
      "text": "the camp and finding food."
    },
    {
      "start_seconds": "427.2",
      "end_seconds": "429.52",
      "text": "Days passed. Then weeks."
    },
    {
      "start_seconds": "429.627",
      "end_seconds": "430.88",
      "text": "Shackleton's first rescue"
    },
    {
      "start_seconds": "430.96",
      "end_seconds": "432.32",
      "text": "attempt, aboard the whaling"
    },
    {
      "start_seconds": "432.44",
      "end_seconds": "433.68",
      "text": "ship Southern Sky,"
    },
    {
      "start_seconds": "433.84",
      "end_seconds": "435.52",
      "text": "was stopped by pack ice."
    },
    {
      "start_seconds": "435.627",
      "end_seconds": "436.56",
      "text": "The next attempt,"
    },
    {
      "start_seconds": "436.64",
      "end_seconds": "438.08",
      "text": "using the Uruguayan vessel"
    },
    {
      "start_seconds": "438.16",
      "end_seconds": "440.24",
      "text": "Instituto de Pesca No. 1,"
    },
    {
      "start_seconds": "440.293",
      "end_seconds": "441.2",
      "text": "and a later voyage"
    },
    {
      "start_seconds": "441.28",
      "end_seconds": "442.08",
      "text": "aboard the schooner"
    },
    {
      "start_seconds": "442.16",
      "end_seconds": "443.52",
      "text": "Emma also failed"
    },
    {
      "start_seconds": "443.6",
      "end_seconds": "445.2",
      "text": "to reach Elephant Island."
    },
    {
      "start_seconds": "445.52",
      "end_seconds": "447.12",
      "text": "Three attempts had failed,"
    },
    {
      "start_seconds": "447.173",
      "end_seconds": "448.4",
      "text": "and the men on the island"
    },
    {
      "start_seconds": "448.48",
      "end_seconds": "450.24",
      "text": "still had no news."
    },
    {
      "start_seconds": "450.347",
      "end_seconds": "452.0",
      "text": "As winter continued, food"
    },
    {
      "start_seconds": "452.08",
      "end_seconds": "454.08",
      "text": "became increasingly scarce."
    },
    {
      "start_seconds": "454.24",
      "end_seconds": "455.52",
      "text": "By late August, the men"
    },
    {
      "start_seconds": "455.6",
      "end_seconds": "457.04",
      "text": "were using what remained"
    },
    {
      "start_seconds": "457.12",
      "end_seconds": "458.08",
      "text": "and gathering limpets"
    },
    {
      "start_seconds": "458.16",
      "end_seconds": "460.0",
      "text": "and seaweed along the shore."
    },
    {
      "start_seconds": "460.16",
      "end_seconds": "461.2",
      "text": "Shackleton secured"
    },
    {
      "start_seconds": "461.44",
      "end_seconds": "462.88",
      "text": "a fourth opportunity."
    },
    {
      "start_seconds": "462.987",
      "end_seconds": "464.0",
      "text": "The Chilean government"
    },
    {
      "start_seconds": "464.28",
      "end_seconds": "465.84",
      "text": "provided Yelcho, a small"
    },
    {
      "start_seconds": "465.92",
      "end_seconds": "467.04",
      "text": "steam tug commanded"
    },
    {
      "start_seconds": "467.16",
      "end_seconds": "469.36",
      "text": "by naval officer Luis Pardo."
    },
    {
      "start_seconds": "469.44",
      "end_seconds": "471.12",
      "text": "It was not an icebreaker."
    },
    {
      "start_seconds": "471.2",
      "end_seconds": "472.4",
      "text": "The ship could not force"
    },
    {
      "start_seconds": "472.52",
      "end_seconds": "473.68",
      "text": "its way through a solid"
    },
    {
      "start_seconds": "473.76",
      "end_seconds": "475.28",
      "text": "barrier of pack ice."
    },
    {
      "start_seconds": "475.36",
      "end_seconds": "476.8",
      "text": "On August 25,"
    },
    {
      "start_seconds": "476.88",
      "end_seconds": "477.92",
      "text": "Yelcho departed"
    },
    {
      "start_seconds": "478.0",
      "end_seconds": "479.12",
      "text": "with Shackleton aboard."
    },
    {
      "start_seconds": "479.36",
      "end_seconds": "480.32",
      "text": "As the pack ice"
    },
    {
      "start_seconds": "480.4",
      "end_seconds": "481.92",
      "text": "shifted toward the northeast,"
    },
    {
      "start_seconds": "482.24",
      "end_seconds": "483.12",
      "text": "Shackleton chose"
    },
    {
      "start_seconds": "483.16",
      "end_seconds": "484.64",
      "text": "to approach Elephant Island"
    },
    {
      "start_seconds": "484.72",
      "end_seconds": "485.76",
      "text": "from the northwest."
    },
    {
      "start_seconds": "486.2",
      "end_seconds": "487.52",
      "text": "Pardo then had to bring"
    },
    {
      "start_seconds": "487.56",
      "end_seconds": "488.64",
      "text": "the vessel safely"
    },
    {
      "start_seconds": "488.72",
      "end_seconds": "489.44",
      "text": "through the waters"
    },
    {
      "start_seconds": "489.52",
      "end_seconds": "490.24",
      "text": "near the island."
    },
    {
      "start_seconds": "490.76",
      "end_seconds": "492.4",
      "text": "In fog, he navigated"
    },
    {
      "start_seconds": "492.6",
      "end_seconds": "493.84",
      "text": "among numerous grounded"
    },
    {
      "start_seconds": "493.92",
      "end_seconds": "495.76",
      "text": "icebergs, guiding the small"
    },
    {
      "start_seconds": "495.92",
      "end_seconds": "497.04",
      "text": "tug toward the camp."
    },
    {
      "start_seconds": "497.64",
      "end_seconds": "499.6",
      "text": "On August 30, Yelcho"
    },
    {
      "start_seconds": "499.68",
      "end_seconds": "500.96",
      "text": "reached Elephant Island."
    },
    {
      "start_seconds": "501.44",
      "end_seconds": "502.24",
      "text": "The men ashore"
    },
    {
      "start_seconds": "502.32",
      "end_seconds": "502.96",
      "text": "were preparing"
    },
    {
      "start_seconds": "503.04",
      "end_seconds": "504.64",
      "text": "food when a cry announced"
    },
    {
      "start_seconds": "504.68",
      "end_seconds": "505.6",
      "text": "the approaching ship."
    },
    {
      "start_seconds": "506.12",
      "end_seconds": "508.24",
      "text": "At first, the words “Ship O!”"
    },
    {
      "start_seconds": "508.6",
      "end_seconds": "510.64",
      "text": "were mistaken for “Lunch O!”"
    },
    {
      "start_seconds": "511.2",
      "end_seconds": "513.28",
      "text": "Then the men saw the vessel."
    },
    {
      "start_seconds": "513.84",
      "end_seconds": "514.88",
      "text": "After more than four"
    },
    {
      "start_seconds": "515.04",
      "end_seconds": "517.12",
      "text": "months of isolation, a ship"
    },
    {
      "start_seconds": "517.2",
      "end_seconds": "518.4",
      "text": "had reached their shore."
    },
    {
      "start_seconds": "518.84",
      "end_seconds": "520.32",
      "text": "Pardo brought Yelcho close"
    },
    {
      "start_seconds": "520.4",
      "end_seconds": "521.68",
      "text": "enough for the evacuation"
    },
    {
      "start_seconds": "521.76",
      "end_seconds": "522.24",
      "text": "to begin."
    },
    {
      "start_seconds": "522.8",
      "end_seconds": "523.92",
      "text": "All twenty-two men"
    },
    {
      "start_seconds": "524.0",
      "end_seconds": "524.72",
      "text": "who had remained"
    },
    {
      "start_seconds": "524.8",
      "end_seconds": "525.76",
      "text": "on Elephant Island"
    },
    {
      "start_seconds": "525.84",
      "end_seconds": "526.88",
      "text": "were taken aboard."
    },
    {
      "start_seconds": "527.28",
      "end_seconds": "529.36",
      "text": "Every one of them was alive."
    },
    {
      "start_seconds": "529.92",
      "end_seconds": "531.12",
      "text": "The wider Imperial"
    },
    {
      "start_seconds": "531.28",
      "end_seconds": "532.96",
      "text": "Trans-Antarctic Expedition"
    },
    {
      "start_seconds": "533.2",
      "end_seconds": "534.4",
      "text": "had a different outcome."
    },
    {
      "start_seconds": "534.8",
      "end_seconds": "535.52",
      "text": "On the opposite"
    },
    {
      "start_seconds": "535.6",
      "end_seconds": "536.56",
      "text": "side of Antarctica,"
    },
    {
      "start_seconds": "536.96",
      "end_seconds": "538.56",
      "text": "the separate Ross Sea Party"
    },
    {
      "start_seconds": "538.6",
      "end_seconds": "539.84",
      "text": "suffered its own ordeal,"
    },
    {
      "start_seconds": "540.2",
      "end_seconds": "541.6",
      "text": "and three men died."
    },
    {
      "start_seconds": "542.08",
      "end_seconds": "542.56",
      "text": "The planned"
    },
    {
      "start_seconds": "542.64",
      "end_seconds": "544.08",
      "text": "crossing of Antarctica"
    },
    {
      "start_seconds": "544.24",
      "end_seconds": "545.36",
      "text": "was never completed."
    },
    {
      "start_seconds": "545.8",
      "end_seconds": "546.96",
      "text": "But the twenty-two men"
    },
    {
      "start_seconds": "547.04",
      "end_seconds": "547.44",
      "text": "rescued"
    },
    {
      "start_seconds": "547.52",
      "end_seconds": "548.48",
      "text": "from Elephant Island,"
    },
    {
      "start_seconds": "548.8",
      "end_seconds": "549.84",
      "text": "together with the six"
    },
    {
      "start_seconds": "549.92",
      "end_seconds": "550.96",
      "text": "who had sailed for help,"
    },
    {
      "start_seconds": "551.4",
      "end_seconds": "552.88",
      "text": "accounted for every member"
    },
    {
      "start_seconds": "552.92",
      "end_seconds": "554.08",
      "text": "of the Endurance party."
    },
    {
      "start_seconds": "554.56",
      "end_seconds": "556.4",
      "text": "The expedition lost its ship."
    },
    {
      "start_seconds": "557.04",
      "end_seconds": "558.48",
      "text": "All twenty-eight men"
    },
    {
      "start_seconds": "558.56",
      "end_seconds": "559.84",
      "text": "came home alive."
    }
  ]
}
