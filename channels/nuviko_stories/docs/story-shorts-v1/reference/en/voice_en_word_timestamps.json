{"durationSeconds":104.124,"fileName":"ElevenLabs_2026-10-28T00_17_47_Darth_pvc_sp100_s30_sb90_v4.mp3","id":"A2A5174E","language":"en-ZA","name":"ElevenLabs_2026-10-28T00_17_47_Darth_pvc_sp100_s30_sb90_v4","segments":[["My brother proposed to his ex-girlfriend's best friend, and then I saw his text messages.",0,5.52],["He and his ex had been together for 12 years.",5.52,8.4],["She wanted to get married and start a family, but he kept saying he didn't believe in marriage.",8.4,13.44],["Eventually, she left him.",13.44,15.48],["Then, out of nowhere, he announced he was engaged.",15.48,18.54],["I didn't even know he was dating anyone, and his ex was left wondering, why was he willing to marry her best friend, but not her?",18.54,25.68],["She'd been like an older sister to me for years.",25.68,28.44],["So, when one of my brother's friends showed me the messages, I couldn't just stay quiet.",28.44,33],["Turns out, my brother wanted revenge.",33,35.64],["He wanted to give her best friend exactly what his ex had been waiting for all those years.",35.64,40.56],["My mom and sister told me to stay out of it, but his friend and I went to see her anyway, and told her everything.",40.56,46.44],["At 1st she didn't believe us.",46.44,48.72],["So, his friend showed her the messages.",48.72,50.76],["The next day, she texted me, saying that at least now she knew she wasn't the problem.",50.76,55.38],["She'd already found a new job and was planning to move away.",55.38,58.32],["I told my brother",58.32,59.64],["He barely said anything.",59.64,61.56],["Then he asked if he could stay with me for a while.",61.56,63.84],["He just sat around playing video games and drinking beer.",63.84,67.02],["He kept saying he had everything under control, that he'd just taken a week off work.",67.02,71.46],["Then he got drunk and told me he'd gone to see his ex.",71.46,75],["He'd apologised, and he tried to propose to her, to her.",75,79.68],["After already getting engaged to her best friend.",79.68,82.5],["I have no idea what's going to happen with that engagement now.",82.5,85.74],["My brother won't really explain anything.",85.74,87.72],["All he said about his ex was that she really was planning to move away.",87.72,91.56],["So, now he's staying at my place, drinking beer and playing video games.",91.56,96.18],["He keeps promising he'll pull himself together in a week.",96.18,98.76],["I feel bad for him.",98.76,100.26],["He's still my brother, but I don't regret telling her the truth.",100.26,103.8]],"timing":"sourceSeconds","type":"audio","words":[["My",0,0.3],["brother",0.3,0.48],["proposed",0.48,1.02],["to",1.02,1.2],["his",1.2,1.32],["ex-girlfriend's",1.32,2.34],["best",2.34,2.46],["friend,",2.46,3.06],["and",3.06,3.6],["then",3.6,3.9],["I",3.9,4.2],["saw",4.2,4.32],["his",4.32,4.5],["text",4.5,4.74],["messages.",4.74,5.46],["He",5.52,5.94],["and",5.94,6.18],["his",6.18,6.3],["ex",6.3,6.48],["had",6.48,6.78],["been",6.78,6.9],["together",6.9,7.08],["for",7.08,7.38],["12",7.38,7.8],["years.",7.8,8.34],["She",8.4,9.18],["wanted",9.18,9.36],["to",9.36,9.6],["get",9.6,9.66],["married",9.66,9.84],["and",9.84,10.2],["start",10.2,10.38],["a",10.38,10.56],["family,",10.56,11.04],["but",11.04,11.34],["he",11.34,11.64],["kept",11.64,11.82],["saying",11.82,12.06],["he",12.06,12.24],["didn't",12.24,12.54],["believe",12.54,12.66],["in",12.66,12.9],["marriage.",12.9,13.38],["Eventually,",13.44,14.52],["she",14.52,14.64],["left",14.64,14.82],["him.",14.82,15.36],["Then,",15.48,16.14],["out",16.14,16.32],["of",16.32,16.5],["nowhere,",16.5,17.16],["he",17.16,17.28],["announced",17.28,17.7],["he",17.7,17.88],["was",17.88,18],["engaged.",18,18.48],["I",18.54,19.14],["didn't",19.14,19.44],["even",19.44,19.5],["know",19.5,19.62],["he",19.62,19.8],["was",19.8,19.92],["dating",19.92,20.1],["anyone,",20.1,20.64],["and",20.64,21.18],["his",21.18,21.36],["ex",21.36,21.54],["was",21.54,21.84],["left",21.84,21.96],["wondering,",21.96,22.56],["why",22.56,23.16],["was",23.16,23.28],["h