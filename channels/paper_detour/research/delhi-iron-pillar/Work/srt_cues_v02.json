{
  "cues": [
    {
      "start_seconds": 0.0,
      "end_seconds": 1.3818,
      "text": "This iron pillar is about"
    },
    {
      "start_seconds": 1.4545,
      "end_seconds": 3.2,
      "text": "sixteen hundred years old."
    },
    {
      "start_seconds": 3.4182,
      "end_seconds": 5.3091,
      "text": "And something helped protect it:"
    },
    {
      "start_seconds": 5.3818,
      "end_seconds": 6.1091,
      "text": "rust."
    },
    {
      "start_seconds": 6.4,
      "end_seconds": 8.2182,
      "text": "The pillar stands in Delhi, India."
    },
    {
      "start_seconds": 8.6545,
      "end_seconds": 9.5273,
      "text": "The part above ground"
    },
    {
      "start_seconds": 9.6,
      "end_seconds": 11.2727,
      "text": "has survived remarkably well."
    },
    {
      "start_seconds": 11.4909,
      "end_seconds": 12.2182,
      "text": "But that doesn't mean"
    },
    {
      "start_seconds": 12.2909,
      "end_seconds": 13.7455,
      "text": "the iron never rusts."
    },
    {
      "start_seconds": 13.9636,
      "end_seconds": 15.7091,
      "text": "A dense layer of corrosion products"
    },
    {
      "start_seconds": 15.7818,
      "end_seconds": 16.9455,
      "text": "formed on its surface."
    },
    {
      "start_seconds": 17.1636,
      "end_seconds": 18.4727,
      "text": "It makes it harder for moisture"
    },
    {
      "start_seconds": 18.5455,
      "end_seconds": 19.2727,
      "text": "to reach the metal"
    },
    {
      "start_seconds": 19.3455,
      "end_seconds": 20.9091,
      "text": "and slows further damage."
    },
    {
      "start_seconds": 21.1636,
      "end_seconds": 22.2545,
      "text": "Phosphorus in the iron"
    },
    {
      "start_seconds": 22.3273,
      "end_seconds": 24.0364,
      "text": "helps this protective layer form."
    },
    {
      "start_seconds": 24.2909,
      "end_seconds": 25.9636,
      "text": "The surrounding conditions matter too."
    },
    {
      "start_seconds": 26.4,
      "end_seconds": 28.1455,
      "text": "The pillar isn't invincible:"
    },
    {
      "start_seconds": 28.2909,
      "end_seconds": 29.5273,
      "text": "below ground, it has rusted"
    },
    {
      "start_seconds": 29.6,
      "end_seconds": 30.4364,
      "text": "more heavily."
    },
    {
      "start_seconds": 30.6909,
      "end_seconds": 32.1455,
      "text": "So rust doesn't always"
    },
    {
      "start_seconds": 32.2182,
      "end_seconds": 33.5273,
      "text": "just destroy iron."
    },
    {
      "start_seconds": 33.7455,
      "end_seconds": 35.1273,
      "text": "Sometimes, it helps protect"
    },
    {
      "start_seconds": 35.1636,
      "end_seconds": 36.0,
      "text": "the metal underneath."
    }
  ]
}
