{
  "cues": [
    {
      "start_seconds": 0.0,
      "end_seconds": 1.81818182,
      "text": "Two planes collided in midair."
    },
    {
      "start_seconds": 2.32727273,
      "end_seconds": 4.21818182,
      "text": "One ended up stuck on top of the other."
    },
    {
      "start_seconds": 4.65454545,
      "end_seconds": 5.74545455,
      "text": "They were still flying."
    },
    {
      "start_seconds": 6.25454545,
      "end_seconds": 9.09090909,
      "text": "It was 1940,\nover a small town in Australia."
    },
    {
      "start_seconds": 9.67272727,
      "end_seconds": 10.98181818,
      "text": "Three men parachuted out."
    },
    {
      "start_seconds": 11.49090909,
      "end_seconds": 14.10909091,
      "text": "The pilot in the top plane,\nLeonard Fuller, stayed."
    },
    {
      "start_seconds": 14.61818182,
      "end_seconds": 16.94545455,
      "text": "He was afraid both planes\nwould crash into the town."
    },
    {
      "start_seconds": 17.49090909,
      "end_seconds": 20.0,
      "text": "His engines had stopped,\nbut his controls still worked."
    },
    {
      "start_seconds": 20.50909091,
      "end_seconds": 22.25454545,
      "text": "The plane underneath pulled them forward."
    },
    {
      "start_seconds": 22.76363636,
      "end_seconds": 24.0,
      "text": "Fuller steered them both."
    },
    {
      "start_seconds": 24.72727273,
      "end_seconds": 26.61818182,
      "text": "Then the lower plane started losing power."
    },
    {
      "start_seconds": 27.12727273,
      "end_seconds": 30.10909091,
      "text": "Fuller aimed for a field\nand hauled back on the controls."
    },
    {
      "start_seconds": 30.25454545,
      "end_seconds": 33.74545455,
      "text": "Both planes slid across the grass\nand stopped, still locked together."
    },
    {
      "start_seconds": 34.32727273,
      "end_seconds": 35.56363636,
      "text": "All four men survived."
    }
  ]
}
