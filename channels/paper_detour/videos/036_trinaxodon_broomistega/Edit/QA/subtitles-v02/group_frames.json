[
  {
    "text": "A predator",
    "frame": 11,
    "start": 0.0,
    "end": 0.76
  },
  {
    "text": "and an injured",
    "frame": 33,
    "start": 0.76,
    "end": 1.48
  },
  {
    "text": "amphibian lay",
    "frame": 58,
    "start": 1.48,
    "end": 2.4
  },
  {
    "text": "side by side",
    "frame": 84,
    "start": 2.4,
    "end": 3.24
  },
  {
    "text": "in the",
    "frame": 103,
    "start": 3.24,
    "end": 3.68
  },
  {
    "text": "same burrow for",
    "frame": 124,
    "start": 3.68,
    "end": 4.64
  },
  {
    "text": "250 million years.",
    "frame": 180,
    "start": 4.64,
    "end": 7.387
  },
  {
    "text": "How did they",
    "frame": 227,
    "start": 7.387,
    "end": 7.76
  },
  {
    "text": "end up there?",
    "frame": 250,
    "start": 7.76,
    "end": 8.907
  },
  {
    "text": "A drought",
    "frame": 275,
    "start": 8.907,
    "end": 9.48
  },
  {
    "text": "had struck",
    "frame": 292,
    "start": 9.48,
    "end": 10.0
  },
  {
    "text": "southern Africa.",
    "frame": 320,
    "start": 10.0,
    "end": 11.36
  },
  {
    "text": "Thrinaxodon,",
    "frame": 356,
    "start": 11.36,
    "end": 12.427
  },
  {
    "text": "a small,",
    "frame": 383,
    "start": 12.427,
    "end": 13.12
  },
  {
    "text": "sharp-toothed",
    "frame": 403,
    "start": 13.12,
    "end": 13.8
  },
  {
    "text": "predator,",
    "frame": 425,
    "start": 13.8,
    "end": 14.56
  },
  {
    "text": "retreated",
    "frame": 444,
    "start": 14.56,
    "end": 15.08
  },
  {
    "text": "underground",
    "frame": 463,
    "start": 15.08,
    "end": 15.8
  },
  {
    "text": "and fell into",
    "frame": 486,
    "start": 15.8,
    "end": 16.64
  },
  {
    "text": "a deep sleep.",
    "frame": 510,
    "start": 16.64,
    "end": 17.36
  },
  {
    "text": "Then came",
    "frame": 553,
    "start": 18.08,
    "end": 18.8
  },
  {
    "text": "Broomistega,",
    "frame": 580,
    "start": 18.8,
    "end": 19.92
  },
  {
    "text": "a young amphibian",
    "frame": 612,
    "start": 19.92,
    "end": 20.92
  },
  {
    "text": "with broken ribs,",
    "frame": 646,
    "start": 20.92,
    "end": 22.16
  },
  {
    "text": "searching",
    "frame": 669,
    "start": 22.16,
    "end": 22.48
  },
  {
    "text": "for shelter.",
    "frame": 691,
    "start": 22.48,
    "end": 23.627
  },
  {
    "text": "It crawled",
    "frame": 717,
    "start": 23.627,
    "end": 24.2
  },
  {
    "text": "into the burrow",
    "frame": 738,
    "start": 24.2,
    "end": 25.0
  },
  {
    "text": "and found",
    "frame": 756,
    "start": 25.0,
    "end": 25.44
  },
  {
    "text": "the sleeping",
    "frame": 770,
    "start": 25.44,
    "end": 25.92
  },
  {
    "text": "predator.",
    "frame": 794,
    "start": 25.92,
    "end": 27.067
  },
  {
    "text": "The owner",
    "frame": 818,
    "start": 27.067,
    "end": 27.52
  },
  {
    "text": "didn't wake,",
    "frame": 837,
    "start": 27.52,
    "end": 28.293
  },
  {
    "text": "and the amphibian",
    "frame": 861,
    "start": 28.293,
    "end": 29.12
  },
  {
    "text": "stayed beside him.",
    "frame": 897,
    "start": 29.12,
    "end": 30.72
  },
  {
    "text": "Then a flood",
    "frame": 937,
    "start": 30.72,
    "end": 31.76
  },
  {
    "text": "swept through",
    "frame": 960,
    "start": 31.76,
    "end": 32.24
  },
  {
    "text": "the land,",
    "frame": 979,
    "start": 32.24,
    "end": 33.04
  },
  {
    "text": "filling",
    "frame": 996,
    "start": 33.04,
    "end": 33.36
  },
  {
    "text": "their hiding place",
    "frame": 1011,
    "start": 33.36,
    "end": 34.08
  },
  {
    "text": "with mud",
    "frame": 1032,
    "start": 34.08,
    "end": 34.76
  },
  {
    "text": "and burying",
    "frame": 1051,
    "start": 34.76,
    "end": 35.36
  },
  {
    "text": "them together.",
    "frame": 1078,
    "start": 35.36,
    "end": 36.56
  },
  {
    "text": "The burrow",
    "frame": 1105,
    "start": 36.56,
    "end": 37.12
  },
  {
    "text": "turned to stone,",
    "frame": 1131,
    "start": 37.12,
    "end": 38.32
  },
  {
    "text": "preserving",
    "frame": 1158,
    "start": 38.32,
    "end": 38.92
  },
  {
    "text": "both skeletons.",
    "frame": 1189,
    "start": 38.92,
    "end": 40.4
  },
  {
    "text": "Millions of years",
    "frame": 1225,
    "start": 40.4,
    "end": 41.28
  },
  {
    "text": "later,",
    "frame": 1248,
    "start": 41.28,
    "end": 41.92
  },
  {
    "text": "scientists looked",
    "frame": 1269,
    "start": 41.92,
    "end": 42.72
  },
  {
    "text": "inside and found",
    "frame": 1298,
    "start": 42.72,
    "end": 43.84
  },
  {
    "text": "an unlikely pair:",
    "frame": 1330,
    "start": 43.84,
    "end": 44.88
  }
]
