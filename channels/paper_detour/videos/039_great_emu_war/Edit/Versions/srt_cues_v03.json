{
  "cues": [
    {
      "start_seconds": 0.0,
      "end_seconds": 2.4,
      "text": "The Great Emu War (1932)"
    },
    {
      "start_seconds": 3.127272727272727,
      "end_seconds": 4.945454545454545,
      "text": "November fourth, 1932."
    },
    {
      "start_seconds": 5.672727272727273,
      "end_seconds": 6.618181818181818,
      "text": "In Western Australia,"
    },
    {
      "start_seconds": 6.981818181818181,
      "end_seconds": 8.218181818181817,
      "text": "soldiers wait beside a dam"
    },
    {
      "start_seconds": 8.29090909090909,
      "end_seconds": 9.09090909090909,
      "text": "with machine guns."
    },
    {
      "start_seconds": 9.527272727272727,
      "end_seconds": 10.036363636363635,
      "text": "Ahead of them,"
    },
    {
      "start_seconds": 10.327272727272726,
      "end_seconds": 11.563636363636363,
      "text": "around a thousand emus"
    },
    {
      "start_seconds": 11.6,
      "end_seconds": 12.58181818181818,
      "text": "are approaching the water."
    },
    {
      "start_seconds": 13.09090909090909,
      "end_seconds": 14.036363636363635,
      "text": "The birds have finally"
    },
    {
      "start_seconds": 14.109090909090908,
      "end_seconds": 15.272727272727272,
      "text": "gathered in one place."
    },
    {
      "start_seconds": 15.854545454545454,
      "end_seconds": 16.727272727272723,
      "text": "The soldiers let them come"
    },
    {
      "start_seconds": 16.8,
      "end_seconds": 18.690909090909088,
      "text": "closer, then open fire."
    },
    {
      "start_seconds": 19.27272727272727,
      "end_seconds": 20.29090909090909,
      "text": "A few emus fall."
    },
    {
      "start_seconds": 20.799999999999997,
      "end_seconds": 22.327272727272724,
      "text": "Then a machine gun jams."
    },
    {
      "start_seconds": 22.763636363636362,
      "end_seconds": 23.78181818181818,
      "text": "The rest scatter"
    },
    {
      "start_seconds": 23.854545454545452,
      "end_seconds": 24.8,
      "text": "across the open land."
    },
    {
      "start_seconds": 25.30909090909091,
      "end_seconds": 26.25454545454545,
      "text": "It was one of their best"
    },
    {
      "start_seconds": 26.327272727272724,
      "end_seconds": 27.927272727272722,
      "text": "chances to stop a whole flock."
    },
    {
      "start_seconds": 28.436363636363634,
      "end_seconds": 29.96363636363636,
      "text": "Almost every bird escaped."
    },
    {
      "start_seconds": 30.763636363636365,
      "end_seconds": 31.63636363636363,
      "text": "How did Australia"
    },
    {
      "start_seconds": 31.709090909090907,
      "end_seconds": 32.581818181818186,
      "text": "end up sending machine"
    },
    {
      "start_seconds": 32.654545454545456,
      "end_seconds": 33.67272727272727,
      "text": "guns against emus?"
    },
    {
      "start_seconds": 34.25454545454545,
      "end_seconds": 34.98181818181818,
      "text": "To understand that,"
    },
    {
      "start_seconds": 35.272727272727266,
      "end_seconds": 36.21818181818182,
      "text": "go back two days."
    },
    {
      "start_seconds": 36.8,
      "end_seconds": 37.527272727272724,
      "text": "On November second,"
    },
    {
      "start_seconds": 37.89090909090909,
      "end_seconds": 38.83636363636363,
      "text": "a small army unit"
    },
    {
      "start_seconds": 38.945454545454545,
      "end_seconds": 39.92727272727272,
      "text": "arrives in the wheat-growing"
    },
    {
      "start_seconds": 40.0,
      "end_seconds": 41.018181818181816,
      "text": "district near Campion."
    },
    {
      "start_seconds": 41.599999999999994,
      "end_seconds": 42.61818181818182,
      "text": "The men have two machine"
    },
    {
      "start_seconds": 42.69090909090909,
      "end_seconds": 44.07272727272726,
      "text": "guns and orders to help local"
    },
    {
      "start_seconds": 44.21818181818181,
      "end_seconds": 45.527272727272724,
      "text": "farmers get rid of the birds."
    },
    {
      "start_seconds": 46.14545454545454,
      "end_seconds": 46.61818181818182,
      "text": "Those farmers"
    },
    {
      "start_seconds": 46.65454545454545,
      "end_seconds": 47.272727272727266,
      "text": "have been fighting"
    },
    {
      "start_seconds": 47.34545454545454,
      "end_seconds": 48.50909090909091,
      "text": "to keep their farms alive."
    },
    {
      "start_seconds": 49.309090909090905,
      "end_seconds": 50.03636363636363,
      "text": "After the First World"
    },
    {
      "start_seconds": 50.1090909090909,
      "end_seconds": 51.199999999999996,
      "text": "War, many former"
    },
    {
      "start_seconds": 51.272727272727266,
      "end_seconds": 52.5090909090909,
      "text": "soldiers had settled on land"
    },
    {
      "start_seconds": 52.58181818181818,
      "end_seconds": 53.527272727272724,
      "text": "in Western Australia."
    },
    {
      "start_seconds": 54.10909090909091,
      "end_seconds": 55.127272727272725,
      "text": "Some of that land was hard"
    },
    {
      "start_seconds": 55.199999999999996,
      "end_seconds": 56.58181818181818,
      "text": "to farm even in good years."
    },
    {
      "start_seconds": 57.163636363636364,
      "end_seconds": 57.963636363636354,
      "text": "In parts of the district,"
    },
    {
      "start_seconds": 58.32727272727272,
      "end_seconds": 59.78181818181818,
      "text": "settlers had already abandoned"
    },
    {
      "start_seconds": 59.85454545454545,
      "end_seconds": 60.36363636363637,
      "text": "their farms."
    },
    {
      "start_seconds": 60.945454545454545,
      "end_seconds": 62.25454545454545,
      "text": "Then the Great Depression"
    },
    {
      "start_seconds": 62.32727272727272,
      "end_seconds": 62.61818181818181,
      "text": "struck."
    },
    {
      "start_seconds": 63.05454545454545,
      "end_seconds": 64.21818181818182,
      "text": "Wheat prices collapsed."
    },
    {
      "start_seconds": 64.72727272727272,
      "end_seconds": 65.38181818181818,
      "text": "Drought made"
    },
    {
      "start_seconds": 65.45454545454545,
      "end_seconds": 66.25454545454545,
      "text": "everything worse."
    },
    {
      "start_seconds": 66.87272727272727,
      "end_seconds": 67.92727272727272,
      "text": "For the families who stayed,"
    },
    {
      "start_seconds": 68.21818181818182,
      "end_seconds": 68.72727272727272,
      "text": "the harvest"
    },
    {
      "start_seconds": 68.8,
      "end_seconds": 69.74545454545454,
      "text": "was their livelihood."
    },
    {
      "start_seconds": 70.25454545454545,
      "end_seconds": 71.27272727272727,
      "text": "A lost field of wheat"
    },
    {
      "start_seconds": 71.34545454545454,
      "end_seconds": 72.43636363636364,
      "text": "could mean a year of work"
    },
    {
      "start_seconds": 72.5090909090909,
      "end_seconds": 73.67272727272727,
      "text": "with nothing to show for it."
    },
    {
      "start_seconds": 74.32727272727273,
      "end_seconds": 74.69090909090909,
      "text": "And now"
    },
    {
      "start_seconds": 74.98181818181818,
      "end_seconds": 76.21818181818182,
      "text": "the emus were arriving."
    },
    {
      "start_seconds": 76.72727272727272,
      "end_seconds": 77.52727272727272,
      "text": "They were huge,"
    },
    {
      "start_seconds": 77.74545454545454,
      "end_seconds": 79.49090909090908,
      "text": "flightless birds, nearly as tall"
    },
    {
      "start_seconds": 79.52727272727273,
      "end_seconds": 81.38181818181818,
      "text": "as a person, with powerful legs"
    },
    {
      "start_seconds": 81.45454545454544,
      "end_seconds": 82.1090909090909,
      "text": "built for running."
    },
    {
      "start_seconds": 82.76363636363637,
      "end_seconds": 83.7090909090909,
      "text": "Thousands were moving"
    },
    {
      "start_seconds": 83.78181818181817,
      "end_seconds": 84.8,
      "text": "through the farming districts"
    },
    {
      "start_seconds": 84.9090909090909,
      "end_seconds": 86.1090909090909,
      "text": "looking for food and water."
    },
    {
      "start_seconds": 86.72727272727272,
      "end_seconds": 87.92727272727272,
      "text": "To the birds, the wheat"
    },
    {
      "start_seconds": 87.99999999999999,
      "end_seconds": 89.74545454545454,
      "text": "fields were an easy meal."
    },
    {
      "start_seconds": 89.79363636363635,
      "end_seconds": 90.69090909090909,
      "text": "To the farmers,"
    },
    {
      "start_seconds": 90.76363636363637,
      "end_seconds": 91.27272727272727,
      "text": "they were crops"
    },
    {
      "start_seconds": 91.34545454545454,
      "end_seconds": 91.92727272727272,
      "text": "that had taken"
    },
    {
      "start_seconds": 92.0,
      "end_seconds": 93.59999999999998,
      "text": "months of work to grow."
    },
    {
      "start_seconds": 93.67272727272727,
      "end_seconds": 94.39999999999999,
      "text": "The emus ate"
    },
    {
      "start_seconds": 94.43636363636362,
      "end_seconds": 95.63636363636363,
      "text": "the grain and trampled what"
    },
    {
      "start_seconds": 95.7090909090909,
      "end_seconds": 96.72727272727272,
      "text": "they didn't eat."
    },
    {
      "start_seconds": 96.87272727272726,
      "end_seconds": 97.74545454545454,
      "text": "They damaged fences"
    },
    {
      "start_seconds": 97.78181818181818,
      "end_seconds": 99.12727272727273,
      "text": "as they moved through, leaving"
    },
    {
      "start_seconds": 99.2,
      "end_seconds": 100.5090909090909,
      "text": "openings for rabbits to enter"
    },
    {
      "start_seconds": 100.58181818181818,
      "end_seconds": 102.25454545454545,
      "text": "and do even more harm."
    },
    {
      "start_seconds": 102.32727272727273,
      "end_seconds": 103.27272727272727,
      "text": "The farmers couldn't"
    },
    {
      "start_seconds": 103.34545454545454,
      "end_seconds": 104.36363636363635,
      "text": "keep them out."
    },
    {
      "start_seconds": 104.65454545454546,
      "end_seconds": 105.3090909090909,
      "text": "So they turned"
    },
    {
      "start_seconds": 105.34545454545453,
      "end_seconds": 106.32727272727271,
      "text": "to the government for help."
    },
    {
      "start_seconds": 106.98181818181818,
      "end_seconds": 107.78181818181818,
      "text": "The Defence Minister"
    },
    {
      "start_seconds": 107.85454545454544,
      "end_seconds": 108.5090909090909,
      "text": "agreed to send"
    },
    {
      "start_seconds": 108.61818181818181,
      "end_seconds": 110.18181818181817,
      "text": "soldiers with machine guns."
    },
    {
      "start_seconds": 110.2790909090909,
      "end_seconds": 110.9090909090909,
      "text": "A cameraman came"
    },
    {
      "start_seconds": 110.98181818181817,
      "end_seconds": 112.87272727272726,
      "text": "along to record the operation."
    },
    {
      "start_seconds": 112.94545454545454,
      "end_seconds": 113.67272727272727,
      "text": "On paper,"
    },
    {
      "start_seconds": 113.77,
      "end_seconds": 115.27272727272727,
      "text": "the plan seemed simple."
    },
    {
      "start_seconds": 115.34545454545453,
      "end_seconds": 116.5090909090909,
      "text": "Find a large flock."
    },
    {
      "start_seconds": 116.58181818181818,
      "end_seconds": 118.03636363636363,
      "text": "Bring the guns within range."
    },
    {
      "start_seconds": 118.1090909090909,
      "end_seconds": 119.27272727272725,
      "text": "Open fire."
    },
    {
      "start_seconds": 119.34545454545454,
      "end_seconds": 119.92727272727271,
      "text": "But the soldiers"
    },
    {
      "start_seconds": 120.03636363636362,
      "end_seconds": 120.94545454545452,
      "text": "discovered the problem"
    },
    {
      "start_seconds": 121.01818181818182,
      "end_seconds": 122.90909090909089,
      "text": "almost as soon as they arrived."
    },
    {
      "start_seconds": 122.98181818181817,
      "end_seconds": 124.0,
      "text": "On their first day,"
    },
    {
      "start_seconds": 124.09727272727272,
      "end_seconds": 126.03636363636362,
      "text": "they spotted a group of emus."
    },
    {
      "start_seconds": 126.1090909090909,
      "end_seconds": 127.41818181818181,
      "text": "Farmers tried to herd the birds"
    },
    {
      "start_seconds": 127.49090909090908,
      "end_seconds": 128.87272727272725,
      "text": "toward the waiting guns."
    },
    {
      "start_seconds": 128.94545454545454,
      "end_seconds": 131.27272727272728,
      "text": "Instead, the flock broke apart."
    },
    {
      "start_seconds": 131.4181818181818,
      "end_seconds": 132.8,
      "text": "Some birds ran one way."
    },
    {
      "start_seconds": 132.87272727272725,
      "end_seconds": 134.4,
      "text": "Others ran another."
    },
    {
      "start_seconds": 134.49727272727273,
      "end_seconds": 134.83636363636361,
      "text": "By the time"
    },
    {
      "start_seconds": 134.9090909090909,
      "end_seconds": 136.07272727272726,
      "text": "the soldiers could shoot,"
    },
    {
      "start_seconds": 136.1209090909091,
      "end_seconds": 137.30909090909088,
      "text": "there were only small groups"
    },
    {
      "start_seconds": 137.38181818181818,
      "end_seconds": 138.83636363636361,
      "text": "moving across the fields."
    },
    {
      "start_seconds": 138.9090909090909,
      "end_seconds": 140.65454545454546,
      "text": "Only a few were killed."
    },
    {
      "start_seconds": 140.75181818181818,
      "end_seconds": 141.96363636363634,
      "text": "The soldiers had weapons made"
    },
    {
      "start_seconds": 141.99999999999997,
      "end_seconds": 143.4181818181818,
      "text": "to deliver sustained fire."
    },
    {
      "start_seconds": 143.70909090909092,
      "end_seconds": 144.24272727272725,
      "text": "But that meant"
    },
    {
      "start_seconds": 144.29090909090908,
      "end_seconds": 145.3090909090909,
      "text": "little when the targets"
    },
    {
      "start_seconds": 145.4181818181818,
      "end_seconds": 146.1090909090909,
      "text": "kept scattering."
    },
    {
      "start_seconds": 146.6909090909091,
      "end_seconds": 147.4909090909091,
      "text": "And then came"
    },
    {
      "start_seconds": 147.5272727272727,
      "end_seconds": 148.87272727272725,
      "text": "the opportunity at the dam."
    },
    {
      "start_seconds": 149.38181818181818,
      "end_seconds": 150.61818181818182,
      "text": "Around a thousand emus"
    },
    {
      "start_seconds": 150.72727272727272,
      "end_seconds": 151.78181818181818,
      "text": "were gathered near the water."
    },
    {
      "start_seconds": 152.36363636363635,
      "end_seconds": 153.81818181818178,
      "text": "This time the soldiers waited"
    },
    {
      "start_seconds": 153.96363636363637,
      "end_seconds": 154.76363636363635,
      "text": "until they were close"
    },
    {
      "start_seconds": 154.83636363636361,
      "end_seconds": 155.56363636363636,
      "text": "before firing."
    },
    {
      "start_seconds": 156.07272727272726,
      "end_seconds": 157.45454545454544,
      "text": "But after roughly a dozen birds"
    },
    {
      "start_seconds": 157.5272727272727,
      "end_seconds": 159.1272727272727,
      "text": "were killed, a gun jammed."
    },
    {
      "start_seconds": 159.56363636363636,
      "end_seconds": 160.58181818181816,
      "text": "The flock escaped."
    },
    {
      "start_seconds": 161.09090909090907,
      "end_seconds": 162.25454545454542,
      "text": "The men had found the large"
    },
    {
      "start_seconds": 162.3272727272727,
      "end_seconds": 163.12727272727273,
      "text": "target they needed."
    },
    {
      "start_seconds": 163.56363636363633,
      "end_seconds": 164.2181818181818,
      "text": "And lost it."
    },
    {
      "start_seconds": 164.87272727272727,
      "end_seconds": 165.45454545454544,
      "text": "So they tried"
    },
    {
      "start_seconds": 165.52727272727273,
      "end_seconds": 166.1818181818182,
      "text": "something different."
    },
    {
      "start_seconds": 166.6909090909091,
      "end_seconds": 167.34545454545454,
      "text": "They put a machine"
    },
    {
      "start_seconds": 167.4181818181818,
      "end_seconds": 168.58181818181816,
      "text": "gun on the back of a truck."
    },
    {
      "start_seconds": 169.09090909090907,
      "end_seconds": 169.96363636363637,
      "text": "If they couldn't get the birds"
    },
    {
      "start_seconds": 170.0363636363636,
      "end_seconds": 171.12727272727273,
      "text": "to come to the guns,"
    },
    {
      "start_seconds": 171.17545454545453,
      "end_seconds": 171.99999999999997,
      "text": "they could take the gun"
    },
    {
      "start_seconds": 172.07272727272726,
      "end_seconds": 172.8,
      "text": "after the birds."
    },
    {
      "start_seconds": 173.30909090909088,
      "end_seconds": 174.47272727272724,
      "text": "There was just one problem."
    },
    {
      "start_seconds": 174.98181818181817,
      "end_seconds": 176.36363636363635,
      "text": "Emus can run fast."
    },
    {
      "start_seconds": 176.79999999999998,
      "end_seconds": 177.5272727272727,
      "text": "The truck couldn't"
    },
    {
      "start_seconds": 177.6,
      "end_seconds": 178.76363636363632,
      "text": "keep up over the rough ground."
    },
    {
      "start_seconds": 179.27272727272725,
      "end_seconds": 179.9272727272727,
      "text": "It jolted"
    },
    {
      "start_seconds": 180.0363636363636,
      "end_seconds": 181.16363636363636,
      "text": "so badly that the gunner"
    },
    {
      "start_seconds": 181.27272727272725,
      "end_seconds": 182.03636363636363,
      "text": "struggled to aim."
    },
    {
      "start_seconds": 182.50909090909087,
      "end_seconds": 182.98181818181817,
      "text": "A machine"
    },
    {
      "start_seconds": 183.05454545454546,
      "end_seconds": 183.9272727272727,
      "text": "gun was now bouncing"
    },
    {
      "start_seconds": 184.0,
      "end_seconds": 185.67272727272726,
      "text": "across the countryside, chasing"
    },
    {
      "start_seconds": 185.8181818181818,
      "end_seconds": 187.05454545454543,
      "text": "birds it could barely reach."
    },
    {
      "start_seconds": 187.56363636363633,
      "end_seconds": 189.3090909090909,
      "text": "The soldiers kept trying."
    },
    {
      "start_seconds": 189.45454545454544,
      "end_seconds": 190.25454545454545,
      "text": "But each encounter"
    },
    {
      "start_seconds": 190.3272727272727,
      "end_seconds": 191.85454545454544,
      "text": "ended much the same way:"
    },
    {
      "start_seconds": 191.9272727272727,
      "end_seconds": 193.6,
      "text": "a burst of gunfire, birds"
    },
    {
      "start_seconds": 193.67272727272726,
      "end_seconds": 195.2,
      "text": "scattering, and more emus"
    },
    {
      "start_seconds": 195.27272727272728,
      "end_seconds": 197.0181818181818,
      "text": "disappearing over the fields."
    },
    {
      "start_seconds": 197.0909090909091,
      "end_seconds": 198.1090909090909,
      "text": "Their commander, Major"
    },
    {
      "start_seconds": 198.18181818181816,
      "end_seconds": 199.49090909090907,
      "text": "Meredith, compared the birds'"
    },
    {
      "start_seconds": 199.56363636363636,
      "end_seconds": 201.16363636363636,
      "text": "ability to withstand gunfire"
    },
    {
      "start_seconds": 201.23636363636362,
      "end_seconds": 202.6909090909091,
      "text": "to that of tanks."
    },
    {
      "start_seconds": 202.76363636363635,
      "end_seconds": 203.70909090909092,
      "text": "Back in Canberra,"
    },
    {
      "start_seconds": 203.78181818181815,
      "end_seconds": 204.94545454545454,
      "text": "the operation was attracting"
    },
    {
      "start_seconds": 205.09090909090907,
      "end_seconds": 206.6909090909091,
      "text": "a different kind of attention."
    },
    {
      "start_seconds": 206.88454545454545,
      "end_seconds": 207.74545454545455,
      "text": "Politicians questioned"
    },
    {
      "start_seconds": 207.78181818181818,
      "end_seconds": 208.79999999999998,
      "text": "the campaign."
    },
    {
      "start_seconds": 208.87272727272725,
      "end_seconds": 210.1090909090909,
      "text": "One joked that if anyone"
    },
    {
      "start_seconds": 210.18181818181816,
      "end_seconds": 210.98181818181817,
      "text": "deserved medals,"
    },
    {
      "start_seconds": 211.03,
      "end_seconds": 212.29090909090908,
      "text": "it was the emus."
    },
    {
      "start_seconds": 212.43636363636364,
      "end_seconds": 213.45454545454544,
      "text": "A few days after the failed"
    },
    {
      "start_seconds": 213.5272727272727,
      "end_seconds": 214.61818181818182,
      "text": "ambush, the government"
    },
    {
      "start_seconds": 214.76363636363635,
      "end_seconds": 216.07272727272726,
      "text": "recalled the soldiers."
    },
    {
      "start_seconds": 216.14545454545453,
      "end_seconds": 216.9454545454545,
      "text": "In Canberra,"
    },
    {
      "start_seconds": 217.04272727272726,
      "end_seconds": 218.54545454545453,
      "text": "the shooting was over."
    },
    {
      "start_seconds": 218.6181818181818,
      "end_seconds": 219.05454545454543,
      "text": "In the farming"
    },
    {
      "start_seconds": 219.1272727272727,
      "end_seconds": 220.14545454545453,
      "text": "district, the birds"
    },
    {
      "start_seconds": 220.21818181818182,
      "end_seconds": 221.8181818181818,
      "text": "were still eating wheat."
    },
    {
      "start_seconds": 221.89090909090908,
      "end_seconds": 223.05454545454546,
      "text": "The soldiers had gone,"
    },
    {
      "start_seconds": 223.10272727272726,
      "end_seconds": 224.87272727272727,
      "text": "but the damage hadn't stopped."
    },
    {
      "start_seconds": 224.94545454545454,
      "end_seconds": 226.76363636363635,
      "text": "Fences were still being broken."
    },
    {
      "start_seconds": 226.83636363636361,
      "end_seconds": 228.5090909090909,
      "text": "Crops were still at risk."
    },
    {
      "start_seconds": 228.58181818181816,
      "end_seconds": 229.96363636363634,
      "text": "The birds were still moving"
    },
    {
      "start_seconds": 230.0363636363636,
      "end_seconds": 231.12727272727273,
      "text": "through the district."
    },
    {
      "start_seconds": 231.2,
      "end_seconds": 231.78181818181818,
      "text": "The farmers"
    },
    {
      "start_seconds": 231.85454545454542,
      "end_seconds": 233.09090909090907,
      "text": "asked for help again."
    },
    {
      "start_seconds": 233.13909090909087,
      "end_seconds": 234.10909090909087,
      "text": "And the government agreed"
    },
    {
      "start_seconds": 234.14545454545453,
      "end_seconds": 235.41818181818178,
      "text": "to another attempt."
    },
    {
      "start_seconds": 235.4909090909091,
      "end_seconds": 236.36363636363635,
      "text": "So the soldiers"
    },
    {
      "start_seconds": 236.4363636363636,
      "end_seconds": 237.96363636363634,
      "text": "returned with their guns."
    },
    {
      "start_seconds": 238.0363636363636,
      "end_seconds": 238.6909090909091,
      "text": "This time,"
    },
    {
      "start_seconds": 238.78818181818178,
      "end_seconds": 240.43636363636364,
      "text": "they killed more emus."
    },
    {
      "start_seconds": 240.5090909090909,
      "end_seconds": 241.0181818181818,
      "text": "But the work"
    },
    {
      "start_seconds": 241.09090909090907,
      "end_seconds": 242.76363636363635,
      "text": "dragged on for weeks."
    },
    {
      "start_seconds": 242.83636363636361,
      "end_seconds": 243.56363636363636,
      "text": "The birds were spread"
    },
    {
      "start_seconds": 243.63636363636363,
      "end_seconds": 245.0909090909091,
      "text": "across too much country,"
    },
    {
      "start_seconds": 245.1390909090909,
      "end_seconds": 246.25454545454542,
      "text": "and the soldiers had to find"
    },
    {
      "start_seconds": 246.32727272727269,
      "end_seconds": 247.78181818181815,
      "text": "them before they could fire."
    },
    {
      "start_seconds": 247.85454545454542,
      "end_seconds": 248.43636363636358,
      "text": "Even when the guns"
    },
    {
      "start_seconds": 248.5090909090909,
      "end_seconds": 249.4545454545454,
      "text": "were successful,"
    },
    {
      "start_seconds": 249.52727272727273,
      "end_seconds": 250.54545454545453,
      "text": "another group of emus"
    },
    {
      "start_seconds": 250.6181818181818,
      "end_seconds": 252.14545454545453,
      "text": "could turn up somewhere else."
    },
    {
      "start_seconds": 252.24272727272725,
      "end_seconds": 253.5272727272727,
      "text": "By December, hundreds"
    },
    {
      "start_seconds": 253.59999999999997,
      "end_seconds": 254.98181818181817,
      "text": "of birds had been killed."
    },
    {
      "start_seconds": 255.05454545454543,
      "end_seconds": 256.3636363636363,
      "text": "Even so, thousands"
    },
    {
      "start_seconds": 256.47272727272724,
      "end_seconds": 257.7454545454545,
      "text": "remained in the district."
    },
    {
      "start_seconds": 257.8181818181818,
      "end_seconds": 258.6909090909091,
      "text": "The shooting hadn't"
    },
    {
      "start_seconds": 258.8363636363636,
      "end_seconds": 260.0,
      "text": "stopped the damage."
    },
    {
      "start_seconds": 260.07272727272726,
      "end_seconds": 262.10909090909087,
      "text": "The army ended its campaign."
    },
    {
      "start_seconds": 262.1572727272727,
      "end_seconds": 262.98181818181814,
      "text": "For the farmers,"
    },
    {
      "start_seconds": 263.03000000000003,
      "end_seconds": 264.7272727272727,
      "text": "there was no dramatic finish."
    },
    {
      "start_seconds": 264.79999999999995,
      "end_seconds": 265.7454545454545,
      "text": "They still needed ways"
    },
    {
      "start_seconds": 265.81818181818176,
      "end_seconds": 267.2,
      "text": "to protect their fields."
    },
    {
      "start_seconds": 267.27272727272725,
      "end_seconds": 268.4363636363636,
      "text": "In the years that followed,"
    },
    {
      "start_seconds": 268.5090909090909,
      "end_seconds": 269.59999999999997,
      "text": "people continued killing"
    },
    {
      "start_seconds": 269.67272727272723,
      "end_seconds": 271.1272727272727,
      "text": "emus for bounty payments,"
    },
    {
      "start_seconds": 271.2,
      "end_seconds": 271.99999999999994,
      "text": "while fences remained"
    },
    {
      "start_seconds": 272.0727272727272,
      "end_seconds": 273.96363636363634,
      "text": "important for protecting crops."
    },
    {
      "start_seconds": 274.06090909090904,
      "end_seconds": 274.8363636363636,
      "text": "For the birds,"
    },
    {
      "start_seconds": 274.88454545454545,
      "end_seconds": 276.7272727272727,
      "text": "the campaign had been deadly."
    },
    {
      "start_seconds": 276.8727272727273,
      "end_seconds": 278.1090909090909,
      "text": "Many had been shot."
    },
    {
      "start_seconds": 278.1818181818182,
      "end_seconds": 279.27272727272725,
      "text": "But thousands remained"
    },
    {
      "start_seconds": 279.3454545454545,
      "end_seconds": 280.07272727272726,
      "text": "across the region."
    },
    {
      "start_seconds": 280.29090909090905,
      "end_seconds": 281.67272727272723,
      "text": "Australia had sent soldiers"
    },
    {
      "start_seconds": 281.74545454545455,
      "end_seconds": 283.05454545454546,
      "text": "into farmland with machine"
    },
    {
      "start_seconds": 283.1272727272727,
      "end_seconds": 284.2909090909091,
      "text": "guns to stop the birds"
    },
    {
      "start_seconds": 284.3636363636364,
      "end_seconds": 285.30909090909086,
      "text": "from destroying the wheat."
    },
    {
      "start_seconds": 285.8909090909091,
      "end_seconds": 287.56363636363636,
      "text": "The soldiers had fired, chased,"
    },
    {
      "start_seconds": 288.0,
      "end_seconds": 289.16363636363633,
      "text": "withdrawn, and returned."
    },
    {
      "start_seconds": 289.67272727272723,
      "end_seconds": 290.2545454545454,
      "text": "The farmers"
    },
    {
      "start_seconds": 290.4,
      "end_seconds": 291.3454545454545,
      "text": "still needed protection."
    },
    {
      "start_seconds": 291.9272727272727,
      "end_seconds": 292.94545454545454,
      "text": "The emus had suffered"
    },
    {
      "start_seconds": 293.09090909090907,
      "end_seconds": 293.74545454545455,
      "text": "heavy losses."
    },
    {
      "start_seconds": 294.4,
      "end_seconds": 295.56363636363636,
      "text": "Yet across the wheat-growing"
    },
    {
      "start_seconds": 295.78181818181815,
      "end_seconds": 297.2363636363636,
      "text": "district, the birds continued"
    },
    {
      "start_seconds": 297.3090909090909,
      "end_seconds": 298.5454545454545,
      "text": "searching for food and water."
    },
    {
      "start_seconds": 299.0545454545454,
      "end_seconds": 300.0727272727272,
      "text": "The soldiers were gone."
    },
    {
      "start_seconds": 300.5090909090909,
      "end_seconds": 301.8909090909091,
      "text": "And the emus kept coming."
    }
  ]
}
