{
  "cues": [
    {
      "start_seconds": "0.0000",
      "end_seconds": "1.0909",
      "text": "In 1878,"
    },
    {
      "start_seconds": "1.4545",
      "end_seconds": "2.7636",
      "text": "Anandibai Joshee's infant"
    },
    {
      "start_seconds": "2.8364",
      "end_seconds": "4.8727",
      "text": "son died after just ten days."
    },
    {
      "start_seconds": "5.4545",
      "end_seconds": "6.4727",
      "text": "She believed better medical"
    },
    {
      "start_seconds": "6.5455",
      "end_seconds": "7.5636",
      "text": "care might have saved him."
    },
    {
      "start_seconds": "8.1818",
      "end_seconds": "9.0182",
      "text": "His death helped shape"
    },
    {
      "start_seconds": "9.0909",
      "end_seconds": "10.0364",
      "text": "a decision that would take"
    },
    {
      "start_seconds": "10.1455",
      "end_seconds": "11.2000",
      "text": "her thousands of miles"
    },
    {
      "start_seconds": "11.2727",
      "end_seconds": "12.5818",
      "text": "from India: she wanted"
    },
    {
      "start_seconds": "12.6545",
      "end_seconds": "13.9636",
      "text": "to study medicine in the United"
    },
    {
      "start_seconds": "14.2182",
      "end_seconds": "15.3455",
      "text": "States and become a doctor."
    },
    {
      "start_seconds": "16.0000",
      "end_seconds": "17.1636",
      "text": "Joshee had a particular"
    },
    {
      "start_seconds": "17.3818",
      "end_seconds": "17.6000",
      "text": "purpose."
    },
    {
      "start_seconds": "18.1091",
      "end_seconds": "18.9818",
      "text": "Some women in India"
    },
    {
      "start_seconds": "19.0909",
      "end_seconds": "20.0727",
      "text": "would not accept treatment"
    },
    {
      "start_seconds": "20.1455",
      "end_seconds": "21.3818",
      "text": "from male physicians."
    },
    {
      "start_seconds": "21.5273",
      "end_seconds": "22.2545",
      "text": "She wanted to be able"
    },
    {
      "start_seconds": "22.3273",
      "end_seconds": "23.7091",
      "text": "to treat those women herself."
    },
    {
      "start_seconds": "24.4000",
      "end_seconds": "26.4727",
      "text": "On February 24, 1883,"
    },
    {
      "start_seconds": "26.9091",
      "end_seconds": "28.1455",
      "text": "Joshee publicly explained"
    },
    {
      "start_seconds": "28.2182",
      "end_seconds": "29.7455",
      "text": "her plan in Serampore, India."
    },
    {
      "start_seconds": "30.3273",
      "end_seconds": "31.2000",
      "text": "She addressed concerns"
    },
    {
      "start_seconds": "31.2727",
      "end_seconds": "32.7273",
      "text": "about women studying medicine"
    },
    {
      "start_seconds": "32.8000",
      "end_seconds": "33.7455",
      "text": "and about her intention"
    },
    {
      "start_seconds": "33.8182",
      "end_seconds": "35.2727",
      "text": "to travel overseas."
    },
    {
      "start_seconds": "35.3700",
      "end_seconds": "35.9273",
      "text": "She acknowledged"
    },
    {
      "start_seconds": "36.0364",
      "end_seconds": "36.6545",
      "text": "that some medical"
    },
    {
      "start_seconds": "36.9091",
      "end_seconds": "37.8182",
      "text": "instruction was available"
    },
    {
      "start_seconds": "37.8545",
      "end_seconds": "39.1273",
      "text": "in India, but considered"
    },
    {
      "start_seconds": "39.2000",
      "end_seconds": "40.5091",
      "text": "it inadequate for the thorough"
    },
    {
      "start_seconds": "40.6909",
      "end_seconds": "41.8182",
      "text": "training she wanted."
    },
    {
      "start_seconds": "41.9636",
      "end_seconds": "42.5455",
      "text": "She also hoped"
    },
    {
      "start_seconds": "42.5818",
      "end_seconds": "43.4182",
      "text": "to return with medical"
    },
    {
      "start_seconds": "43.4909",
      "end_seconds": "44.5091",
      "text": "knowledge and establish"
    },
    {
      "start_seconds": "44.8000",
      "end_seconds": "46.0364",
      "text": "instruction for women."
    },
    {
      "start_seconds": "46.3273",
      "end_seconds": "48.0000",
      "text": "Travel raised another concern."
    },
    {
      "start_seconds": "48.1455",
      "end_seconds": "49.2364",
      "text": "Going overseas could lead"
    },
    {
      "start_seconds": "49.3091",
      "end_seconds": "50.6909",
      "text": "to exclusion from her religious"
    },
    {
      "start_seconds": "50.8000",
      "end_seconds": "52.0727",
      "text": "and social community."
    },
    {
      "start_seconds": "52.2182",
      "end_seconds": "53.5273",
      "text": "Joshee intended to remain"
    },
    {
      "start_seconds": "53.5636",
      "end_seconds": "55.0545",
      "text": "Hindu, keep her customs,"
    },
    {
      "start_seconds": "55.1273",
      "end_seconds": "56.5091",
      "text": "and return to India."
    },
    {
      "start_seconds": "56.6064",
      "end_seconds": "57.4545",
      "text": "Her husband supported"
    },
    {
      "start_seconds": "57.4909",
      "end_seconds": "58.7636",
      "text": "her education and expected"
    },
    {
      "start_seconds": "58.8364",
      "end_seconds": "59.9273",
      "text": "to send money."
    },
    {
      "start_seconds": "60.0000",
      "end_seconds": "60.8727",
      "text": "By late June,"
    },
    {
      "start_seconds": "60.9455",
      "end_seconds": "61.7455",
      "text": "Joshee had reached"
    },
    {
      "start_seconds": "61.8545",
      "end_seconds": "63.1273",
      "text": "Roselle, New Jersey."
    },
    {
      "start_seconds": "63.2000",
      "end_seconds": "63.6364",
      "text": "But crossing"
    },
    {
      "start_seconds": "63.7091",
      "end_seconds": "65.0909",
      "text": "the ocean had not yet secured"
    },
    {
      "start_seconds": "65.1636",
      "end_seconds": "65.6000",
      "text": "her a place"
    },
    {
      "start_seconds": "65.6364",
      "end_seconds": "66.9091",
      "text": "at a medical college."
    },
    {
      "start_seconds": "66.9818",
      "end_seconds": "69.4545",
      "text": "On June 28, 1883, she wrote"
    },
    {
      "start_seconds": "69.5273",
      "end_seconds": "70.6909",
      "text": "to the Woman's Medical College"
    },
    {
      "start_seconds": "70.7636",
      "end_seconds": "72.5091",
      "text": "of Pennsylvania in Philadelphia,"
    },
    {
      "start_seconds": "72.5818",
      "end_seconds": "73.7455",
      "text": "seeking admission on terms"
    },
    {
      "start_seconds": "73.8182",
      "end_seconds": "74.8364",
      "text": "she could afford."
    },
    {
      "start_seconds": "74.9818",
      "end_seconds": "75.6000",
      "text": "She had seventy"
    },
    {
      "start_seconds": "75.6364",
      "end_seconds": "76.9455",
      "text": "dollars and expected twenty"
    },
    {
      "start_seconds": "77.0182",
      "end_seconds": "77.6000",
      "text": "dollars a month"
    },
    {
      "start_seconds": "77.6727",
      "end_seconds": "79.2000",
      "text": "from her husband, less the cost"
    },
    {
      "start_seconds": "79.2727",
      "end_seconds": "80.5818",
      "text": "of transferring the money."
    },
    {
      "start_seconds": "80.6909",
      "end_seconds": "82.1091",
      "text": "By October, she was enrolled"
    },
    {
      "start_seconds": "82.1818",
      "end_seconds": "83.3455",
      "text": "in Philadelphia."
    },
    {
      "start_seconds": "83.4182",
      "end_seconds": "85.3091",
      "text": "In 1884, Joshee suffered"
    },
    {
      "start_seconds": "85.3455",
      "end_seconds": "86.6182",
      "text": "diphtheria and struggled"
    },
    {
      "start_seconds": "86.6545",
      "end_seconds": "88.2182",
      "text": "to obtain familiar food."
    },
    {
      "start_seconds": "88.4364",
      "end_seconds": "89.4545",
      "text": "Rachel Bodley, the dean"
    },
    {
      "start_seconds": "89.5273",
      "end_seconds": "90.5455",
      "text": "of the medical college,"
    },
    {
      "start_seconds": "90.6182",
      "end_seconds": "91.4909",
      "text": "helped her with housing"
    },
    {
      "start_seconds": "91.5273",
      "end_seconds": "92.7273",
      "text": "and familiar food."
    },
    {
      "start_seconds": "92.8727",
      "end_seconds": "94.2545",
      "text": "Joshee lived in Bodley's home"
    },
    {
      "start_seconds": "94.2909",
      "end_seconds": "95.4182",
      "text": "for the remainder of her stay"
    },
    {
      "start_seconds": "95.4909",
      "end_seconds": "96.6545",
      "text": "in Philadelphia."
    },
    {
      "start_seconds": "96.7273",
      "end_seconds": "98.0364",
      "text": "Joshee continued her studies"
    },
    {
      "start_seconds": "98.1091",
      "end_seconds": "99.8545",
      "text": "and completed five terms."
    },
    {
      "start_seconds": "100.0000",
      "end_seconds": "102.1091",
      "text": "In March 1886, she graduated"
    },
    {
      "start_seconds": "102.1818",
      "end_seconds": "103.0545",
      "text": "from the Woman's Medical"
    },
    {
      "start_seconds": "103.2364",
      "end_seconds": "104.6545",
      "text": "College of Pennsylvania."
    },
    {
      "start_seconds": "104.8000",
      "end_seconds": "105.2364",
      "text": "Her thesis"
    },
    {
      "start_seconds": "105.3455",
      "end_seconds": "106.6182",
      "text": "concerned obstetrics,"
    },
    {
      "start_seconds": "106.6909",
      "end_seconds": "107.7818",
      "text": "the branch of medicine dealing"
    },
    {
      "start_seconds": "107.8545",
      "end_seconds": "109.6727",
      "text": "with pregnancy and childbirth."
    },
    {
      "start_seconds": "109.7455",
      "end_seconds": "110.6182",
      "text": "She became the first"
    },
    {
      "start_seconds": "110.6909",
      "end_seconds": "111.4182",
      "text": "woman from India"
    },
    {
      "start_seconds": "111.4909",
      "end_seconds": "112.7273",
      "text": "to earn a degree in Western"
    },
    {
      "start_seconds": "112.9455",
      "end_seconds": "114.6182",
      "text": "medicine in the United States."
    },
    {
      "start_seconds": "114.6909",
      "end_seconds": "116.2909",
      "text": "After graduation, she pursued"
    },
    {
      "start_seconds": "116.3273",
      "end_seconds": "117.4545",
      "text": "further training, beginning"
    },
    {
      "start_seconds": "117.6000",
      "end_seconds": "118.6909",
      "text": "a six-month internship"
    },
    {
      "start_seconds": "118.7636",
      "end_seconds": "120.2182",
      "text": "at New England Hospital."
    },
    {
      "start_seconds": "120.2909",
      "end_seconds": "121.5273",
      "text": "Illness forced her to leave"
    },
    {
      "start_seconds": "121.6727",
      "end_seconds": "122.9818",
      "text": "before she could complete it."
    },
    {
      "start_seconds": "123.0545",
      "end_seconds": "123.3455",
      "text": "She then"
    },
    {
      "start_seconds": "123.4182",
      "end_seconds": "124.2909",
      "text": "accepted an appointment"
    },
    {
      "start_seconds": "124.3636",
      "end_seconds": "125.9636",
      "text": "in India as physician in charge"
    },
    {
      "start_seconds": "126.0000",
      "end_seconds": "127.3455",
      "text": "of the women's ward at Albert"
    },
    {
      "start_seconds": "127.4909",
      "end_seconds": "129.0182",
      "text": "Edward Hospital in Kolhapur."
    },
    {
      "start_seconds": "129.0909",
      "end_seconds": "130.6909",
      "text": "In October 1886,"
    },
    {
      "start_seconds": "131.0545",
      "end_seconds": "132.2909",
      "text": "Joshee sailed for India."
    },
    {
      "start_seconds": "132.8000",
      "end_seconds": "133.8909",
      "text": "She arrived in November,"
    },
    {
      "start_seconds": "134.3273",
      "end_seconds": "135.1273",
      "text": "seriously ill."
    },
    {
      "start_seconds": "135.7091",
      "end_seconds": "137.9636",
      "text": "On February 26, 1887,"
    },
    {
      "start_seconds": "138.3273",
      "end_seconds": "140.1455",
      "text": "Anandibai Joshee died in Pune."
    },
    {
      "start_seconds": "140.7273",
      "end_seconds": "141.7455",
      "text": "She had earned her medical"
    },
    {
      "start_seconds": "141.9273",
      "end_seconds": "143.2000",
      "text": "degree, accepted a hospital"
    },
    {
      "start_seconds": "143.2727",
      "end_seconds": "144.5091",
      "text": "appointment, and returned"
    },
    {
      "start_seconds": "144.5818",
      "end_seconds": "145.0909",
      "text": "to the country"
    },
    {
      "start_seconds": "145.1636",
      "end_seconds": "146.1818",
      "text": "where she hoped to serve."
    },
    {
      "start_seconds": "146.7636",
      "end_seconds": "147.3455",
      "text": "But she died"
    },
    {
      "start_seconds": "147.4182",
      "end_seconds": "148.2182",
      "text": "before she could begin"
    },
    {
      "start_seconds": "148.2909",
      "end_seconds": "149.3091",
      "text": "practicing medicine there."
    }
  ]
}
