{
  "cues": [
    {
      "start_seconds": "0.0800",
      "end_seconds": "0.9000",
      "text": "In 1878,"
    },
    {
      "start_seconds": "1.4600",
      "end_seconds": "2.8200",
      "text": "Anandibai Joshee's infant"
    },
    {
      "start_seconds": "2.8800",
      "end_seconds": "4.8010",
      "text": "son died after just ten days."
    },
    {
      "start_seconds": "5.4210",
      "end_seconds": "6.5210",
      "text": "She believed better medical"
    },
    {
      "start_seconds": "6.5610",
      "end_seconds": "7.5410",
      "text": "care might have saved him."
    },
    {
      "start_seconds": "8.1210",
      "end_seconds": "9.0610",
      "text": "His death helped shape"
    },
    {
      "start_seconds": "9.0810",
      "end_seconds": "10.0410",
      "text": "a decision that would take"
    },
    {
      "start_seconds": "10.0610",
      "end_seconds": "11.2010",
      "text": "her thousands of miles"
    },
    {
      "start_seconds": "11.2410",
      "end_seconds": "12.6420",
      "text": "from India: she wanted"
    },
    {
      "start_seconds": "12.6620",
      "end_seconds": "13.9820",
      "text": "to study medicine in the United"
    },
    {
      "start_seconds": "14.0220",
      "end_seconds": "15.3420",
      "text": "States and become a doctor."
    },
    {
      "start_seconds": "15.9820",
      "end_seconds": "17.1420",
      "text": "Joshee had a particular"
    },
    {
      "start_seconds": "17.1820",
      "end_seconds": "17.5420",
      "text": "purpose."
    },
    {
      "start_seconds": "18.1220",
      "end_seconds": "18.9620",
      "text": "Some women in India"
    },
    {
      "start_seconds": "19.0220",
      "end_seconds": "20.0630",
      "text": "would not accept treatment"
    },
    {
      "start_seconds": "20.1030",
      "end_seconds": "20.9230",
      "text": "from male physicians."
    },
    {
      "start_seconds": "21.4430",
      "end_seconds": "22.2830",
      "text": "She wanted to be able"
    },
    {
      "start_seconds": "22.3030",
      "end_seconds": "23.6630",
      "text": "to treat those women herself."
    },
    {
      "start_seconds": "24.4030",
      "end_seconds": "26.5630",
      "text": "On February 24, 1883,"
    },
    {
      "start_seconds": "26.9430",
      "end_seconds": "28.1640",
      "text": "Joshee publicly explained"
    },
    {
      "start_seconds": "28.2040",
      "end_seconds": "29.7840",
      "text": "her plan in Serampore, India."
    },
    {
      "start_seconds": "30.3240",
      "end_seconds": "31.2440",
      "text": "She addressed concerns"
    },
    {
      "start_seconds": "31.2840",
      "end_seconds": "32.5440",
      "text": "about women studying medicine"
    },
    {
      "start_seconds": "32.8440",
      "end_seconds": "33.7840",
      "text": "and about her intention"
    },
    {
      "start_seconds": "33.8040",
      "end_seconds": "34.7240",
      "text": "to travel overseas."
    },
    {
      "start_seconds": "35.3450",
      "end_seconds": "35.9050",
      "text": "She acknowledged"
    },
    {
      "start_seconds": "35.9450",
      "end_seconds": "36.7050",
      "text": "that some medical"
    },
    {
      "start_seconds": "36.7250",
      "end_seconds": "37.8450",
      "text": "instruction was available"
    },
    {
      "start_seconds": "37.8650",
      "end_seconds": "39.1650",
      "text": "in India, but considered"
    },
    {
      "start_seconds": "39.2050",
      "end_seconds": "40.4850",
      "text": "it inadequate for the thorough"
    },
    {
      "start_seconds": "40.5450",
      "end_seconds": "41.3250",
      "text": "training she wanted."
    },
    {
      "start_seconds": "41.8850",
      "end_seconds": "42.5850",
      "text": "She also hoped"
    },
    {
      "start_seconds": "42.6050",
      "end_seconds": "43.4660",
      "text": "to return with medical"
    },
    {
      "start_seconds": "43.5060",
      "end_seconds": "44.5460",
      "text": "knowledge and establish"
    },
    {
      "start_seconds": "44.5860",
      "end_seconds": "45.4860",
      "text": "instruction for women."
    },
    {
      "start_seconds": "46.1060",
      "end_seconds": "47.5860",
      "text": "Travel raised another concern."
    },
    {
      "start_seconds": "48.1260",
      "end_seconds": "49.2660",
      "text": "Going overseas could lead"
    },
    {
      "start_seconds": "49.3060",
      "end_seconds": "50.7070",
      "text": "to exclusion from her religious"
    },
    {
      "start_seconds": "50.7670",
      "end_seconds": "51.6270",
      "text": "and social community."
    },
    {
      "start_seconds": "52.2070",
      "end_seconds": "53.5270",
      "text": "Joshee intended to remain"
    },
    {
      "start_seconds": "53.5470",
      "end_seconds": "54.8870",
      "text": "Hindu, keep her customs,"
    },
    {
      "start_seconds": "55.1270",
      "end_seconds": "56.0470",
      "text": "and return to India."
    },
    {
      "start_seconds": "56.5670",
      "end_seconds": "57.4670",
      "text": "Her husband supported"
    },
    {
      "start_seconds": "57.4870",
      "end_seconds": "58.8080",
      "text": "her education and expected"
    },
    {
      "start_seconds": "58.8480",
      "end_seconds": "59.3880",
      "text": "to send money."
    },
    {
      "start_seconds": "59.9880",
      "end_seconds": "60.6880",
      "text": "By late June,"
    },
    {
      "start_seconds": "60.9480",
      "end_seconds": "61.7080",
      "text": "Joshee had reached"
    },
    {
      "start_seconds": "61.7880",
      "end_seconds": "62.7080",
      "text": "Roselle, New Jersey."
    },
    {
      "start_seconds": "63.1680",
      "end_seconds": "63.6880",
      "text": "But crossing"
    },
    {
      "start_seconds": "63.7080",
      "end_seconds": "65.1280",
      "text": "the ocean had not yet secured"
    },
    {
      "start_seconds": "65.1680",
      "end_seconds": "65.6280",
      "text": "her a place"
    },
    {
      "start_seconds": "65.6680",
      "end_seconds": "66.4290",
      "text": "at a medical college."
    },
    {
      "start_seconds": "67.0290",
      "end_seconds": "69.5290",
      "text": "On June 28, 1883, she wrote"
    },
    {
      "start_seconds": "69.5490",
      "end_seconds": "70.7090",
      "text": "to the Woman's Medical College"
    },
    {
      "start_seconds": "70.7290",
      "end_seconds": "72.2290",
      "text": "of Pennsylvania in Philadelphia,"
    },
    {
      "start_seconds": "72.5490",
      "end_seconds": "73.7690",
      "text": "seeking admission on terms"
    },
    {
      "start_seconds": "73.8090",
      "end_seconds": "74.4100",
      "text": "she could afford."
    },
    {
      "start_seconds": "74.9300",
      "end_seconds": "75.6500",
      "text": "She had seventy"
    },
    {
      "start_seconds": "75.6700",
      "end_seconds": "77.0100",
      "text": "dollars and expected twenty"
    },
    {
      "start_seconds": "77.0500",
      "end_seconds": "77.6300",
      "text": "dollars a month"
    },
    {
      "start_seconds": "77.6700",
      "end_seconds": "79.2100",
      "text": "from her husband, less the cost"
    },
    {
      "start_seconds": "79.2500",
      "end_seconds": "80.1100",
      "text": "of transferring the money."
    },
    {
      "start_seconds": "80.6700",
      "end_seconds": "82.1510",
      "text": "By October, she was enrolled"
    },
    {
      "start_seconds": "82.1710",
      "end_seconds": "83.4910",
      "text": "in Philadelphia."
    },
    {
      "start_seconds": "83.6110",
      "end_seconds": "85.3310",
      "text": "In 1884, Joshee suffered"
    },
    {
      "start_seconds": "85.3710",
      "end_seconds": "86.6310",
      "text": "diphtheria and struggled"
    },
    {
      "start_seconds": "86.6510",
      "end_seconds": "87.7510",
      "text": "to obtain familiar food."
    },
    {
      "start_seconds": "88.3310",
      "end_seconds": "89.5110",
      "text": "Rachel Bodley, the dean"
    },
    {
      "start_seconds": "89.5310",
      "end_seconds": "90.3120",
      "text": "of the medical college,"
    },
    {
      "start_seconds": "90.5920",
      "end_seconds": "91.4520",
      "text": "helped her with housing"
    },
    {
      "start_seconds": "91.5320",
      "end_seconds": "92.2920",
      "text": "and familiar food."
    },
    {
      "start_seconds": "92.8520",
      "end_seconds": "94.2320",
      "text": "Joshee lived in Bodley's home"
    },
    {
      "start_seconds": "94.2720",
      "end_seconds": "95.4320",
      "text": "for the remainder of her stay"
    },
    {
      "start_seconds": "95.4920",
      "end_seconds": "96.1520",
      "text": "in Philadelphia."
    },
    {
      "start_seconds": "96.7320",
      "end_seconds": "97.9930",
      "text": "Joshee continued her studies"
    },
    {
      "start_seconds": "98.1130",
      "end_seconds": "99.3730",
      "text": "and completed five terms."
    },
    {
      "start_seconds": "99.9530",
      "end_seconds": "102.1330",
      "text": "In March 1886, she graduated"
    },
    {
      "start_seconds": "102.1730",
      "end_seconds": "103.0730",
      "text": "from the Woman's Medical"
    },
    {
      "start_seconds": "103.1130",
      "end_seconds": "104.1730",
      "text": "College of Pennsylvania."
    },
    {
      "start_seconds": "104.6930",
      "end_seconds": "105.2540",
      "text": "Her thesis"
    },
    {
      "start_seconds": "105.2940",
      "end_seconds": "106.3340",
      "text": "concerned obstetrics,"
    },
    {
      "start_seconds": "106.6740",
      "end_seconds": "107.8140",
      "text": "the branch of medicine dealing"
    },
    {
      "start_seconds": "107.8340",
      "end_seconds": "109.1740",
      "text": "with pregnancy and childbirth."
    },
    {
      "start_seconds": "109.7540",
      "end_seconds": "110.6340",
      "text": "She became the first"
    },
    {
      "start_seconds": "110.6940",
      "end_seconds": "111.4340",
      "text": "woman from India"
    },
    {
      "start_seconds": "111.4940",
      "end_seconds": "112.7340",
      "text": "to earn a degree in Western"
    },
    {
      "start_seconds": "112.7740",
      "end_seconds": "114.0150",
      "text": "medicine in the United States."
    },
    {
      "start_seconds": "114.6950",
      "end_seconds": "116.2150",
      "text": "After graduation, she pursued"
    },
    {
      "start_seconds": "116.3150",
      "end_seconds": "117.5150",
      "text": "further training, beginning"
    },
    {
      "start_seconds": "117.5550",
      "end_seconds": "118.6350",
      "text": "a six-month internship"
    },
    {
      "start_seconds": "118.7350",
      "end_seconds": "119.7350",
      "text": "at New England Hospital."
    },
    {
      "start_seconds": "120.2750",
      "end_seconds": "121.5160",
      "text": "Illness forced her to leave"
    },
    {
      "start_seconds": "121.5760",
      "end_seconds": "122.5760",
      "text": "before she could complete it."
    },
    {
      "start_seconds": "123.0960",
      "end_seconds": "123.3760",
      "text": "She then"
    },
    {
      "start_seconds": "123.4160",
      "end_seconds": "124.3160",
      "text": "accepted an appointment"
    },
    {
      "start_seconds": "124.3560",
      "end_seconds": "125.9760",
      "text": "in India as physician in charge"
    },
    {
      "start_seconds": "125.9960",
      "end_seconds": "127.3360",
      "text": "of the women's ward at Albert"
    },
    {
      "start_seconds": "127.4160",
      "end_seconds": "128.7370",
      "text": "Edward Hospital in Kolhapur."
    },
    {
      "start_seconds": "129.1370",
      "end_seconds": "130.2770",
      "text": "In October 1886,"
    },
    {
      "start_seconds": "130.9970",
      "end_seconds": "132.2570",
      "text": "Joshee sailed for India."
    },
    {
      "start_seconds": "132.8370",
      "end_seconds": "133.8770",
      "text": "She arrived in November,"
    },
    {
      "start_seconds": "134.3370",
      "end_seconds": "135.0570",
      "text": "seriously ill."
    },
    {
      "start_seconds": "135.7170",
      "end_seconds": "137.9180",
      "text": "On February 26, 1887,"
    },
    {
      "start_seconds": "138.2780",
      "end_seconds": "140.0980",
      "text": "Anandibai Joshee died in Pune."
    },
    {
      "start_seconds": "140.7380",
      "end_seconds": "141.7380",
      "text": "She had earned her medical"
    },
    {
      "start_seconds": "141.7780",
      "end_seconds": "143.2580",
      "text": "degree, accepted a hospital"
    },
    {
      "start_seconds": "143.2780",
      "end_seconds": "144.5190",
      "text": "appointment, and returned"
    },
    {
      "start_seconds": "144.5390",
      "end_seconds": "145.0790",
      "text": "to the country"
    },
    {
      "start_seconds": "145.1190",
      "end_seconds": "146.1190",
      "text": "where she hoped to serve."
    },
    {
      "start_seconds": "146.6790",
      "end_seconds": "147.3190",
      "text": "But she died"
    },
    {
      "start_seconds": "147.3590",
      "end_seconds": "148.1590",
      "text": "before she could begin"
    },
    {
      "start_seconds": "148.2190",
      "end_seconds": "149.2390",
      "text": "practicing medicine there."
    }
  ]
}
