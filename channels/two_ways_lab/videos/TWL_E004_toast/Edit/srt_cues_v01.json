{
  "cues": [
    {
      "start_seconds": 0.01,
      "end_seconds": 1.230708,
      "text": "Three slices of bread."
    },
    {
      "start_seconds": 1.310708,
      "end_seconds": 3.145417,
      "text": "One pan that fits only two."
    },
    {
      "start_seconds": 3.265417,
      "end_seconds": 4.985833,
      "text": "How fast can you toast all three?"
    },
    {
      "start_seconds": 5.105833,
      "end_seconds": 6.567,
      "text": "Each side takes one minute."
    },
    {
      "start_seconds": 6.647,
      "end_seconds": 7.447,
      "text": "In this test,"
    },
    {
      "start_seconds": 7.527,
      "end_seconds": 9.006458,
      "text": "flipping takes no time."
    },
    {
      "start_seconds": 9.166458,
      "end_seconds": 10.446458,
      "text": "First, put two slices"
    },
    {
      "start_seconds": 10.486458,
      "end_seconds": 11.159208,
      "text": "in the pan."
    },
    {
      "start_seconds": 11.279208,
      "end_seconds": 12.039208,
      "text": "After a minute,"
    },
    {
      "start_seconds": 12.159208,
      "end_seconds": 12.972375,
      "text": "flip them both."
    },
    {
      "start_seconds": 13.052375,
      "end_seconds": 13.852375,
      "text": "One more minute,"
    },
    {
      "start_seconds": 13.892375,
      "end_seconds": 14.544792,
      "text": "and they're done."
    },
    {
      "start_seconds": 14.615458,
      "end_seconds": 15.575458,
      "text": "But the third slice"
    },
    {
      "start_seconds": 15.695458,
      "end_seconds": 16.996333,
      "text": "still needs both sides."
    },
    {
      "start_seconds": 17.076333,
      "end_seconds": 18.402542,
      "text": "That's two more minutes."
    },
    {
      "start_seconds": 18.482542,
      "end_seconds": 19.584167,
      "text": "Four minutes in total."
    },
    {
      "start_seconds": 19.664167,
      "end_seconds": 20.724708,
      "text": "Now let's try again."
    },
    {
      "start_seconds": 20.844708,
      "end_seconds": 22.128417,
      "text": "Start with two slices."
    },
    {
      "start_seconds": 22.288417,
      "end_seconds": 23.088417,
      "text": "After one minute,"
    },
    {
      "start_seconds": 23.168417,
      "end_seconds": 24.019708,
      "text": "flip the first."
    },
    {
      "start_seconds": 24.139708,
      "end_seconds": 24.739708,
      "text": "Take the second"
    },
    {
      "start_seconds": 24.819708,
      "end_seconds": 26.099708,
      "text": "out and put the third slice"
    },
    {
      "start_seconds": 26.139708,
      "end_seconds": 26.942833,
      "text": "in its place."
    },
    {
      "start_seconds": 27.102833,
      "end_seconds": 28.062833,
      "text": "After another minute,"
    },
    {
      "start_seconds": 28.142833,
      "end_seconds": 29.31525,
      "text": "the first slice is done."
    },
    {
      "start_seconds": 29.39525,
      "end_seconds": 29.959375,
      "text": "Take it out."
    },
    {
      "start_seconds": 30.039375,
      "end_seconds": 31.399375,
      "text": "Put the second slice back,"
    },
    {
      "start_seconds": 31.479375,
      "end_seconds": 32.759375,
      "text": "uncooked side down,"
    },
    {
      "start_seconds": 32.799375,
      "end_seconds": 33.830375,
      "text": "and flip the third."
    },
    {
      "start_seconds": 33.910375,
      "end_seconds": 34.550375,
      "text": "One more minute,"
    },
    {
      "start_seconds": 34.670375,
      "end_seconds": 36.480417,
      "text": "and all three slices are toasted."
    },
    {
      "start_seconds": 36.600417,
      "end_seconds": 37.586792,
      "text": "Just three minutes."
    },
    {
      "start_seconds": 37.666792,
      "end_seconds": 38.170375,
      "text": "The trick?"
    },
    {
      "start_seconds": 38.250375,
      "end_seconds": 39.210375,
      "text": "You don't have to finish"
    },
    {
      "start_seconds": 39.330375,
      "end_seconds": 40.890375,
      "text": "both slices before making room"
    },
    {
      "start_seconds": 40.930375,
      "end_seconds": 41.770375,
      "text": "for the next one."
    },
    {
      "start_seconds": 41.770375,
      "end_seconds": 42.490375,
      "text": "What would you do"
    },
    {
      "start_seconds": 42.570375,
      "end_seconds": 43.822083,
      "text": "next time you have..."
    }
  ]
}
