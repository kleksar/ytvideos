      "text": "Now split the long roll"
    },
    {
      "start_seconds": 36.798083,
      "end_seconds": 37.449708,
      "text": "in half:"
    },
    {
      "start_seconds": 37.569708,
      "end_seconds": 38.969708,
      "text": "two three-meter pieces,"
    },
    {
      "start_seconds": 39.049708,
      "end_seconds": 40.370375,
      "text": "one for each small gift."
    },
    {
      "start_seconds": 40.437333,
      "end_seconds": 40.848958,
