      "text": "check which pieces fit"
    },
    {
      "start_seconds": 46.710625,
      "end_seconds": 47.502458,
      "text": "on each roll."
    },
    {
      "start_seconds": 47.569,
      "end_seconds": 48.849,
      "text": "Having enough ribbon in total"
    },
    {
      "start_seconds": 49.009,
      "end_seconds": 50.169,
      "text": "isn't always enough."
    },
    {
      "start_seconds": 50.289,
      "end_seconds": 51.969,
      "text": "It matters how you divide it."
    },
    {
      "start_seconds": 51.969,
      "end_seconds": 52.769,
      "text": "What would you do"
    },
    {
      "start_seconds": 52.849,
