      "text": "and one meter left,"
    },
    {
      "start_seconds": 27.390667,
      "end_seconds": 28.070667,
      "text": "and you can't tie"
    },
    {
      "start_seconds": 28.150667,
      "end_seconds": 29.100917,
      "text": "the pieces together."
    },
    {
      "start_seconds": 29.176,
      "end_seconds": 30.307125,
      "text": "Did you run out of ribbon?"
    },
    {
      "start_seconds": 30.387125,
      "end_seconds": 31.190875,
      "text": "Let's try again."
    },
    {
      "start_seconds": 31.26975,
      "end_seconds": 32.22975,
      "text": "For the big gift,"
    },
    {
      "start_seconds": 32.30975,
      "end_seconds": 33.39325,
      "text": "use the short roll."
    },
    {
      "start_seconds": 33.43325,
      "end_seconds": 35.438083,
      "text": "It has exactly four meters."
    },
    {
      "start_seconds": 35.558083,
