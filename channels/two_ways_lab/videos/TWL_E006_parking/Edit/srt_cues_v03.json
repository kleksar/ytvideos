{
  "cues": [
    {
      "start_seconds": 0.01,
      "end_seconds": 0.89,
      "text": "I pull into the store"
    },
    {
      "start_seconds": 0.97,
      "end_seconds": 2.09,
      "text": "parking lot and spot"
    },
    {
      "start_seconds": 2.17,
      "end_seconds": 3.738542,
      "text": "an empty space right away."
    },
    {
      "start_seconds": 3.818542,
      "end_seconds": 5.218167,
      "text": "It's far from the entrance."
    },
    {
      "start_seconds": 5.28525,
      "end_seconds": 6.32525,
      "text": "Should I park here"
    },
    {
      "start_seconds": 6.40525,
      "end_seconds": 7.859708,
      "text": "or look for a closer one?"
    },
    {
      "start_seconds": 7.910292,
      "end_seconds": 9.350792,
      "text": "I decide to compare both."
    },
    {
      "start_seconds": 9.405292,
      "end_seconds": 10.205292,
      "text": "I start the clock"
    },
    {
      "start_seconds": 10.245292,
      "end_seconds": 11.485292,
      "text": "at the parking lot entrance"
    },
    {
      "start_seconds": 11.565292,
      "end_seconds": 13.272833,
      "text": "and stop it at the store doors."
    },
    {
      "start_seconds": 13.359875,
      "end_seconds": 15.08525,
      "text": "First, I take that open space."
    },
    {
      "start_seconds": 15.136208,
