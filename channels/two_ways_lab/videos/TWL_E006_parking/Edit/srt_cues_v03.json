    },
    {
      "start_seconds": 18.914,
      "end_seconds": 19.581542,
      "text": "and a half."
    },
    {
      "start_seconds": 19.668583,
      "end_seconds": 20.548583,
      "text": "I reach the entrance"
    },
    {
      "start_seconds": 20.628583,
      "end_seconds": 21.622708,
      "text": "in two minutes."
    },
    {
      "start_seconds": 21.695375,
      "end_seconds": 23.135375,
      "text": "Now I go back to the start"
    },
    {
      "start_seconds": 23.215375,
      "end_seconds": 24.713708,
      "text": "and try to find a closer spot."
    },
    {
      "start_seconds": 24.728625,
      "end_seconds": 26.066292,
      "text": "I drive past one row."
    },
    {
      "start_seconds": 26.226125,
      "end_seconds": 26.581417,
      "text": "Full."
    },
    {
      "start_seconds": 26.634792,
      "end_seconds": 27.33125,
      "text": "Another row."
    },
    {
      "start_seconds": 27.488917,
      "end_seconds": 28.091375,
      "text": "Full too."
    },
    {
      "start_seconds": 28.207625,
      "end_seconds": 29.967625,
      "text": "Finally, after two minutes,"
    },
    {
      "start_seconds": 30.047625,
      "end_seconds": 31.167625,
      "text": "I see an empty spot"
    },
    {
      "start_seconds": 31.327625,
      "end_seconds": 32.232167,
      "text": "right by the door!"
    },
    {
      "start_seconds": 32.253958,
      "end_seconds": 33.933958,
      "text": "I park, get out and reach"
    },
    {
      "start_seconds": 33.973958,
      "end_seconds": 34.493958,
      "text": "the entrance"
    },
    {
      "start_seconds": 34.573958,
      "end_seconds": 36.074583,
      "text": "after a thirty-second walk."
    },
    {
      "start_seconds": 36.194583,
      "end_seconds": 37.7135,
      "text": "That's definitely closer."
    },
    {
      "start_seconds": 37.8335,
      "end_seconds": 39.2335,
      "text": "But when I check the clock,"
    },
    {
      "start_seconds": 39.3135,
      "end_seconds": 40.3535,
      "text": "three minutes have passed"
    },
    {
      "start_seconds": 40.4335,
      "end_seconds": 41.478625,
      "text": "since I entered the lot."
    },
    {
      "start_seconds": 41.558625,
      "end_seconds": 42.358625,
      "text": "In this test,"
    },
    {
      "start_seconds": 42.478625,
      "end_seconds": 43.398625,
      "text": "parking right away"
    },
    {
      "start_seconds": 43.478625,
      "end_seconds": 44.482,
      "text": "saved me a minute."
    },
    {
      "start_seconds": 44.562,
      "end_seconds": 45.202,
      "text": "But if I'd found"
    },
    {
      "start_seconds": 45.282,
      "end_seconds": 46.802,
      "text": "that closer spot sooner,"
    },
    {
      "start_seconds": 46.842,
      "end_seconds": 48.196542,
      "text": "the result could have been different."
    },
    {
      "start_seconds": 48.316542,
      "end_seconds": 49.316542,
      "text": "Next time, I'll consider"
    },
    {
      "start_seconds": 49.436542,
      "end_seconds": 50.596542,
      "text": "the search time as well"
    },
    {
      "start_seconds": 50.676542,
      "end_seconds": 51.396542,
      "text": "as the walk."
    },
    {
      "start_seconds": 51.396542,
      "end_seconds": 52.705,
      "text": "And once again..."
    }
  ]
