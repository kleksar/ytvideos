      "text": "video."
    },
    {
      "start_seconds": 24.2558,
      "end_seconds": 26.3889,
      "text": "Helicopters fire rockets at buildings."
    },
    {
      "start_seconds": 26.8253,
      "end_seconds": 28.2645,
      "text": "Smoke rises above the buildings."
    },
    {
      "start_seconds": 28.3373,
      "end_seconds": 30.2282,
      "text": "Bukele said the gang leader’s house and the"
    },
    {
      "start_seconds": 30.3736,
      "end_seconds": 31.9427,
      "text": "gang’s headquarters had been destroyed."
    },
    {
      "start_seconds": 32.1609,
      "end_seconds": 33.179,
      "text": "Under the video, he wrote:"
    },
    {
      "start_seconds": 33.5151,
      "end_seconds": 34.6363,
      "text": "“We kept our promise.”"
    },
    {
      "start_seconds": 34.8545,
      "end_seconds": 36.6726,
      "text": "That’s how the president said he’d followed through"
