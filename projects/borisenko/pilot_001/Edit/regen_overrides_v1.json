{
  "overrides": {
    "A007": {
      "source_dir": "/Users/diplomat/ytvideos/projects/borisenko/pilot_001/Source/Voice/regen_variants_v1",
      "text": "Zelensky is ready to concede territory. De facto, it's Ukraine's, like it or not."
    },
    "A015": {
      "source_dir": "/Users/diplomat/ytvideos/projects/borisenko/pilot_001/Source/Voice/regen_variants_v1",
      "text": "We're all related—distantly, very distantly, but related."
    },
    "A032": {
      "source_dir": "/Users/diplomat/ytvideos/projects/borisenko/pilot_001/Source/Voice/regen_variants_v1",
      "text": "And us now? Forgive me, but here's an impertinent question."
    },
    "A036": {
      "source_dir": "/Users/diplomat/ytvideos/projects/borisenko/pilot_001/Source/Voice/regen_variants_v1",
      "text": "How they're treated at the front—you don't need to tell me, respected, or not-so-respected, Mr. President."
    },
    "B008": {
      "source_dir": "/Users/diplomat/ytvideos/projects/borisenko/pilot_001/Source/Voice/regen_variants_v1",
      "text": "Even Kadyrov called him out."
    },
    "B009": {
      "source_dir": "/Users/diplomat/ytvideos/projects/borisenko/pilot_001/Source/Voice/regen_variants_v1",
      "text": "Officers privately questioned his ability to command, too."
    },
    "B010": {
      "source_dir": "/Users/diplomat/ytvideos/projects/borisenko/pilot_001/Source/Voice/regen_variants_v1",
      "text": "Was he held accountable?"
    },
    "B013": {
      "source_dir": "/Users/diplomat/ytvideos/projects/borisenko/pilot_001/Source/Voice/regen_variants_v1",
      "text": "How could he cross a river in the same spot"
    },
    "B014": {
      "source_dir": "/Users/diplomat/ytvideos/projects/borisenko/pilot_001/Source/Voice/regen_variants_v1",
      "text": "when the enemy had that spot zeroed in?"
    },
    "B016": {
      "source_dir": "/Users/diplomat/ytvideos/projects/borisenko/pilot_001/Source/Voice/regen_variants_v1",
      "text": "It was zeroed in, yet they crossed again."
    },
    "B018": {
      "source_dir": "/Users/diplomat/ytvideos/projects/borisenko/pilot_001/Source/Voice/regen_variants_v1",
      "text": "Did he answer for it? No."
    },
    "B021": {
      "source_dir": "/Users/diplomat/ytvideos/projects/borisenko/pilot_001/Source/Voice/regen_variants_v1",
      "text": "Look, respected—or not-so-respected—Mr. President,"
    }
  }
}
